<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Héritage de la vue res.config.settings -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.enswork</field>
            <field name="model">res.config.settings</field>
            <field name="priority">20</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app string="Enswork" name="enswork" web_icon="purchase,static/description/icon.png">
                        <!-- Rapports et Impressions -->
                        <block title="Rapports et Impressiopersonnalisésns">
                            <setting string="Rapports personnalisés"
                                     help="Active les rapports ">
                                <field name="module_custom_reports"/>
                            </setting>
                        </block>

                        <!-- Ventes -->
                        <block title="Ventes">
                            <setting string="Double approbation des commandes"
                                     help="Active le processus de double approbation pour les commandes de vente">
                                <field name="module_sales_order_double_approval"/>
                            </setting>
                            <setting string="Séquences des devis"
                                     help="Permet de gérer les séquences des devis de vente">
                                <field name="module_sales_quotations_sequences"/>
                            </setting>
                            <setting string="Objectifs de vente"
                                     help="Active la gestion des objectifs de vente">
                                <field name="module_sales_target"/>
                            </setting>
                        </block>

                        <!-- Facturation -->
                        <block title="Facturation">
                            <setting string="Facture de vente personnalisée"
                                     help="Active la personnalisation des factures de vente">
                                <field name="module_custom_sale_invoice"/>
                            </setting>
                            <setting string="Paiement anticipé dans les ventes"
                                     help="Permet la gestion des paiements anticipés dans les commandes de vente">
                                <field name="module_eg_advance_payment_in_sale"/>
                            </setting>
                        </block>

                        <!-- Logistique -->
                        <block title="Logistique">
                            <setting string="Livraison à partir de la commande"
                                     help="Active la création automatique des bons de livraison à partir des commandes de vente">
                                <field name="module_delivery_from_sale"/>
                            </setting>
                        </block>

                        <!-- Achats -->
                        <block title="Achats">
                            <setting string="Commande d'achat à partir de la vente"
                                     help="Permet de créer des commandes d'achat à partir des commandes de vente">
                                <field name="module_sale_to_purchase"/>
                            </setting>
                        </block>

                        <!-- Autres -->
                        <block title="Articles">
                            <setting string="Supprimer références internes"
                                     help="Permet de supprimer les références internes">
                                <field name="module_eg_remove_internal_reference"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
