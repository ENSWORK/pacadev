<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_custom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.custom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add print options tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Options d'impression">
                    <group>
                        <group string="Paramètres d'impression">
                            <field name="print_with_ref"/>
                            <field name="print_with_header"/>
                            <field name="print_with_line_number"/>
                            <field name="print_with_expected_date"/>
                            <field name="print_with_buyer"/>
                            <field name="print_with_payment_terms"/>
                            <field name="print_with_signature"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
