<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================== HEADER SECTION ==================== -->
    <template id="external_layout_header_sale_order_ens">
        <div class="header">
            <div class="row">
                <div class="col-3">
                    <t t-if="o.company_id.logo">
                        <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" t-attf-style="max-height: #{o.company_id.logo_height}px; max-width: #{o.company_id.logo_width}px;"/>
                    </t>
                </div>
            </div>
        </div>
    </template>

    <template id="external_layout_footer_sale_order_ens">
        <div class="footer">
            <div style="margin-bottom: 10px;">
                <span style="float: left; font-size: 14px;">Etabli par : <span t-esc="env.user.name"/></span>
                <span style="float: right; font-size: 14px;">Page N° <span class="page"/>/<span class="topage"/></span>
                <div style="clear: both;"></div>
            </div>
            <div class="text-center" style="border-top: 1px solid black;">
                <span t-field="o.company_id.name"/>
            </div>
        </div>
    </template>

    <template id="external_layout_sale_order_ens">
        <div class="article o_report_layout_standard">
            <!-- Header uniquement si print_with_header est activé -->
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_header_sale_order_ens"/>
            </t>
            <t t-raw="0"/>
            <!-- Footer uniquement si print_with_header est activé -->
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_footer_sale_order_ens"/>
            </t>
        </div>
    </template>

    <!-- ==================== DOCUMENT TEMPLATE ==================== -->
    <template id="report_sale_order_ens_document">
        <!-- Sale Order Header Information -->
        <table style="width:100%; border-collapse: separate; border-spacing: 0; border: 0;">
            <tr>
                <!-- Sale Order Details Column -->
                <td style="width:45%; border: 0;">
                    <table style="width:100%; border-collapse: separate;">
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <strong>Offre N°: </strong><span t-field="o.name"/>
                            </td>
                        </tr>
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <strong>Date: </strong><span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                            </td>
                        </tr>
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                            <t t-if="o.client_order_ref">
                                <strong>Votre Référence: </strong><span t-field="o.client_order_ref"/>
                            </t>
                            </td>
                        </tr>
                    </table>
                </td>

                <!-- Spacer Column -->
                <td style="width:5%;"></td>

                <!-- Customer Information Column -->
                <td style="width:50%;">
                    <div style="border: 1px solid black; padding:8px;">
                        <table style="width:100%; border-collapse: separate;">
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0; background-color: #f9f9f9;">
                                    <span t-field="o.partner_id.name" style="font-size: 18px; font-weight: bold;"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <t t-if="o.partner_id.street">
                                        <span t-field="o.partner_id.street"/>
                                        <t t-if="o.partner_id.street2 or o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.street2">
                                        <span t-field="o.partner_id.street2"/>
                                        <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <span t-field="o.partner_id.city"/>
                                        <t t-if="o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.state_id">
                                        <span t-field="o.partner_id.state_id.name"/>
                                        <t t-if="o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.zip">
                                        <span t-field="o.partner_id.zip"/>
                                        <t t-if="o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.country_id">
                                        <span t-field="o.partner_id.country_id.name"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                        <strong>Tél:</strong>
                                        <t t-if="o.partner_id.phone">
                                            <span t-field="o.partner_id.phone"/>
                                        </t>
                                        <t t-if="o.partner_id.mobile">
                                            <t t-if="o.partner_id.phone"> / </t>
                                            <span t-field="o.partner_id.mobile"/>
                                        </t>
                                    </t>
                                    <t t-if="o.partner_id.email">
                                        <t t-if="o.partner_id.phone and o.partner_id.mobile">
                                            <br/>
                                        </t>
                                        <strong>Email:</strong>
                                        <span t-field="o.partner_id.email"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <strong>ICE:</strong>
                                    <span t-field="o.partner_id.ice"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>

<!-- Information Table -->
        <table style="width:100%; border-collapse: collapse; margin-top: 10px; padding: 8px;">
            <tr>
                <!-- Première colonne -->
                <td style="width:50%; vertical-align: top; padding: 8px; border-right: 0;">
                    <strong>Représentant :</strong>
                    <span t-field="o.user_id.name"/><br/>
                    <strong>Téléphone :</strong>
                    <span t-field="o.user_id.phone"/><br/>
                    <strong>E-mail :</strong>
                    <span t-field="o.user_id.email"/><br/>
                </td>
                <!-- Deuxième colonne -->
                <td style="width:50%; vertical-align: top; padding: 8px; border-left: 0;">
                    <t t-if="o.incoterm">
                        <strong>Conditions de livraison :</strong>
                        <span t-field="o.incoterm"/><br/>
                    </t>
                    <t t-if="o.payment_term_id">
                        <strong>Conditions de paiement :</strong>
                        <span t-field="o.payment_term_id"/><br/>
                    </t>
                    <t t-if="o.validity_date">
                        <strong>Expiration :</strong>
                        <span t-field="o.validity_date" t-options='{"widget": "date", "format": "dd.MM.yyyy"}'/><br/>
                    </t>
                </td>
            </tr>
        </table>

        <!-- Check for discount and délai -->
        <t t-set="display_discount" t-value="any(l.discount for l in o.order_line)"/>

        <!-- Add CSS classes -->
        <style>
            .order-line-even {
                background-color: #ffffff;
            }
            .order-line-odd {
                background-color: #f9f9f9;
            }
            table.no-internal-borders,
            .no-internal-borders tr,
            .no-internal-borders td,
            .no-internal-borders th {
                border: none !important;
            }
        </style>

        <!-- Sale Order Line Items Table -->
<!-- Sale Order Line Items Table -->
        <table class="table table-sm no-internal-borders" style="width: 100%; margin-top: 20px; border-collapse: collapse; border: 1px solid #ABABAB;">
            <thead>
                <tr style="background-color: #f8f9fa;">
                    <th style="width: 10%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">N°</th>
                    <th style="width: 50%; padding: 8px; white-space: normal; word-wrap: break-word; background-color: #f8f9fa; border: none;">Référence / Description d'article</th>
                    <th style="width: 5%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">Qté</th>
<t t-if="any(line.ourdelai and line.ourdelai.strip() for line in o.order_line)">
    <th style="width: 10%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">Délai</th>
</t>
                    <th style="width: 10%; text-align: right; padding: 8px; background-color: #f8f9fa; border: none;">PU Net</th>
                    <th t-if="any(line.discount != 0 for line in o.order_line)"
                        style="width: 10%; text-align: center; background-color: #f8f9fa; border: none;">Remise</th>
                    <th style="width: 15%; text-align: right; padding: 8px; background-color: #f8f9fa; border: none;">Total HT</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o.order_line" t-as="line" t-att-class="line_index % 2 == 0 and 'order-line-even' or 'order-line-odd'" style="border: none;">
                    <td style="padding: 8px; text-align: center; border: none; vertical-align: middle; font-size: 13px;">
                        <span t-esc="line.sequence"/>
                    </td>
                    <td style="padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <t t-if="line.product_id.default_code">
                            <div style="font-size: 13px; font-weight: bold;"><span t-field="line.product_id.default_code"/></div>
                            <div t-if="line.name" style="font-size: 13px;"><span t-field="line.name" t-options="{'widget': 'text'}"/></div>
                        </t>
                        <t t-if="not line.product_id.default_code">
                            <span t-field="line.name" t-options="{'widget': 'text'}" style="font-size: 13px;"/>
                        </t>
                    </td>
                    <td style="text-align: center; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <t t-set="qty_str" t-value="'{:.2f}'.format(line.product_uom_qty)"/>
                        <span t-esc="qty_str.rstrip('0').rstrip('.') if qty_str.endswith('.00') else qty_str"/>
                        <span t-field="line.product_uom.name" style="font-size: smaller; color: #666666;"/>
                    </td>
<t t-if="any(line.ourdelai and line.ourdelai.strip() for line in o.order_line)">
    <td style="text-align: center; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
        <t t-if="line.ourdelai and line.ourdelai.strip()">
            <span t-field="line.ourdelai"/>
        </t>
    </td>
</t>
                    <td style="text-align: right; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                    <td t-if="any(line.discount for line in o.order_line)"
                        style="text-align: center; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <t t-if="line.discount">
                            <t t-set="discount_str" t-value="'{:.2f}'.format(line.discount)"/>
                            <span t-esc="discount_str.rstrip('0').rstrip('.') if discount_str.endswith('.00') else discount_str"/>%
                        </t>
                    </td>
                    <td style="text-align: right; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Montant en lettres et Totaux -->
        <table style="width: 100%; margin-top: 15px; margin-bottom: 15px; border-collapse: collapse; border: 1px solid black;">
            <tr>
                <!-- Section texte "Arrêtée la présente commande..." -->
                <td style="width: 70%; vertical-align: top; padding-right: 20px; border: none !important;">
                    <div style="padding: 10px; box-sizing: border-box;">
<span style="display: block; margin-bottom: 10px !important;">
    Signature
</span>
                    </div>
                </td>

                <!-- Section des totaux -->
                <td style="width: 30%; vertical-align: top; border: none !important;">
 <!-- Remplacez la section actuelle des totaux par celle-ci -->
<table style="width: 100%; border-collapse: collapse; border: none;">
    <!-- Total HT -->
    <tr style="font-weight: bold; background-color: #F5F5F5;">
        <td style="padding: 2px 8px; text-align: left; border: none;">Total HT</td>
        <td style="padding: 2px 8px; text-align: right; background-color: #F5F5F5; border: none;">
            <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
            <span t-field="o.currency_id.symbol"/>
        </td>
    </tr>

    <!-- TVA dynamique regroupée par taux -->
    <t t-set="tax_dict" t-value="{}" />
    <!-- Calcul des totaux par taux de TVA -->
    <t t-foreach="o.order_line" t-as="line">
        <t t-foreach="line.tax_id" t-as="tax">
            <t t-if="str(tax.amount) not in tax_dict">
                <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): 0})" />
            </t>
            <t t-set="current_tax" t-value="tax_dict[str(tax.amount)] + line.price_subtotal * (tax.amount / 100.0)" />
            <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): current_tax})" />
        </t>
    </t>

    <!-- Affichage des totaux de TVA -->
    <t t-foreach="tax_dict.items()" t-as="tax_item">
        <tr style="background-color: #FAFAFA;">
            <td style="padding: 2px 8px; text-align: left; border: none;">
                TVA <t t-esc="int(float(tax_item[0]))"/>%
            </td>
            <td style="padding: 2px 8px; text-align: right; background-color: #FAFAFA; border: none;">
                <span t-esc="tax_item[1]" t-options='{"widget": "float", "precision": 2}'/>
                <span t-field="o.currency_id.symbol"/>
            </td>
        </tr>
    </t>

    <!-- Total TTC -->
    <tr style="font-weight: bold; background-color: #EEEDED;">
        <td style="padding: 2px 8px; text-align: left; border: none;">Total TTC</td>
        <td style="padding: 2px 8px; text-align: right; background-color: #EEEDED; border: none;">
            <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
            <span t-field="o.currency_id.symbol"/>
        </td>
    </tr>
</table>
                </td>
            </tr>
        </table>

<!-- Signature/Tampon -->
<t t-if="o.print_with_signature">
    <div style="margin-top: 20px; padding-left: 10px;">
        <!-- Utiliser l'image du tampon de la société si définie, sinon la signature utilisateur -->
        <t t-if="o.company_id.stamp_image">
            <img t-att-src="image_data_uri(o.company_id.stamp_image)"
                 alt="Tampon"
                 style="max-width: 300px; max-height: 150px; display: block;"/>
        </t>
        <t t-elif="o.user_id.signature_image">
            <img t-att-src="image_data_uri(o.user_id.signature_image)"
                 alt="Signature"
                 style="max-width: 300px; max-height: 150px; display: block;"/>
        </t>
    </div>
</t>
    </template>

    <!-- ==================== MAIN REPORT TEMPLATE ==================== -->
    <template id="report_sale_order_ens">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_reports.external_layout_sale_order_ens">
                    <t t-call="custom_reports.report_sale_order_ens_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ==================== REPORT ACTION ==================== -->
    <record id="action_report_sale_order_ens" model="ir.actions.report">
        <field name="name">Offre ENS</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_reports.report_sale_order_ens</field>
        <field name="report_file">custom_reports.report_sale_order_ens</field>
        <field name="print_report_name">'Devis - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_standard"/>
    </record>
</odoo>
