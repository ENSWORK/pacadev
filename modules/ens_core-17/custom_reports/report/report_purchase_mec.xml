<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================== HEADER SECTION ==================== -->
    <template id="external_layout_header_purchase_order_mec">
        <div class="header">
            <div class="row">
                <div class="col-3">
                    <t t-if="o.company_id.logo">
                        <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" t-attf-style="max-height: #{o.company_id.logo_height}px; max-width: #{o.company_id.logo_width}px;"/>
                    </t>
                </div>
            </div>
        </div>
    </template>

    <template id="external_layout_footer_purchase_order_mec">
        <div class="footer">
            <div style="margin-bottom: 10px;">
                <span style="float: right; font-size: 13px;">Page N° <span class="page"/>/<span class="topage"/></span>
                <div style="clear: both;"></div>
            </div>
            <t t-if="o.company_id.footer_image_mec">
                <img t-att-src="image_data_uri(o.company_id.footer_image_mec)" alt="Footer" style="width: 100%; max-height: 120px;"/>
            </t>
        </div>
    </template>

    <template id="external_layout_purchase_order_mec">
        <div class="article o_report_layout_standard">
            <!-- Header uniquement si print_with_header est activé -->
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_header_purchase_order_mec"/>
            </t>
            <t t-raw="0"/>
            <!-- Footer uniquement si print_with_header est activé -->
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_footer_purchase_order_mec"/>
            </t>
        </div>
    </template>

    <!-- ==================== DOCUMENT TEMPLATE ==================== -->
    <template id="report_purchase_order_mec_document">
        <!-- Purchase Order Header Information -->
        <table style="width:100%; border-collapse: separate; border-spacing: 0; border: 0;">
            <tr>
                <!-- Purchase Order Details Column -->
                <td style="width:45%; border: 0;">
                    <table style="width:100%; border-collapse: separate;">
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <strong>Bon de Commande N°: </strong><span t-field="o.name"/>
                            </td>
                        </tr>
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <strong>Date: </strong><span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                            </td>
                        </tr>
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <t t-if="o.partner_ref">
                                    <strong>Référence Fournisseur: </strong><span t-field="o.partner_ref"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                </td>

                <!-- Spacer Column -->
                <td style="width:5%;"></td>

                <!-- Supplier Information Column -->
                <td style="width:50%;">
                    <div style="border: 1px solid black; padding:8px;">
                        <table style="width:100%; border-collapse: separate;">
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0; background-color: #f9f9f9;">
                                    <span t-field="o.partner_id.name" style="font-size: 18px; font-weight: bold;"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <t t-if="o.partner_id.street">
                                        <span t-field="o.partner_id.street"/>
                                        <t t-if="o.partner_id.street2 or o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.street2">
                                        <span t-field="o.partner_id.street2"/>
                                        <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <span t-field="o.partner_id.city"/>
                                        <t t-if="o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.state_id">
                                        <span t-field="o.partner_id.state_id.name"/>
                                        <t t-if="o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.zip">
                                        <span t-field="o.partner_id.zip"/>
                                        <t t-if="o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.country_id">
                                        <span t-field="o.partner_id.country_id.name"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <!-- Afficher Tél, Mobile et Email selon les conditions -->
                                    <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                        <strong>Tél:</strong>
                                        <t t-if="o.partner_id.phone">
                                            <span t-field="o.partner_id.phone"/>
                                        </t>
                                        <t t-if="o.partner_id.mobile">
                                            <t t-if="o.partner_id.phone"> / </t> <!-- Ajouter un séparateur seulement si phone existe -->
                                            <span t-field="o.partner_id.mobile"/>
                                        </t>
                                    </t>
                                    <t t-if="o.partner_id.email">
                                        <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                            <br/> <!-- Passer à la ligne si un numéro est défini -->
                                        </t>
                                        <strong>Email:</strong>
                                        <span t-field="o.partner_id.email"/>
                                    </t>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.vat">
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <strong>ICE:</strong>
                                    <span t-field="o.partner_id.vat"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>

        <!-- Information Table -->
        <t t-if="o.print_with_buyer or o.print_with_payment_terms">
            <table style="width:100%; border-collapse: collapse; margin-top: 10px; padding: 8px;">
                <tr>
                    <!-- Première colonne - Acheteur (avec option) -->
                    <td t-if="o.print_with_buyer" style="width:50%; vertical-align: top; padding: 8px; border-right: 0;">
                        <strong>Acheteur :</strong>
                        <span t-field="o.user_id.name"/><br/>
                        <t t-if="o.user_id.phone">
                            <strong>Téléphone :</strong>
                            <span t-field="o.user_id.phone"/><br/>
                        </t>
                        <t t-if="o.user_id.email">
                            <strong>E-mail :</strong>
                            <span t-field="o.user_id.email"/><br/>
                        </t>
                    </td>
                    <!-- Deuxième colonne - Conditions de paiement (avec option) -->
                    <td t-if="o.print_with_payment_terms" t-attf-style="width:{{o.print_with_buyer and '50%' or '100%'}}; vertical-align: top; padding: 8px; border-left: 0;">
                        <t t-if="o.incoterm_id">
                            <strong>Conditions de livraison :</strong>
                            <span t-field="o.incoterm_id.name"/><br/>
                        </t>
                        <t t-if="o.payment_term_id">
                            <strong>Conditions de paiement :</strong>
                            <span t-field="o.payment_term_id.name"/><br/>
                        </t>
                        <t t-if="o.date_planned">
                            <strong>Date de livraison prévue :</strong>
                            <span t-field="o.date_planned" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/><br/>
                        </t>
                    </td>
                </tr>
            </table>
        </t>

        <!-- Add CSS classes -->
        <style>
            .purchase-line-even {
                background-color: #ffffff;
            }
            .purchase-line-odd {
                background-color: #f9f9f9;
            }
            table.no-internal-borders,
            .no-internal-borders tr,
            .no-internal-borders td,
            .no-internal-borders th {
                border: none !important;
            }
        </style>

        <!-- Purchase Order Line Items Table -->
        <table class="table table-sm no-internal-borders" style="width: 100%; margin-top: 20px; border-collapse: collapse; border: 1px solid #ABABAB;">
            <thead>
                <tr style="background-color: #f8f9fa;">
                    <th style="width: 5%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">N°</th>
                    <th style="width: 10%; padding: 8px; background-color: #f8f9fa; border: none;">Référence</th>
                    <th style="width: 40%; padding: 8px; white-space: normal; word-wrap: break-word; background-color: #f8f9fa; border: none;">Description d'article</th>
                    <th style="width: 5%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">Qté</th>
                    <th style="width: 10%; text-align: right; padding: 8px; background-color: #f8f9fa; border: none;">PU Net</th>
                    <th style="width: 10%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">TVA</th>
                    <th style="width: 15%; text-align: right; padding: 8px; background-color: #f8f9fa; border: none;">Total HT</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o.order_line" t-as="line" t-att-class="line_index % 2 == 0 and 'purchase-line-even' or 'purchase-line-odd'" style="border: none;">
                    <td style="padding: 8px; text-align: center; border: none;">
                        <span t-esc="line_index + 1"/>
                    </td>
                    <td style="padding: 8px; border: none;">
                        <span t-field="line.product_id.default_code"/>
                    </td>
                    <td style="padding: 8px; border: none;">
                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                    </td>
                    <td style="text-align: center; padding: 8px; border: none;">
                        <t t-set="qty_str" t-value="'{:.2f}'.format(line.product_qty)"/>
                        <span t-esc="qty_str.rstrip('0').rstrip('.') if qty_str.endswith('.00') else qty_str"/>
                        <span t-field="line.product_uom.name" style="font-size: smaller; color: #666666;"/>
                    </td>
                    <td style="text-align: right; padding: 8px; border: none;">
                        <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                    <td style="text-align: center; padding: 8px; border: none;">
                        <t t-foreach="line.taxes_id" t-as="tax">
                            <span t-esc="tax.name"/>
                            <t t-if="tax_index &lt; len(line.taxes_id) - 1">, </t>
                        </t>
                    </td>
                    <td style="text-align: right; padding: 8px; border: none;">
                        <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Montant en lettres et Totaux - sans bordure -->
        <table style="width: 100%; margin-top: 15px; margin-bottom: 15px; border-collapse: collapse; border: none;">
            <tr>
                <!-- Section gauche vide -->
                <td style="width: 70%; vertical-align: top; padding-right: 20px; border: none !important;">
                </td>

                <!-- Section des totaux sans bordure -->
                <td style="width: 30%; vertical-align: top; border: none !important;">
                    <table style="width: 100%; border-collapse: collapse; border: none;">
                        <!-- Total HT -->
                        <tr style="font-weight: bold; background-color: #F5F5F5;">
                            <td style="padding: 5px 8px; text-align: left; border: none;">Total HT</td>
                            <td style="padding: 5px 8px; text-align: right; background-color: #F5F5F5; border: none;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                                <span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>

                        <!-- TVA dynamique regroupée par taux -->
                        <t t-set="tax_dict" t-value="{}" />
                        <!-- Premier, calculons les totaux par taux de TVA -->
                        <t t-foreach="o.order_line" t-as="line">
                            <t t-foreach="line.taxes_id" t-as="tax">
                                <t t-if="str(tax.amount) not in tax_dict">
                                    <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): 0})" />
                                </t>
                                <t t-set="current_tax" t-value="tax_dict[str(tax.amount)] + line.price_subtotal * (tax.amount / 100.0)" />
                                <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): current_tax})" />
                            </t>
                        </t>

                        <!-- Ensuite, affichons les totaux -->
                        <t t-foreach="tax_dict.items()" t-as="tax_item">
                            <tr style="background-color: #FAFAFA;">
                                <td style="padding: 5px 8px; text-align: left; border: none;">
                                    TVA <t t-esc="float(tax_item[0])"/>%
                                </td>
                                <td style="padding: 5px 8px; text-align: right; background-color: #FAFAFA; border: none;">
                                    <span t-esc="tax_item[1]" t-options='{"widget": "float", "precision": 2}'/>
                                    <span t-field="o.currency_id.symbol"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Total TTC -->
                        <tr style="font-weight: bold; background-color: #EEEDED;">
                            <td style="padding: 5px 8px; text-align: left; border: none;">Total TTC</td>
                            <td style="padding: 5px 8px; text-align: right; background-color: #EEEDED; border: none;">
                                <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                                <span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- Signature utilisateur uniquement -->
        <t t-if="o.print_with_signature and o.user_id.signature_image">
            <div style="margin-top: 20px; padding-left: 10px;">
                <img t-att-src="image_data_uri(o.user_id.signature_image)"
                     alt="Signature"
                     style="max-width: 300px; max-height: 150px; display: block;"/>
            </div>
        </t>

        <!-- Notes section if present -->
        <t t-if="o.notes">
            <div style="margin-top: 20px; border: 1px solid #ddd; padding: 10px;">
                <strong>Notes:</strong>
                <span t-field="o.notes"/>
            </div>
        </t>
    </template>

    <!-- ==================== MAIN REPORT TEMPLATE ==================== -->
    <template id="report_purchase_order_mec">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_reports.external_layout_purchase_order_mec">
                    <t t-call="custom_reports.report_purchase_order_mec_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ==================== REPORT ACTION ==================== -->
    <record id="action_report_purchase_order_mec" model="ir.actions.report">
        <field name="name">Bon de commande MEC</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_reports.report_purchase_order_mec</field>
        <field name="report_file">custom_reports.report_purchase_order_mec</field>
        <field name="print_report_name">'BC_%s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_standard"/>
    </record>

    <!-- ==================== ENGLISH VERSION ==================== -->
    <!-- ==================== DOCUMENT TEMPLATE (ENGLISH) ==================== -->
    <template id="report_purchase_order_mec_en_document">
        <!-- Purchase Order Header Information -->
        <table style="width:100%; border-collapse: separate; border-spacing: 0; border: 0;">
            <tr>
                <!-- Purchase Order Details Column -->
                <td style="width:45%; border: 0;">
                    <table style="width:100%; border-collapse: separate;">
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <strong>Purchase Order N°: </strong><span t-field="o.name"/>
                            </td>
                        </tr>
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <strong>Date: </strong><span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                            </td>
                        </tr>
                        <tr style="border: 0;">
                            <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <t t-if="o.partner_ref">
                                    <strong>Supplier Reference: </strong><span t-field="o.partner_ref"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                </td>

                <!-- Spacer Column -->
                <td style="width:5%;"></td>

                <!-- Supplier Information Column -->
                <td style="width:50%;">
                    <div style="border: 1px solid black; padding:8px;">
                        <table style="width:100%; border-collapse: separate;">
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0; background-color: #f9f9f9;">
                                    <span t-field="o.partner_id.name" style="font-size: 18px; font-weight: bold;"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <t t-if="o.partner_id.street">
                                        <span t-field="o.partner_id.street"/>
                                        <t t-if="o.partner_id.street2 or o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.street2">
                                        <span t-field="o.partner_id.street2"/>
                                        <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <span t-field="o.partner_id.city"/>
                                        <t t-if="o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.state_id">
                                        <span t-field="o.partner_id.state_id.name"/>
                                        <t t-if="o.partner_id.zip or o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.zip">
                                        <span t-field="o.partner_id.zip"/>
                                        <t t-if="o.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="o.partner_id.country_id">
                                        <span t-field="o.partner_id.country_id.name"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                        <strong>Tel:</strong>
                                        <t t-if="o.partner_id.phone">
                                            <span t-field="o.partner_id.phone"/>
                                        </t>
                                        <t t-if="o.partner_id.mobile">
                                            <t t-if="o.partner_id.phone"> / </t>
                                            <span t-field="o.partner_id.mobile"/>
                                        </t>
                                    </t>
                                    <t t-if="o.partner_id.email">
                                        <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                            <br/>
                                        </t>
                                        <strong>Email:</strong>
                                        <span t-field="o.partner_id.email"/>
                                    </t>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.vat">
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <strong>Tax ID:</strong>
                                    <span t-field="o.partner_id.vat"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>

        <!-- Information Table -->
        <t t-if="o.print_with_buyer or o.print_with_payment_terms">
            <table style="width:100%; border-collapse: collapse; margin-top: 10px; padding: 8px;">
                <tr>
                    <!-- Première colonne - Buyer (with option) -->
                    <td t-if="o.print_with_buyer" style="width:50%; vertical-align: top; padding: 8px; border-right: 0;">
                        <strong>Buyer:</strong>
                        <span t-field="o.user_id.name"/><br/>
                        <t t-if="o.user_id.phone">
                            <strong>Phone:</strong>
                            <span t-field="o.user_id.phone"/><br/>
                        </t>
                        <t t-if="o.user_id.email">
                            <strong>E-mail:</strong>
                            <span t-field="o.user_id.email"/><br/>
                        </t>
                    </td>
                    <!-- Deuxième colonne - Payment Terms (with option) -->
                    <td t-if="o.print_with_payment_terms" t-attf-style="width:{{o.print_with_buyer and '50%' or '100%'}}; vertical-align: top; padding: 8px; border-left: 0;">
                        <t t-if="o.incoterm_id">
                            <strong>Delivery Terms:</strong>
                            <span t-field="o.incoterm_id.name"/><br/>
                        </t>
                        <t t-if="o.payment_term_id">
                            <strong>Payment Terms:</strong>
                            <span t-field="o.payment_term_id.name"/><br/>
                        </t>
                        <t t-if="o.date_planned">
                            <strong>Expected Delivery Date:</strong>
                            <span t-field="o.date_planned" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/><br/>
                        </t>
                    </td>
                </tr>
            </table>
        </t>

        <!-- Add CSS classes -->
        <style>
            .purchase-line-even {
                background-color: #ffffff;
            }
            .purchase-line-odd {
                background-color: #f9f9f9;
            }
            table.no-internal-borders,
            .no-internal-borders tr,
            .no-internal-borders td,
            .no-internal-borders th {
                border: none !important;
            }
        </style>

        <!-- Purchase Order Line Items Table -->
        <table class="table table-sm no-internal-borders" style="width: 100%; margin-top: 20px; border-collapse: collapse; border: 1px solid #ABABAB;">
            <thead>
                <tr style="background-color: #f8f9fa;">
                    <th style="width: 5%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">N°</th>
                    <th style="width: 10%; padding: 8px; background-color: #f8f9fa; border: none;">Reference</th>
                    <th style="width: 40%; padding: 8px; white-space: normal; word-wrap: break-word; background-color: #f8f9fa; border: none;">Item Description</th>
                    <th style="width: 5%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">Qty</th>
                    <th style="width: 10%; text-align: right; padding: 8px; background-color: #f8f9fa; border: none;">Unit Price</th>
                    <th style="width: 10%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">VAT</th>
                    <th style="width: 15%; text-align: right; padding: 8px; background-color: #f8f9fa; border: none;">Total Excl.</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o.order_line" t-as="line" t-att-class="line_index % 2 == 0 and 'purchase-line-even' or 'purchase-line-odd'" style="border: none;">
                    <td style="padding: 8px; text-align: center; border: none;">
                        <span t-esc="line_index + 1"/>
                    </td>
                    <td style="padding: 8px; border: none;">
                        <span t-field="line.product_id.default_code"/>
                    </td>
                    <td style="padding: 8px; border: none;">
                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                    </td>
                    <td style="text-align: center; padding: 8px; border: none;">
                        <t t-set="qty_str" t-value="'{:.2f}'.format(line.product_qty)"/>
                        <span t-esc="qty_str.rstrip('0').rstrip('.') if qty_str.endswith('.00') else qty_str"/>
                        <span t-field="line.product_uom.name" style="font-size: smaller; color: #666666;"/>
                    </td>
                    <td style="text-align: right; padding: 8px; border: none;">
                        <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                    <td style="text-align: center; padding: 8px; border: none;">
                        <t t-foreach="line.taxes_id" t-as="tax">
                            <span t-esc="tax.name"/>
                            <t t-if="tax_index &lt; len(line.taxes_id) - 1">, </t>
                        </t>
                    </td>
                    <td style="text-align: right; padding: 8px; border: none;">
                        <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Montant en lettres et Totaux - sans bordure -->
        <table style="width: 100%; margin-top: 15px; margin-bottom: 15px; border-collapse: collapse; border: none;">
            <tr>
                <!-- Section gauche vide -->
                <td style="width: 70%; vertical-align: top; padding-right: 20px; border: none !important;">
                </td>

                <!-- Section des totaux sans bordure -->
                <td style="width: 30%; vertical-align: top; border: none !important;">
                    <table style="width: 100%; border-collapse: collapse; border: none;">
                        <!-- Total HT -->
                        <tr style="font-weight: bold; background-color: #F5F5F5;">
                            <td style="padding: 5px 8px; text-align: left; border: none;">Total Excl.</td>
                            <td style="padding: 5px 8px; text-align: right; background-color: #F5F5F5; border: none;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                                <span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>

                        <!-- TVA dynamique regroupée par taux -->
                        <t t-set="tax_dict" t-value="{}" />
                        <t t-foreach="o.order_line" t-as="line">
                            <t t-foreach="line.taxes_id" t-as="tax">
                                <t t-if="str(tax.amount) not in tax_dict">
                                    <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): 0})" />
                                </t>
                                <t t-set="current_tax" t-value="tax_dict[str(tax.amount)] + line.price_subtotal * (tax.amount / 100.0)" />
                                <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): current_tax})" />
                            </t>
                        </t>

                        <t t-foreach="tax_dict.items()" t-as="tax_item">
                            <tr style="background-color: #FAFAFA;">
                                <td style="padding: 5px 8px; text-align: left; border: none;">
                                    VAT <t t-esc="float(tax_item[0])"/>%
                                </td>
                                <td style="padding: 5px 8px; text-align: right; background-color: #FAFAFA; border: none;">
                                    <span t-esc="tax_item[1]" t-options='{"widget": "float", "precision": 2}'/>
                                    <span t-field="o.currency_id.symbol"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Total TTC -->
                        <tr style="font-weight: bold; background-color: #EEEDED;">
                            <td style="padding: 5px 8px; text-align: left; border: none;">Total Incl.</td>
                            <td style="padding: 5px 8px; text-align: right; background-color: #EEEDED; border: none;">
                                <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                                <span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- Signature utilisateur uniquement -->
        <t t-if="o.print_with_signature and o.user_id.signature_image">
            <div style="margin-top: 20px; padding-left: 10px;">
                <img t-att-src="image_data_uri(o.user_id.signature_image)"
                     alt="Signature"
                     style="max-width: 300px; max-height: 150px; display: block;"/>
            </div>
        </t>

        <!-- Notes section if present -->
        <t t-if="o.notes">
            <div style="margin-top: 20px; border: 1px solid #ddd; padding: 10px;">
                <strong>Notes:</strong>
                <span t-field="o.notes"/>
            </div>
        </t>
    </template>

    <!-- ==================== MAIN REPORT TEMPLATE (ENGLISH) ==================== -->
    <template id="report_purchase_order_mec_en">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_reports.external_layout_purchase_order_mec">
                    <t t-call="custom_reports.report_purchase_order_mec_en_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ==================== REPORT ACTION (ENGLISH) ==================== -->
    <record id="action_report_purchase_order_mec_en" model="ir.actions.report">
        <field name="name">Purchase Order MEC (English)</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_reports.report_purchase_order_mec_en</field>
        <field name="report_file">custom_reports.report_purchase_order_mec_en</field>
        <field name="print_report_name">'PO_%s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_standard"/>
    </record>
</odoo>
