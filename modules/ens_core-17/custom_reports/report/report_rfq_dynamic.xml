<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_rfq_dynamic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Sélection du layout en fonction des options (template de la société, options du document) -->
                <t t-if="o.company_id.print_template == 'odoo'">
                    <!-- Utiliser le template natif d'Odoo -->
                    <t t-call="web.external_layout">
                        <t t-call="purchase.report_purchasequotation_document"/>
                    </t>
                </t>
                <t t-elif="o.print_with_header">
                    <t t-if="o.company_id.print_template == 'ens'">
                        <t t-call="custom_reports.external_layout_rfq_ens">
                            <t t-call="custom_reports.report_rfq_ens_document"/>
                        </t>
                    </t>
                    <t t-elif="o.company_id.print_template == 'mec'">
                        <t t-call="custom_reports.external_layout_rfq_mec">
                            <t t-call="custom_reports.report_rfq_mec_document"/>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-call="custom_reports.external_layout_rfq">
                            <t t-call="custom_reports.report_rfq_db_document"/>
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <!-- Version sans en-tête -->
                    <div class="article">
                        <t t-if="o.company_id.print_template == 'ens'">
                            <t t-call="custom_reports.report_rfq_ens_document"/>
                        </t>
                        <t t-elif="o.company_id.print_template == 'mec'">
                            <t t-call="custom_reports.report_rfq_mec_document"/>
                        </t>
                        <t t-else="">
                            <t t-call="custom_reports.report_rfq_db_document"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

<record id="action_report_rfq_dynamic" model="ir.actions.report">
    <field name="name">Print Demande de prix</field>
    <field name="model">purchase.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">custom_reports.report_rfq_dynamic</field>
    <field name="report_file">custom_reports.report_rfq_dynamic</field>
    <field name="print_report_name">'Demande de prix - %s' % (object.name)</field>
    <field name="binding_model_id" ref="purchase.model_purchase_order"/>
    <field name="binding_type">report</field>
</record>

<!-- Désactiver les rapports individuels - ils sont appelés par le rapport dynamique -->
<record id="action_report_rfq_ens" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_rfq_mec" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_rfq_db" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>

</odoo>
