<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Header Template -->
   <template id="external_layout_header_purchase">
       <div class="row" style="margin-bottom: 0;">
           <!-- Logo column - only show if print_with_header is True -->
           <t t-if="o.print_with_header">
               <div class="col-3">
                   <t t-if="o.company_id.logo">
                       <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" t-attf-style="max-height: #{o.company_id.logo_height}px; max-width: #{o.company_id.logo_width}px;"/>
                   </t>
               </div>
           </t>
          <!-- Purchase order info - always shown -->
          <div t-attf-class="col-#{12 if not o.print_with_header else 9} text-end">
            <div style="font-family: Arial, sans-serif; line-height: 1.1;">
                <strong t-attf-style="font-size: 18px; color: #{o.company_id.primary_color}">BON DE COMMANDE - </strong>
                <strong style="font-size: 18px;" t-field="o.name" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                <div style="font-size: 14px">
                    <strong t-attf-style="color: #{o.company_id.primary_color}">Date : </strong>
                    <span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}' t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                    <strong t-attf-style="color: #{o.company_id.primary_color}">Code fournisseur : </strong>
                    <span t-field="o.partner_id.ref" t-attf-style="color: #{o.company_id.primary_color}"/>
                </div>
            </div>
        </div>
       </div>
   </template>

   <!-- Footer Template -->
   <template id="external_layout_footer_purchase">
        <!-- Footer type: Image -->
        <t t-if="o.company_id.footer_db_type == 'image' and o.company_id.footer_image_db">
            <img t-att-src="image_data_uri(o.company_id.footer_image_db)"
                 alt="Footer DB"
                 style="width: 100%; max-width: 100%; display: block;"/>
        </t>

        <!-- Footer type: Text (default or custom) -->
        <t t-elif="o.company_id.footer_db_type == 'text'">
            <div class="text-center" style="font-size: 13px; border-top: 1px solid #ABABAB; padding-top: 4px; line-height: 1.1;">
                <!-- Custom text if provided -->
                <t t-if="o.company_id.footer_text_db">
                    <div t-field="o.company_id.footer_text_db"/>
                </t>
                <!-- Default fiscal information if no custom text -->
                <t t-else="">
                    <div class="row mt-2">
                        <div class="col-12 text-center" style="font-size: 12px;">
                            <t t-if="o.company_id.name">
                                <span t-field="o.company_id.name"/> SARL AU - Capital de <span t-field="o.company_id.capital"/> MAD
                            </t>
                            <div style="margin-top:1px;">
                                <span t-field="o.company_id.street"/>, <span t-field="o.company_id.city"/>, <span t-field="o.company_id.country_id.name"/>
                            </div>
                            <div style="margin-top:1px;">
                                R.C.: <span t-field="o.company_id.company_registry"/> - Patente: <span t-field="o.company_id.tp"/>
                                - I.F.: <span t-field="o.company_id.vat"/> - C.N.S.S.: <span t-field="o.company_id.cnss"/> - I.C.E.: <span t-field="o.company_id.ice"/>
                            </div>
                            <div style="margin-top:1px;">
                                Email: <span t-field="o.company_id.email"/> - Site web: <span t-field="o.company_id.website"/>
                            </div>
                        </div>
                    </div>
                </t>
                <div t-if="report_type == 'pdf'" style="text-align: right; margin-top: 1px; font-size: 11px;">
                    Page <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </t>

        <!-- Footer type: None - no footer displayed -->
   </template>

   <!-- Layout Template -->
   <template id="external_layout_purchase">
       <div t-attf-class="header" style="border-bottom: 0px solid black;">
           <t t-call="custom_reports.external_layout_header_purchase"/>
       </div>

       <div class="article o_report_layout_standard">
           <t t-raw="0"/>
       </div>

       <!-- Footer uniquement si print_with_header est activé -->
       <t t-if="o.print_with_header">
           <div t-attf-class="footer">
               <t t-call="custom_reports.external_layout_footer_purchase"/>
           </div>
       </t>
   </template>

   <!-- Document Template -->
   <template id="report_purchase_db_document">
       <!-- Section émetteur/destinataire -->
       <div class="mt-4">
           <table class="mb-4" style="width:100%;border-collapse: separate; border-spacing: 0;">
               <tr>
                   <td style="width:45%;border:none;padding-bottom:5px;">
                   </td>
                   <td style="width:5%;border:none;padding-bottom:5px;">&#160;</td>
                   <td style="width:50%;border:none;padding-bottom:5px;">
                   </td>
               </tr>
               <tr>
                   <td style="width:45%;background-color:#EEEDED;padding:10px;">
                       <div style="line-height: 1.5;">
                           <strong t-field="o.company_id.name" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                           <t t-if="o.company_id.street">
                               <span t-field="o.company_id.street" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                           </t>
                           <t t-if="o.company_id.street2">
                               <span t-field="o.company_id.street2" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                           </t>
                           <span t-field="o.company_id.city" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                           <div class="mt-2">
                               <t t-if="o.company_id.phone">
                                   <strong t-attf-style="color: #{o.company_id.primary_color}">Tél.: </strong>
                                   <span t-field="o.company_id.phone" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                               </t>
                               <t t-if="o.company_id.email">
                                   <strong t-attf-style="color: #{o.company_id.primary_color}">Email: </strong>
                                   <span t-field="o.company_id.email" t-attf-style="color: #{o.company_id.primary_color}"/>
                               </t>
                           </div>
                       </div>
                   </td>
                   <td style="width:5%;border:0px;"> </td>
                   <td style="width:50%;border:1px solid #ABABAB;padding:15px;">
                       <div style="line-height: 1.5;">
                           <strong t-field="o.partner_id"/><br/>
                           <t t-if="o.partner_id.street">
                               <span t-field="o.partner_id.street"/><br/>
                           </t>
                           <t t-if="o.partner_id.street2">
                               <span t-field="o.partner_id.street2"/><br/>
                           </t>
                           <t t-if="o.partner_id.city">
                               <span t-field="o.partner_id.city"/>
                           </t>
                       </div>
                   </td>
               </tr>
           </table>

           <!-- Main Table -->
           <table class="table table-sm" style="margin-top:5px;border:1px solid #ABABAB; font-size: 13px;">
               <thead>
                   <tr>
                       <th t-if="o.print_with_ref" style="width:10%;padding:8px;border:1px solid #ABABAB;">Référence</th>
                       <th style="width:45%;padding:8px;border:1px solid #ABABAB;">Désignation</th>
                       <th style="width:10%;text-align:center;border:1px solid #ABABAB;">TVA</th>
                       <th style="width:15%;text-align:right;border:1px solid #ABABAB;">P.U. HT</th>
                       <th style="width:10%;text-align:center;border:1px solid #ABABAB;">Qté</th>
                       <th style="width:15%;text-align:right;border:1px solid #ABABAB;">Total HT</th>
                   </tr>
               </thead>
               <tbody>
                   <t t-set="current_subtotal" t-value="0"/>
                   <t t-foreach="o.order_line" t-as="line">
                       <tr style="height:30px;">
                           <td t-if="o.print_with_ref" style="padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                               <span t-if="line.product_id.default_code" t-field="line.product_id.default_code"/>
                           </td>
                           <td style="padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                               <span t-field="line.name"/>
                           </td>
                           <td style="text-align:center;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                               <span t-esc="'%.0f' % line.taxes_id.amount"/>%
                           </td>
                           <td style="text-align:right;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                               <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                           </td>
                           <td style="text-align:center;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                               <span t-field="line.product_qty"/>
                           </td>
                           <td style="text-align:right;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                               <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                           </td>
                       </tr>
                   </t>
                   <!-- Lignes vides -->
                   <t t-set="empty_lines" t-value="max(10 - len(o.order_line), 0)"/>
                   <t t-foreach="range(empty_lines)" t-as="i">
                       <tr style="height:25px; border: none;">
                           <td t-if="o.print_with_ref" style="border: none; border-right:1px solid #ABABAB;">
                               <div style="height:100%;">&amp;nbsp;</div>
                           </td>
                           <td style="border: none; border-right:1px solid #ABABAB;">
                               <div style="height:100%;">&amp;nbsp;</div>
                           </td>
                           <td style="border: none; border-right:1px solid #ABABAB;">
                               <div style="height:100%;">&amp;nbsp;</div>
                           </td>
                           <td style="border: none; border-right:1px solid #ABABAB;">
                               <div style="height:100%;">&amp;nbsp;</div>
                           </td>
                           <td style="border: none; border-right:1px solid #ABABAB;">
                               <div style="height:100%;">&amp;nbsp;</div>
                           </td>
                           <td style="border: none; border-right:1px solid #ABABAB;">
                               <div style="height:100%;">&amp;nbsp;</div>
                           </td>
                       </tr>
                   </t>
               </tbody>
           </table>

           <!-- Conditions and Totals -->
           <div class="row" style="margin-top:10px;">
               <t t-if="o.payment_term_id">
                <div class="col-7">
                    <div style="margin-bottom:5px;">
                        <strong>Conditions de règlement: </strong>
                        <span t-field="o.payment_term_id"/>
                    </div>
                </div>
            </t>
               <div class="col-5">
                   <table class="table table-sm" style="margin-bottom:0;width:100%;">
                       <tr>
                           <td style="padding:2px;border:none;">Total HT</td>
                           <td style="padding:2px;border:none;text-align:right;background-color:#F5F5F5;min-width:120px;">
                               <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                               <span t-field="o.currency_id.symbol"/>
                           </td>
                       </tr>
                       <tr>
                           <td style="padding:2px;border:none;">Total TVA 20%</td>
                           <td style="padding:2px;border:none;text-align:right;background-color:#F5F5F5;min-width:120px;">
                               <span t-field="o.amount_tax" t-options='{"widget": "float", "precision": 2}'/>
                               <span t-field="o.currency_id.symbol"/>
                           </td>
                       </tr>
                       <tr>
                           <td style="padding:2px;border:none;">Total TTC</td>
                           <td style="padding:2px;border:none;text-align:right;background-color:#EEEDED;min-width:120px;">
                               <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                               <span t-field="o.currency_id.symbol"/>
                           </td>
                       </tr>
                   </table>
               </div>
           </div>
       </div>
   </template>

   <!-- Main Template -->
   <template id="report_purchase_db">
       <t t-call="web.html_container">
           <t t-foreach="docs" t-as="o">
               <t t-call="custom_reports.external_layout_purchase">
                   <div class="page">
                       <t t-call="custom_reports.report_purchase_db_document"/>
                   </div>
               </t>
           </t>
       </t>
   </template>

   <!-- Report Action -->
   <record id="action_report_purchase_db" model="ir.actions.report">
       <field name="name">Bon de commande DB</field>
       <field name="model">purchase.order</field>
       <field name="report_type">qweb-pdf</field>
       <field name="report_name">custom_reports.report_purchase_db</field>
       <field name="report_file">custom_reports.report_purchase_db</field>
       <field name="print_report_name">'BC_%s' % object.name</field>
       <field name="binding_model_id" ref="purchase.model_purchase_order"/>
       <field name="binding_type">report</field>
       <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_standard"/>
   </record>

</odoo>
