<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Injection CSS dans header/footer du layout striped pour ce rapport uniquement -->
    <template id="partner_statement_striped_patch" inherit_id="web.external_layout_striped">
        <!-- Masquer la company_address via t-att-style conditionnel -->
        <xpath expr="//div[hasclass('company_address')]" position="attributes">
            <attribute name="t-att-style">"display:none;" if psr_hide_company_name else None</attribute>
        </xpath>
        <!-- Supprimer les interlignes dans le footer en injectant un style avant la liste -->
        <xpath expr="//ul[hasclass('list-inline')]" position="before">
            <t t-if="psr_hide_company_name">
                <style>.list-inline{margin-bottom:0!important;}.list-inline div,.list-inline p{margin:0!important;padding:0!important;line-height:1.3!important;}</style>
            </t>
        </xpath>
    </template>

    <!-- Document template - called once per partner -->
    <template id="customer_statement_document">
        <t t-call="web.external_layout">
            <t t-set="company" t-value="env.company"/>
            <t t-set="o" t-value="partner['partner_record']"/>
            <t t-set="psr_hide_company_name" t-value="True"/>
            <t t-set="address">
                <address>
                    <span t-field="o.name"/><br/>
                    <span t-field="o.street"/><br/>
                    <span t-if="o.street2"><span t-field="o.street2"/><br/></span>
                    <span t-field="o.zip"/> <span t-field="o.city"/><br/>
                    <span t-field="o.state_id"/><br/>
                    <span t-field="o.country_id"/>
                    <t t-if="o.ice"><br/><strong>I.C.E. : </strong><span t-esc="o.ice"/></t>
                </address>
            </t>
            <div class="page">
                <div id="oe_structure" class="oe_structure"/>
                <div class="row mt16 mb16" style="align-items:center;">
                    <div class="col-6">
                        <h2 style="margin:0;">
                            <t t-if="statement_type == 'activity'">Relevé d'activité</t>
                            <t t-elif="statement_type == 'detailed_activity'">Relevé d'activité détaillé</t>
                            <t t-elif="statement_type == 'all_invoices'">Toutes les factures</t>
                            <t t-else="">Relevé d'échéances</t>
                        </h2>
                    </div>
                    <div class="col-6" style="text-align:right;">
                        <strong>Du : </strong><span t-esc="start_date or as_of_date"/>
                        &#160;&#160;
                        <strong>Au : </strong><span t-esc="end_date or as_of_date"/>
                    </div>
                </div>

                <!-- Activity -->
                <t t-if="statement_type == 'activity'">
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:16px;">
                        <colgroup>
                            <col style="width:12%;"/>
                            <col style="width:12%;"/>
                            <col style="width:32%;"/>
                            <col style="width:14%;"/>
                            <col style="width:14%;"/>
                            <col style="width:16%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;">Date</th>
                                <th style="text-align:center;">Échéance</th>
                                <th style="text-align:center;">Référence</th>
                                <th style="text-align:right;">Montant</th>
                                <th style="text-align:right;">Montant réglé</th>
                                <th style="text-align:right;">Solde</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="5" style="text-align:right;">Solde d'ouverture</td>
                                <td style="text-align:right;"><span t-esc="partner['opening_balance']"/> <span t-esc="currency"/></td>
                            </tr>
                            <t t-foreach="partner['lines']" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><span t-esc="line['date']"/></td>
                                    <td style="text-align:center;"><span t-esc="line.get('due_date') or ''"/></td>
                                    <td style="text-align:center;"><span t-esc="line['reference']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['original_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['applied_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['balance']"/></td>
                                </tr>
                                <t t-foreach="line['sub_lines']" t-as="sub">
                                    <tr style="color:#555;font-size:0.92em;font-style:italic;">
                                        <td style="text-align:center;padding-left:20px;"><span t-esc="sub['date']"/></td>
                                        <td/>
                                        <td style="text-align:center;padding-left:20px;"><span t-esc="sub['reference']"/></td>
                                        <td/>
                                        <td style="text-align:right;"><span t-esc="sub['applied_amount']"/></td>
                                        <td/>
                                    </tr>
                                </t>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="5" style="text-align:right;">Solde de clôture</td>
                                <td style="text-align:right;"><span t-esc="partner['closing_balance']"/> <span t-esc="currency"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-set="buckets" t-value="partner.get('aging_buckets')"/>
                    <t t-if="buckets and buckets.get('_has_balance')">
                        <h5 style="margin-top:24px;">Analyse des échéances</h5>
                        <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                            <colgroup>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:16%;"/>
                            </colgroup>
                            <thead style="background-color:#f5f5f5;">
                                <tr>
                                    <th style="text-align:center;">Courant</th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">1 mois</t><t t-else="">1 - 30 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">2 mois</t><t t-else="">31 - 60 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">3 mois</t><t t-else="">61 - 90 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">4 mois</t><t t-else="">91 - 120 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">Plus ancien</t><t t-else="">121 jours +</t></th>
                                    <th style="text-align:center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align:right;"><span t-esc="buckets.get('current', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_1_30', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_30_60', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_60_90', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_90_120', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_over_120', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><strong><span t-esc="buckets.get('total', '0.00')"/> <span t-esc="currency"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>

                <!-- Relevé d'activité détaillé -->
                <t t-if="statement_type == 'detailed_activity'">
                    <h5 style="margin-top:16px;">Solde antérieur</h5>
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                        <colgroup>
                            <col style="width:12%;"/><col style="width:12%;"/><col style="width:30%;"/>
                            <col style="width:15%;"/><col style="width:15%;"/><col style="width:16%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;">Date</th>
                                <th style="text-align:center;">Échéance</th>
                                <th style="text-align:center;">Référence</th>
                                <th style="text-align:right;">Montant initial</th>
                                <th style="text-align:right;">Montant ouvert</th>
                                <th style="text-align:right;">Solde</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['prior_lines']" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><span t-esc="line['date']"/></td>
                                    <td style="text-align:center;"><span t-esc="line.get('due_date') or ''"/></td>
                                    <td style="text-align:center;"><span t-esc="line['reference']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['original_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['open_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['balance']"/></td>
                                </tr>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="5" style="text-align:right;">Total solde antérieur</td>
                                <td style="text-align:right;"><span t-esc="partner['prior_balance']"/> <span t-esc="currency"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 style="margin-top:16px;">Activité</h5>
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                        <colgroup>
                            <col style="width:12%;"/><col style="width:12%;"/><col style="width:30%;"/>
                            <col style="width:15%;"/><col style="width:15%;"/><col style="width:16%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;">Date</th>
                                <th style="text-align:center;">Échéance</th>
                                <th style="text-align:center;">Référence</th>
                                <th style="text-align:right;">Montant</th>
                                <th style="text-align:right;">Montant réglé</th>
                                <th style="text-align:right;">Solde</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['lines']" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><span t-esc="line['date']"/></td>
                                    <td style="text-align:center;"><span t-esc="line.get('due_date') or ''"/></td>
                                    <td style="text-align:center;"><span t-esc="line['reference']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['original_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['applied_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['balance']"/></td>
                                </tr>
                                <t t-foreach="line['sub_lines']" t-as="sub">
                                    <tr style="color:#555;font-size:0.92em;font-style:italic;">
                                        <td style="text-align:center;padding-left:20px;"><span t-esc="sub['date']"/></td>
                                        <td/>
                                        <td style="text-align:center;padding-left:20px;"><span t-esc="sub['reference']"/></td>
                                        <td/>
                                        <td style="text-align:right;"><span t-esc="sub['applied_amount']"/></td>
                                        <td/>
                                    </tr>
                                </t>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="5" style="text-align:right;">Solde de clôture</td>
                                <td style="text-align:right;"><span t-esc="partner['closing_balance']"/> <span t-esc="currency"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 style="margin-top:16px;">Solde final</h5>
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                        <colgroup>
                            <col style="width:12%;"/><col style="width:12%;"/><col style="width:30%;"/>
                            <col style="width:15%;"/><col style="width:15%;"/><col style="width:16%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;">Date</th>
                                <th style="text-align:center;">Échéance</th>
                                <th style="text-align:center;">Référence</th>
                                <th style="text-align:right;">Montant initial</th>
                                <th style="text-align:right;">Montant ouvert</th>
                                <th style="text-align:right;">Solde</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['ending_lines']" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><span t-esc="line['date']"/></td>
                                    <td style="text-align:center;"><span t-esc="line.get('due_date') or ''"/></td>
                                    <td style="text-align:center;"><span t-esc="line['reference']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['original_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['open_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['balance']"/></td>
                                </tr>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="5" style="text-align:right;">Total solde final</td>
                                <td style="text-align:right;"><span t-esc="partner['ending_balance']"/> <span t-esc="currency"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <t t-set="buckets" t-value="partner.get('aging_buckets')"/>
                    <t t-if="buckets and buckets.get('_has_balance')">
                        <h5 style="margin-top:24px;">Analyse des échéances</h5>
                        <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                            <colgroup>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:16%;"/>
                            </colgroup>
                            <thead style="background-color:#f5f5f5;">
                                <tr>
                                    <th style="text-align:center;">Courant</th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">1 mois</t><t t-else="">1 - 30 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">2 mois</t><t t-else="">31 - 60 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">3 mois</t><t t-else="">61 - 90 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">4 mois</t><t t-else="">91 - 120 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">Plus ancien</t><t t-else="">121 jours +</t></th>
                                    <th style="text-align:center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align:right;"><span t-esc="buckets.get('current', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_1_30', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_30_60', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_60_90', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_90_120', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_over_120', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><strong><span t-esc="buckets.get('total', '0.00')"/> <span t-esc="currency"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>

                <!-- Outstanding -->
                <t t-if="statement_type in ('outstanding', 'all_invoices')">
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:16px;">
                        <colgroup>
                            <col style="width:11%;"/><col style="width:11%;"/><col style="width:16%;"/>
                            <col style="width:26%;"/><col style="width:18%;"/><col style="width:18%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;vertical-align:middle;">Date</th>
                                <th style="text-align:center;vertical-align:middle;">Date d'échéance</th>
                                <th style="text-align:center;vertical-align:middle;">Facture N°</th>
                                <th style="text-align:center;vertical-align:middle;">Référence</th>
                                <th style="text-align:right;vertical-align:middle;">Montant</th>
                                <th style="text-align:right;vertical-align:middle;">Reste à payer</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['invoices']" t-as="invoice">
                                <tr>
                                    <td style="text-align:center;vertical-align:middle;"><span t-esc="invoice['invoice_date']"/></td>
                                    <td style="text-align:center;vertical-align:middle;"><span t-esc="invoice.get('invoice_date_due') or ''"/></td>
                                    <td style="text-align:center;vertical-align:middle;"><span t-esc="invoice['invoice_id']"/></td>
                                    <td style="text-align:left;vertical-align:middle;"><span t-esc="invoice.get('ref') or ''"/></td>
                                    <td style="text-align:right;vertical-align:middle;"><span t-esc="invoice['amount']"/></td>
                                    <td style="text-align:right;vertical-align:middle;"><span t-esc="invoice['balance_due']"/></td>
                                </tr>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="4" style="text-align:right;vertical-align:middle;">Total</td>
                                <td style="text-align:right;vertical-align:middle;"><span t-esc="partner['total_amount']"/> <span t-esc="currency"/></td>
                                <td style="text-align:right;vertical-align:middle;"><span t-esc="partner['total_balance']"/> <span t-esc="currency"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-set="buckets" t-value="partner['aging_buckets']"/>
                    <t t-if="buckets and buckets.get('_has_balance')">
                        <h5 style="margin-top:24px;">Analyse des échéances</h5>
                        <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                            <colgroup>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:16%;"/>
                            </colgroup>
                            <thead style="background-color:#f5f5f5;">
                                <tr>
                                    <th style="text-align:center;">Courant</th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">1 mois</t><t t-else="">1 - 30 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">2 mois</t><t t-else="">31 - 60 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">3 mois</t><t t-else="">61 - 90 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">4 mois</t><t t-else="">91 - 120 jours</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">Plus ancien</t><t t-else="">121 jours +</t></th>
                                    <th style="text-align:center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align:right;"><span t-esc="buckets.get('current', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_1_30', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_30_60', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_60_90', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_90_120', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><span t-esc="buckets.get('b_over_120', '0.00')"/> <span t-esc="currency"/></td>
                                    <td style="text-align:right;"><strong><span t-esc="buckets.get('total', '0.00')"/> <span t-esc="currency"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>
            </div>
        </t>
    </template>
    <!-- Main template -->
    <template id="customer_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="partner">
                <t t-call="partner_statement_report.customer_statement_document"/>
            </t>
        </t>
    </template>
    <!-- Report Action -->
    <record id="customer_report_template_action" model="ir.actions.report">
        <field name="name">Relevé de compte partenaire</field>
        <field name="model">customer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_statement_report.customer_report_template</field>
        <field name="report_file">partner_statement_report.customer_report_template</field>
        <field name="binding_model_id" ref="model_customer_statement_wizard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>