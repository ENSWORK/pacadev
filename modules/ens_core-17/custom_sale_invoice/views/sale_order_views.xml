<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vues existantes inchangées -->
    <record id="view_sale_advance_payment_inv_inherit" model="ir.ui.view">
        <field name="name">sale.advance.payment.inv.form.inherit</field>
        <field name="model">sale.advance.payment.inv</field>
        <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='create_invoices']" position="after">
                <button string="Create and Validate Invoice" name="create_and_validate_invoices" type="object" class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_custom_sale_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.sale.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_force_sale"
                        string="Vente Forcée"
                        type="object"
                        groups="custom_sale_invoice.group_allow_force_sale"
                        invisible="state not in ('sale', 'done') or delivery_status != 'full' or invoice_status in ('invoiced', 'force_invoiced')"
                        class="btn-secondary"/>
            </xpath>
            <field name="state" position="after">
                <field name="delivery_status" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- Vue de recherche pour combined.sale.invoice -->
    <record id="view_combined_sale_invoice_search" model="ir.ui.view">
        <field name="name">combined.sale.invoice.search</field>
        <field name="model">combined.sale.invoice</field>
        <field name="arch" type="xml">
            <search string="Recherche Commandes et Factures">
                <field name="name" string="Numéro" filter_domain="[('name', 'ilike', self)]"/>
                <field name="partner_id" string="Client" filter_domain="[('partner_id', 'child_of', self)]"/>
                <field name="user_id" string="Vendeur"/>
                <separator/>
                    <filter string="Commandes livrées non payées" name="unpaid_delivered_orders"
                        domain="[('type', '=', 'so'), ('delivery_status', '=', 'full'), ('payment_state', '!=', 'paid')]"/>
                    <filter string="Factures non payées" name="unpaid_invoices"
                        domain="[('type', '=', 'invoice'), ('payment_state', '!=', 'paid')]"/>
                    <filter string="Situation comptable" name="accounting_situation"
                        domain="['|', '&amp;', ('type', '=', 'so'), ('delivery_status', '=', 'full'), ('payment_state', '!=', 'paid'), '&amp;', ('type', '=', 'invoice'), ('payment_state', '!=', 'paid')]"/>
                <separator/>
                <filter string="Commandes" name="is_sale_order" domain="[('type', '=', 'so')]"/>
                <filter string="Factures" name="is_invoice" domain="[('type', '=', 'invoice')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today" domain="[('date_order', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Cette semaine" name="this_week" domain="[('date_order', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Ce mois" name="this_month" domain="[('date_order', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Non payé" name="not_paid" domain="[('payment_state', '=', 'not_paid')]"/>
                <filter string="Partiellement payé" name="partially_paid" domain="[('payment_state', '=', 'partial')]"/>
                <filter string="Payé" name="paid" domain="[('payment_state', '=', 'paid')]"/>
                <separator/>
                <filter string="À facturer" name="to_invoice" domain="[('invoice_status', '=', 'to invoice')]"/>
                <filter string="Facturé" name="invoiced" domain="[('invoice_status', '=', 'invoiced')]"/>
            <group expand="0" string="Regrouper par">
                <filter string="Client" name="customer" context="{'group_by': 'partner_id'}"/>
                <filter string="Vendeur" name="salesperson" context="{'group_by': 'user_id'}"/>
                <filter string="État de paiement" name="payment_state" context="{'group_by': 'payment_state'}"/>
                <filter string="Type" name="type" context="{'group_by': 'type'}"/>
                <filter string="Date" name="date" context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue en arbre mise à jour pour combined.sale.invoice avec actions -->
    <record id="view_combined_sale_invoice_tree" model="ir.ui.view">
        <field name="name">combined.sale.invoice.tree</field>
        <field name="model">combined.sale.invoice</field>
        <field name="arch" type="xml">
            <tree string="Commandes et Factures" decoration-info="type=='so'" decoration-muted="type=='invoice'">
                <header>
                    <button name="action_view_not_paid" type="object" string="Non payé"/>
                    <button name="action_view_to_invoice" type="object" string="À facturer"/>
                </header>
                <field name="name" string="Numéro"/>
                <field name="date_order" string="Date"/>
                <field name="partner_id" string="Client"/>
                <field name="user_id" string="Vendeur"/>
                <field name="amount_total" string="Total" sum="Total"/>
                <field name="amount_paid" string="Payé" sum="Total Payé"/>
                <field name="amount_due" string="Restant dû" sum="Total Dû"/>
                <field name="payment_state" string="État de paiement" widget="badge"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'partially_paid'"
                       decoration-danger="payment_state == 'not_paid'"/>
                <field name="delivery_status" string="Statut de livraison"/>
                <field name="invoice_status" string="Statut de facturation"/>
                <field name="amount_to_invoice" string="À facturer" sum="Total à facturer"/>
                <field name="reference" string="Référence client"/>
                <field name="type" string="Type"/>
            </tree>
        </field>
    </record>

    <!-- Vue formulaire pour combined.sale.invoice -->
    <record id="view_combined_sale_invoice_form" model="ir.ui.view">
        <field name="name">combined.sale.invoice.form</field>
        <field name="model">combined.sale.invoice</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_order"/>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                        <field name="amount_total"/>
                        <field name="amount_paid"/>
                        <field name="amount_due"/>
                        <field name="payment_state"/>
                        <field name="delivery_status"/>
                        <field name="invoice_status"/>
                        <field name="amount_to_invoice"/>
                        <field name="reference"/>
                        <field name="type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue graphique pour combined.sale.invoice -->
    <record id="view_combined_sale_invoice_graph" model="ir.ui.view">
        <field name="name">combined.sale.invoice.graph</field>
        <field name="model">combined.sale.invoice</field>
        <field name="arch" type="xml">
            <graph string="Analyse des Commandes et Factures" type="bar">
                <field name="date_order" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action de fenêtre pour combined.sale.invoice -->
    <record id="action_combined_sale_invoice_view" model="ir.actions.act_window">
        <field name="name">Commandes et Factures</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">combined.sale.invoice</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="search_view_id" ref="view_combined_sale_invoice_search"/>
        <field name="context">{'search_default_today': 1, 'search_default_customer': 1}</field>
    </record>

    <!-- Action de fenêtre pour situation comptable -->
    <record id="action_combined_sale_invoice_view" model="ir.actions.act_window">
        <field name="name">Situation Comptable</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">combined.sale.invoice</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="search_view_id" ref="view_combined_sale_invoice_search"/>
        <field name="context">{'search_default_accounting_situation': 1, 'search_default_customer': 1}</field>
    </record>

    <!-- Menu item pour combined.sale.invoice -->
    <menuitem id="menu_combined_sale_invoice"
              name="Commandes et Factures"
              action="action_combined_sale_invoice_view"
              parent="sale.sale_menu_root"
              sequence="30"/>
</odoo>