<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_crm_create_task_wizard_form" model="ir.ui.view">
        <field name="name">crm.create.task.wizard.form</field>
        <field name="model">crm.create.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Task from CRM Pipeline/Lead">
                <group>
                    <group>
                        <field name="opportunity_id" invisible="1"/>
                        <field name="action_type" widget="radio"/>
                    </group>
                </group>

                <separator/>

                <!-- Section for creating new task -->
                <group invisible="action_type != 'create_new'">
                    <group>
                        <field name="name" string="Name" placeholder="Task name..."/>
                        <field name="project_id" string="Project"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="user_ids" string="Assigned to" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="date_deadline" string="Deadline"/>
                        <field name="tag_ids" string="Tags" widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="partner_id" string="Partner"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="date_assign" string="Assigning Date"/>
                        <field name="company_id" string="Company"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="stage_id" string="Stage"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group colspan="2">
                        <field name="description" string="Description"
                               placeholder="Task description..."/>
                    </group>
                </group>

                <!-- Section for linking to existing task -->
                <group invisible="action_type != 'link_existing'">
                    <field name="existing_task_id" string="Select Task"
                           placeholder="Search for existing task..."
                           options="{'no_create': True}"
                           required="action_type == 'link_existing'"/>
                </group>

                <footer>
                    <button name="action_create_task"
                            string="Create Task"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_crm_create_task_wizard" model="ir.actions.act_window">
        <field name="name">Create Task from CRM Pipeline/Lead</field>
        <field name="res_model">crm.create.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
