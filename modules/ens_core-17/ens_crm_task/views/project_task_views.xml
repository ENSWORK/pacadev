<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Opportunity smart button to Task form -->
    <record id="view_project_task_form_inherit_opportunity" model="ir.ui.view">
        <field name="name">project.task.form.inherit.opportunity</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!-- Add opportunity_id field (invisible) -->
            <xpath expr="//field[@name='recurrence_id']" position="after">
                <field name="opportunity_id" invisible="1"/>
            </xpath>

            <!-- Add smart button for opportunity -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_opportunity"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-link"
                        invisible="not opportunity_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Lead</span>
                        <span class="o_stat_value">1</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
