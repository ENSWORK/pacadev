# Fichier de configuration du job de projection Odoo.
#
# COPIEZ CE FICHIER EN `.env` SUR LE SERVEUR ET RENSEIGNEZ LA CLE.
# NE VERSIONNEZ JAMAIS LE `.env` REEL : il est dans le .gitignore racine.
#
#   cp core/scripts/operations/.env.example core/scripts/operations/.env
#   chmod 600 core/scripts/operations/.env
#   nano    core/scripts/operations/.env
#
# La cle est celle du connecteur MCP Odoo (base `erpenswork`). Elle est
# aujourd'hui stockee dans la configuration opencode du poste Windows ; ce job
# doit pouvoir tourner sans le poste, d'ou sa copie ici.
# Regle du referentiel : un secret ne vit que dans un fichier de secrets.

ODOO_MCP_URL=http://192.168.11.50:9017/mcp
ODOO_API_KEY=
