<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<template id="report_facture_inherit_mod3" inherit_id="ourcustom_impression.report_ourinvoice_document_inherit">
			<xpath expr="//div[@class='amount2word']" position="replace">
				<style>
					strong,p{
					display:inline;}
				</style>
				<p>
        			<strong>Arrêter la pr&#233;sente facture à la somme de:</strong>
        			<p t-esc="o.get_amount_letter()"/>
    			</p>
			</xpath>
		</template>
		<template id="report_facture_inherit_mod4" inherit_id="ourcustom_impression.report_ourinvoice_document_inherit_whf">
