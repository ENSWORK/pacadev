<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_enswork_settings_inherit_commv2" model="ir.ui.view">
        <field name="name">Enswork Settings Inherit Communv2</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ourcustom_settings.view_enswork_settings_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='sales']" position="inside">
                <div class="row mt16 o_settings_container" id="check_product_sale_price">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="check_product_sale_price"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="check_product_sale_price" string="Vérifier le prix de vente du produit"/>
                            <div class="text-muted" name="btn_text_muted">
                                 Bloquer l'utilisateur au moment de la saisie d'un prix de vente sur la commande moins de du prix de vente sur l'article.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt16 o_settings_container" id="min_discount_setting">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="min_discount_by_categ"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="min_discount_by_categ" string="Remise minimum par catégorie d'article"/>
                            <div class="text-muted" name="btn_text_muted">
                                 Ajouter une limite de remise minimum a saisir par famille d'article.
                            </div>
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>
</odoo>