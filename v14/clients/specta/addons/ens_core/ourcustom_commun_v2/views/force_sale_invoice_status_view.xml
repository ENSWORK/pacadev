<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
         <record id="force_sale_invoice_status_viwe" model="ir.ui.view">
            <field name="name">force_sale_invoice_status_viwe</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <header>
                        <button
                                name="action_force_sale_invoice_status"
                                string="Marqué Comme Vendue"
                                type="object"
                                class="btn-primary"
                                attrs="{'invisible':['|', '|', ('invoice_status', '!=', ('to invoice')), ('show_hide_btn_force_inv_status', '=', False), ('invoice_status', '=', 'cmd vendue')]}"
                        />
                        <button
                                name="action_force_sale_invoice_status"
                                string="Marqué Comme Vendue"
                                type="object"
                                attrs="{'invisible':['|', ('show_hide_btn_force_inv_status', '=', False), ('invoice_status', '!=', 'cmd vendue')]}"
                        />
                </header>
                <xpath expr="sheet/div[@class='oe_title']" position="before">
                    <widget
                            name="web_ribbon"
                            title="Vendue"
                            bg_color="bg-black"
                            attrs="{'invisible': [('invoice_status', '!=', 'cmd vendue')]}"
                        />

                </xpath>
            </field>
        </record>

    </data>
</odoo>