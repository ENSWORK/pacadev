<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Increase DB Report LOGO SIZE-->
    <template id="purchasequotation_dollibar_headfoot_specta" inherit_id="ourcustom_impression.report_purchasequotation_dollibar_headfoot">
        <xpath expr="//div[hasclass('header')]/div/div[hasclass('row','mb8')]/div[hasclass('col-6')]/img" position="replace">
            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-width: 350px; max-height: 200px;"/>
        </xpath>
    </template>
