"        % if object.date_planned:\n"
"            The receipt is expected for <strong>${format_date(object.date_planned)}</strong>.\n"
"            <br/><br/>\n"
"            Could you please acknowledge the receipt of this order?\n"
"        % endif\n"
"    </p>\n"
"</div>"
