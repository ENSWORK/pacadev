<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
         <record id="view_purchase_order_form_inherit_comm" model="ir.ui.view">
            <field name="name">view.purchase.order.form.inherit.comm</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="vente_origine" attrs="{'invisible': [('origin','=',False)]}" readonly="True"/>
                </xpath>
            </field>
        </record>
        <record id="view_sale_order_form_inherit_comm" model="ir.ui.view">
            <field name="name">view.sale.order.form.inherit.comm</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_invoice']" position="before">
                    <button type="object"
                        name="action_view_our_purchase"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        attrs="{'invisible': [('our_purchase_count', '=', 0)]}" groups="base.group_user">
                        <field name="our_purchase_count" widget="statinfo" string="Commande Achat"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
