<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_template_form_inherit_douane" model="ir.ui.view">
        <field name="name">product.template.inherit.douane</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_information']/group/group[@name='group_standard_price']" position="after">
                <group>
                    <field name="code_douanier"/>
                    <field name="taxe_douaniere" widget="percentage"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>