<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
             <xpath expr="//div[@class='alert alert-warning oe_edit_only']" position="replace">

             </xpath>
        </field>
     </record>
                    <!--Add ALERT in Product template-->
    <record id="view_product_template_only_form_inherit" model="ir.ui.view">
        <field name="name">product.template.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="same_ref_diff_categ" invisible="1"/>
            </xpath>
             <xpath expr="//sheet" position="before">
                 <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('same_ref_diff_categ', '=', False)]}">
                 <!-- A partner with the same <span><span class="o_vat_label">Tax ID</span></span> already exists (<field name="same_vat_partner_id"/>), are you sure to create a new one?-->
                     La Référence Interne exsiste déja dans une autre Catégorie, êtes-vous sûr d'en créer une nouvelle?
                </div>
             </xpath>
        </field>
     </record>
</odoo>