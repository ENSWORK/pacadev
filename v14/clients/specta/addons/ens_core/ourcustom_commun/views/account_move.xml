<?xml version="1.0" encoding="utf-8" ?>
<odoo><!--TACHE:Référence de la facture fournisseurs champ obligatoire et figée après la validation de la facture-->
     <record id="view_move_form_inherit_comm" model="ir.ui.view">
        <field name="name">view.move.form.inherit.comm</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
              <xpath expr="//form/sheet/group/group[@id='header_left_group']/field[@name='ref']" position="attributes">
                   <attribute name="attrs">{'readonly': [('state', '=', 'posted')],'required':[('move_type', 'in', ('in_invoice', 'in_receipt', 'in_refund'))],'invisible':[('move_type', 'not in', ('in_invoice', 'in_receipt', 'in_refund'))]}</attribute>
             </xpath>
        </field>
     </record>
</odoo>