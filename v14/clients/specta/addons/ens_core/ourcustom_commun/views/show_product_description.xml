<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_move_tree_inherit_desc" model="ir.ui.view">
        <field name="name">show.product.description.on.stock.move</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
           <!--Show name on stock.move (Field already exist)-->
            <!--<xpath expr="//page[@name='operations']/field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="after">
                 <field name="name"/>
            </xpath>-->
            <!--Set Description Picking invisible to avoid any conflict-->
            <xpath expr="//page[@name='operations']/field[@name='move_ids_without_package']/tree/field[@name='description_picking']" position="replace">
                <field name="description_picking" string="Description" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_move_line_tree_inherit_desc" model="ir.ui.view">
        <field name="name">show.product.description.on.stock.move.line</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <!--Add the new field 'ourname' to stock.move.line view-->
            <xpath expr="//tree/field[@name='product_id']" position="after">
                 <field name="ourname" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
