<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="our_product_template_search_view" model="ir.ui.view">
            <field name="name">our.product.template.search</field>
            <field name="model">product.template</field>
             <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="ref_article"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="replace">
                   <field name="name" string="Articles" filter_domain="['|', '|', '|', '|', ('ref_article', 'ilike', self), ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self),('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
                </xpath>
            </field>
        </record>
        <record id="our_product_search_form_view" model="ir.ui.view">
            <field name="name">our.product.search.form.view</field>
            <field name="model">product.product</field>
             <field name="inherit_id" ref="product.product_search_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="replace">
                   <field name="name" string="Articles" filter_domain="['|', '|', '|', ('ref_article', 'ilike', self), ('default_code', 'ilike', self),('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
                </xpath>
            </field>
        </record>
        <!-- Add group by Categ article in Inventaire/Analyse/Rapport d'Inventaire search view-->
        <record id="our_quant_search_view" model="ir.ui.view">
            <field name="name">our.quant.search.search</field>
            <field name="model">stock.quant</field>
             <field name="inherit_id" ref="stock.quant_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='company']" position="after">
                    <filter string='Catégorie Article' name="categgroup" context="{'group_by': 'categ_id'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>