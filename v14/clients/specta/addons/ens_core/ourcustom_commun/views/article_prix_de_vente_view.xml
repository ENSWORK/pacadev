<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_form_inherit" model="ir.ui.view">
        <field name="name">product.category.inherit</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="coefficient"/>
            </xpath>
        </field>
    </record>
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_information']/group/group[@name='group_standard_price']/field[@name='company_id']" position="before">
                <field name="coefficient_art"/>
                <field name="prix_de_vente_auto" invisible="1"/>
                <field name="reference_fournisseur"/>
            </xpath>
        </field>
    </record>
</odoo>