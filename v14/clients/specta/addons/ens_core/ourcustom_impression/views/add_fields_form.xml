<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="purchase_order_form_fieldcontact" model="ir.ui.view">
            <field name="name">purchase.order.form.fieldcontact</field>
            <field name="model">purchase.order</field> <!--The model that we inherit-->
            <field name="inherit_id" ref="purchase.purchase_order_form" /><!--The view that we inherit-->
            <field name="arch" type="xml">
                <field name="partner_ref" position="after">
                    <field name="ourcontact" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="ourtransporteurp" options="{'no_create': True, 'no_create_edit': True}" />
                </field>
            </field>
        </record>
        <record id="purchase_order_form_fieldadr" model="ir.ui.view">
            <field name="name">purchase.order.form.fieldadr</field>
            <field name="model">purchase.order</field> <!--The model that we inherit-->
            <field name="inherit_id" ref="purchase.purchase_order_form" /><!--The view that we inherit-->
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="ouradrliv" />
                    <!--<field name="ouradrfact" />-->
                </field>
            </field>
        </record>
         <record id="sale_order_form_fieldcontact" model="ir.ui.view">
            <field name="name">sale.order.form.fieldcontact</field>
            <field name="model">sale.order</field> <!--The model that we inherit-->
            <field name="inherit_id" ref="sale.view_order_form" /><!--The view that we inherit-->
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="ourcontact" options="{'no_create': True, 'no_create_edit': True}"/>
                </field>
            </field>
        </record>
        <record id="sale_order_form_fielddelai" model="ir.ui.view">
            <field name="name">sale.order.form.fielddelai</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='customer_lead']" position="replace">
                    <field name="ourdelai" />
                </xpath>
                <!--<field name="customer_lead" position="after">
                    <field name="ourdelai" />
                </field>-->
            </field>
        </record>
        <record id="stock_picking_form_fields" model="ir.ui.view">
            <field name="name">stock.picking.form.fields</field>
            <field name="model">stock.picking</field> <!--The model that we inherit-->
            <field name="inherit_id" ref="stock.view_picking_form" /><!--The view that we inherit-->
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="ourtransporteur" options="{'no_create': True, 'no_create_edit': True}" />
                </field>
            </field>
        </record>
                    <!--*******Case a cochee est un Transporteur*****-->
        <record id="res_partner_form_fieldtrs" model="ir.ui.view">
            <field name="name">res.partner.form.fiedtrs</field>
            <field name="model">res.partner</field> <!--The model that we inherit-->
            <field name="inherit_id" ref="base.view_partner_form" /><!--The view that we inherit-->
            <field name="arch" type="xml">
                 <xpath expr="//notebook/page[@name='sales_purchases']/group[@name='container_row_2']/group[@name='sale']/field[@name='user_id']" position="after">
                     <field name="ourtrs" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>