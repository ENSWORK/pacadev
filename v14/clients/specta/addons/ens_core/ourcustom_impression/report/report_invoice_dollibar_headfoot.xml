<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_dollibar_headfoot">
        <t t-set="company" t-value="user.company_id" />
        <div class="header" >
            <div>
                <style>
                   #informations {
                        display: block;
                        }
                   .m-0{
                        display:inline;
                         }
                   strong,p,span{
                        color:black;
                        }
               </style>
                <div class="row mb8">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-width: 250px; max-height: 100px;"/>
                    </div>
                     <div class="col-6 text-right mb4">
                        <p>
                            <strong><span style="font-size:17px;color:#0D0446" t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Facture</span></strong>
                            <strong><span style="font-size:17px;color:#0D0446" t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Facture en brouillon</span></strong>
                            <strong><span style="font-size:17px;color:#0D0446" t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Facture annulée</span></strong>
                            <strong><span style="font-size:17px;color:#0D0446" t-if="o.move_type == 'out_refund'">Avoir</span></strong>
                            <strong><span style="font-size:17px;color:#0D0446" t-if="o.move_type == 'in_refund'">Avoir de fournisseur</span></strong>
                            <strong><span style="font-size:17px;color:#0D0446" t-if="o.move_type == 'in_invoice'">Facture fournisseur</span></strong>
                            <strong><span style="font-size:17px;color:#0D0446" t-if="o.name != '/'" t-field="o.name"/></strong>
                        </p>
                         <div style="margin-top:-10px; font-size:13px" name="invoice_date">
                            <strong style="color:#0D0446">Date de la facture:</strong>
                            <p style="color:#0D0446" class="m-0" t-field="o.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/>
                        </div>
                         <div style="font-size:13px" name="date_due">
                            <strong style="color:#0D0446">Date d'échéance:</strong>
                            <p style="color:#0D0446" class="m-0" t-field="o.invoice_date_due" t-options='{"format": "dd/MM/yyyy"}'/>
                         </div>
                         <div style="font-size:13px" name="ref_command">
                            <strong style="color:#0D0446">Réf.commande:</strong>
                            <p style="color:#0D0446" class="m-0" t-field="o.ref"/>
                         </div>
                         <div t-if="o.move_type != 'in_refund' and o.move_type != 'in_invoice'" style="font-size:13px">
                             <strong style="color:#0D0446">Client N° : </strong><p class="m-0" t-field="o.partner_id.ref" style="color:#0D0446"/>
                         </div>
                         <div t-if="o.move_type == 'in_refund' or o.move_type == 'in_invoice'" style="font-size:13px">
                             <strong style="color:#0D0446">Fournisseur N° : </strong><p class="m-0" t-field="o.partner_id.ref" style="color:#0D0446"/>
                         </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            <style>
            hr.newhr{
                border: 1px solid #ABABAB;
                margin-top:0px;
                padding-top:0px;}
            p{
                font-size:10px;}
            </style>
                    <hr class="newhr" />
            <center><strong><p style="font-size:11px;margin-top:-10px;" t-field="company.report_footer"></p></strong></center>
             <div style="text-align:right;margin-top:-19px;color:black;font-size:10px" t-if="report_type == 'pdf'">
                 <span class="page"/> / <span class="topage"/>
             </div>

        </div>
    </template>
</odoo>