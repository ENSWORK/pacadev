<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_oursaleorder_document_inherit_whf" >
         <t t-set="company" t-value="user.company_id" /> <!--We need it for Primary/Secondary Colors-->
            <t t-call="web.html_container">
            <div class="article o_report_layout_boxed" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"><!--To ignore the default layout(remove header+footer)-->
                <style>
                   #informations {
                        display: block;
                        }
                   .m-0{
                        display:inline;
                         }
               </style>
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                 <div class="ourpage">
                    <!--<t t-call="web.address_layout"/>
                    <t t-raw="0"/>-->
            <div class="oe_structure"/>

                     <table style="width:100%;border:0px">
                        <tr>
                            <td style="width:50%;border:0px">
                                <h2 class="mt16">
                                 <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                                    <span t-if="o.state not in ['draft','sent']" style="font-size:20px"  ><strong>Offre Commerciale</strong></span>
                                    <!--<strong><span t-if="o.state not in ['draft','sent']" t-field="o.name" style="font-size:20px" /></strong>-->
                                <!--<span t-if="o.state in ['draft','sent']">Quotation # </span>-->
                                    <span t-if="o.state in ['draft','sent']" style="font-size:20px" ><strong>Offre Commerciale</strong> </span>
                                </t>
                                <t t-if="env.context.get('proforma', False) or is_pro_forma">
                                    <span style="font-size:20px" ><strong>Facture Pro-Forma</strong></span>
                                 </t>

                                </h2>

                                <div class="row mt32 mb32" id="informations" style="color:black">
                                    <div  class="col-auto col-3 mw-100 mb-2">
                                        <strong>Numéro:</strong>
                                        <p class="m-0" t-field="o.name"/>
                                    </div>
                                    <div t-if="o.date_order and o.state not in ['draft','sent']" style="margin-top:-10px;" class="col-auto col-3 mw-100 mb-2">
                                        <strong>Order Date:</strong>
                                        <p class="m-0" t-field="o.date_order" t-options='{"format" : "dd/MM/yyyy"}'/>
                                    </div>
                                    <div t-if="o.date_order and o.state in ['draft','sent']" style="margin-top:-10px;" class="col-auto col-3 mw-100 mb-2">
                                        <strong>Quotation Date:</strong>
                                        <p class="m-0" t-field="o.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                    </div>
                <!--<div t-if="o.validity_date and o.state in ['draft', 'sent']" class="col-auto col-3 mw-100 mb-2" name="expiration_date">
                    <strong>Expiration:</strong>
                    <p class="m-0" t-field="o.validity_date"/>
                </div>-->
                                    <div class="col-auto col-3 mw-100 mb-2" style="color:black;margin-top:-10px" name="user_contact">
                                        <strong>Votre Contact:</strong>
                                        <p class="m-0" t-field="o.user_id"/>
                                    </div>
                                    <div class="col-auto col-3 mw-100 mb-2"  style="margin-top:-10px;color:black;"  name="user_phone">
                                        <strong>Téléphone:</strong>
                                        <p class="m-0" t-field="o.user_id.phone"/>
                                    </div>
                                    <div class="col-auto col-3 mw-100 mb-2"  style="margin-top:-10px;color:black;"  name="user_email">
                                        <strong>E-mail:</strong>
                                        <p class="m-0" t-field="o.user_id.email"/>
                                    </div>
                                    <!--<div class="col-auto col-3 mw-100 mb-2" style="color:black;margin-top:-10px"  name="user_email">
                                        <strong>Objet:</strong>
                                        <p class="m-0" t-field="o.opportunity_id"/>
                                    </div>-->

                                </div>
                            </td>
                            <style>
                                /*Border Cornerred*/
                    #content {
                          position:relative;
                          width:420px;
                          height:190px;
                          align-items: center;
                    }

                    #content:before,
                    #content:after,
                    #content>:last-child:before,
                    #content>:last-child:after {
                        position: absolute;
                        width: 60px;
                        height: 50px;
                        border-color: black;
                        border-style: solid;
                        content: ' ';
                    }

                    #content:before {
                        top: 10px;
                        left: 10px;
                        width:20%;
                        border-right:0px;
                        border-bottom:0px;
                        border-width: 1px 0px 0px 1px;
                    }

                    #content:after {
                        top: 10px;
                        right: 10px;
                        width:20%;
                        border-left:0px;
                        border-bottom:0px;
                        border-width: 1px 1px 0px 0px;
                    }

                    #content>:last-child:before {
                        bottom: 10px;
                        right: 10px;
                        width:20%;
                        border-left:0px;
                        border-top:0px;
                        border-width: 0px 1px 1px 0px;
                    }

                    #content>:last-child:after {
                        bottom: 10px;
                        left: 10px;
                        width:20%;
                        border-right:0px;
                        border-top:0px;
                        border-width: 0px 0px 1px 1px;
                    }
                            </style>
                            <td  style="width:50%;border:none">
                                <div id="content" style="padding-left:20px;padding-right:20px">
                                            <div style="color:black;padding-top:20px"><p class="m-0" t-field="o.partner_id"/></div>
                                            <div style="color:black">
                                                <span t-field="o.partner_id.street"></span>&#032;<span t-field="o.partner_id.street2"></span>&#032;
                                                <span t-field="o.partner_id.city"></span>&#032;<span t-field="o.partner_id.state_id"></span>&#032;
                                                <span t-field="o.partner_id.zip"></span>&#032;<span t-field="o.partner_id.country_id"></span></div>
                                            <div style="color:black"><strong>Tél :</strong><p class="m-0" t-field="o.partner_id.phone"/></div>
                                            <div style="color:black"><strong>Contact : </strong><p class="m-0" t-field="o.ourcontact"/></div>
                                            <div style="color:black"><strong>E-mail :</strong><p class="m-0" t-field="o.partner_id.email"/></div>
                                </div>
                            </td>
                        </tr>
                     </table><br/>


                     <!--TABLE  PRINCIPALE-->
            <!-- Is there a discount on at least one line? -->
                     <style>
                         .rows_color2 tr:nth-child(even){
		                    background-color: #B1B7BF !important;
                        }
                     </style>
            <t t-set="display_discount" t-value="any(l.discount for l in o.order_line)"/>
            <t t-set="display_delai" t-value="any(l.ourdelai for l in o.order_line)"/>

            <table class="table table-sm o_main_table rows_color2">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <thead>
                    <tr>
                        <th t-attf-style="background-color:{{company.primary_color}}!important;color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_line_num" class="text-center">N°Ligne</th>
                        <th t-attf-style="background-color:{{company.primary_color}}!important;color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_description" class="text-left">Description</th>
                        <th t-attf-style="background-color:{{company.primary_color}}!important;color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_quantity" class="text-center">Quantity</th>
                        <th t-attf-style="background-color:{{company.primary_color}}!important;color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_quantity" class="text-center">UdM</th>
                        <th t-attf-style="background-color:{{company.primary_color}}!important;color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_delai"  t-if="display_delai" class="text-center">Délai</th>
                        <th t-attf-style="background-color:{{company.primary_color}}!important;color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_priceunit" class="text-right">P.U HT en <span t-field="o.currency_id.symbol"></span></th>
                        <th t-attf-style="background-color:{{company.primary_color}}!important;color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_discount" t-if="display_discount" class="text-right" groups="product.group_discount_per_so_line">
                            <span>Disc.%</span>
                        </th>
                        <!--<th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_taxes" class="text-right">Taxes</th>-->
                        <th t-attf-style="background-color:{{company.primary_color}}!important;color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_subtotal" class="text-right">
                            <span groups="account.group_show_line_subtotals_tax_excluded">Total HT<!--Amount--></span>
                            <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <t t-set="current_subtotal" t-value="0"/>

                    <t t-foreach="o.order_line" t-as="line">

                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                                <td style="color:black;vertical-align:middle" name="td_line_num" class="text-center"><span t-field="line.sl_no"/></td>
                                <td style="color:black" name="td_name"><span t-field="line.name"/></td>
                                <td style="color:black;vertical-align:middle" name="td_quantity" class="text-center">
                                    <span t-field="line.product_uom_qty"/>
                                    <!--<span t-field="line.product_uom" groups="uom.group_uom"/>-->
                                </td>
                                <td style="color:black;vertical-align:middle" name="td_uom" class="text-center">
                                    <span t-field="line.product_uom" groups="uom.group_uom"/>
                                </td>
                                <td  t-if="display_delai" style="color:black;vertical-align:middle" name="td_delai" class="text-center">
                                    <span t-field="line.ourdelai" />
                                </td>
                                <td style="color:black;vertical-align:middle" name="td_priceunit" class="text-right">
                                    <span t-field="line.price_unit"/>
                                </td>
                                <td style="color:black;vertical-align:middle" t-if="display_discount" class="text-right" groups="product.group_discount_per_so_line">
                                    <!--<span t-field="line.discount"/>-->
                                     <span t-esc="str('%.2f'% line.discount).replace('.',',')"/>
                                </td>
                                <!--<td name="td_taxes" class="text-right">
                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>
                                </td>-->
                                <td style="color:black;vertical-align:middle" name="td_subtotal" class="text-right o_price_total">
                                    <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td style="color:black" name="td_section_line" colspan="99">
                                    <span t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td style="color:black" name="td_note_line" colspan="99">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>

                        <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-right">
                                <td style="color:black" name="td_section_subtotal" colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <div class="clearfix" name="so_total_summary">
                <div id="total" class="row" name="total">
                    <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto">
                        <table class="table table-sm" style="page-break-inside: avoid;">
                            <tr class="border-black o_subtotal" style="">
                                <td name="td_amount_untaxed_label"><strong>Total HT<!--Subtotal--></strong></td>
                                <td name="td_amount_untaxed" class="text-right">
                                    <span style="color:black" t-field="o.amount_untaxed"/>
                                </td>
                            </tr>
                            <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                <tr style="color:black">
                                    <t t-if="amount_by_group[5] == 1 and o.amount_untaxed == amount_by_group[2]">
                                        <td name="td_amount_by_group_label_3">
                                            <span t-esc="amount_by_group[0]"/>
                                            <span>&amp;nbsp;<span>on</span>&amp;nbsp;<t t-esc="amount_by_group[2]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.pricelist_id.currency_id}"/></span>
                                        </td>
                                        <td name="td_amount_by_group_3" class="text-right o_price_total">
                                            <span t-esc="amount_by_group[1]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.pricelist_id.currency_id}"/>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td name="td_amount_by_group_label">
                                            <span t-esc="amount_by_group[0]"/>
                                        </td>
                                        <td name="td_amount_by_group" class="text-right o_price_total">
                                            <span t-esc="amount_by_group[1]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.pricelist_id.currency_id}"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                            <tr class="border-black o_total">
                                <td t-attf-style="background-color:{{company.secondary_color}}!important;" name="td_amount_total_label"><strong style="color:white">Total TTC</strong></td>
                                <td t-attf-style="background-color:{{company.secondary_color}}!important;" name="td_amount_total" class="text-right">
                                    <span t-field="o.amount_total"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

                <div class="oe_structure"/>
                <div style="color:black;page-break-inside: avoid;">
                    <p style="font-style: italic;">
                      <strong style="text-decoration: underline;">Conditions Générales :</strong><br/>
                       <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-8px">
                           <strong>Validité de l'offre  :</strong>
                           <p class="m-0" t-field="o.validity_date"/>
                       </div>
                        <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px">
                           <strong>Conditions de paiement  :</strong>
                           <p class="m-0" t-field="o.payment_term_id"/>
                       </div>
                        <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px">
                           <strong>Conditions de livraison  :</strong>
                           <p class="m-0" t-field="o.incoterm"/>
                       </div>
                    </p>
                    <div style="float:right;color:black"><strong>Service Commercial</strong></div>
                </div><br/><br/><br/>
                <div>
                    <p style="font-style: italic;color:black;font-size:9px">
                        <strong style="text-decoration: underline;">N.B :</strong><br/>
                        <strong>*</strong>Merci de noter nos références en cas de commande.<br/>
                        <strong>*</strong>Le délai de livraison ci-dessus est valable à la date du devis et susceptible d'être revu en fonction de la date de réception de la commande.<br/>
                        <strong>*</strong>Notre offre est établie pour des prestations standard hors cahier des charges. Toutes  spécifications particulières est convenues sur le descriptif qui peut  être en pièce jointe.<br/>
                    </p>
                </div>
           </div>
            </div>
            </t>
    </template>
</odoo>
