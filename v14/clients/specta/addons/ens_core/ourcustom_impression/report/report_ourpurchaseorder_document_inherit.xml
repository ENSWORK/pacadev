<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_ourpurchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
             <div class="article o_report_layout_boxed" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"><!--To ignore the default layout(remove header+footer)-->
                <t t-call="ourcustom_impression.ourcustom_header_footerbc" />
                <style>
                   #informations {
                        display: block;
                        }
                   .m-0{
                        display:inline;
                         }
                   strong,p,span{
                        color:black;
                        }
                    div.T2{
                    display:inline-block;
                    }
                    .rows_color tr:nth-child(even){
		                background: #B1B7BF;
                    }

                    /*Border Cornerred*/
                    #content {
                          position:relative;
                          width:420px;
                          height:190px;
                          align-items: center;
                    }

                    #content:before,
                    #content:after,
                    #content>:last-child:before,
                    #content>:last-child:after {
                        position: absolute;
                        width: 60px;
                        height: 50px;
                        border-color: black;
                        border-style: solid;
                        content: ' ';
                    }

                    #content:before {
                        top: 10px;
                        left: 10px;
                        width:20%;
                        border-right:0px;
                        border-bottom:0px;
                        border-width: 1px 0px 0px 1px;
                    }

                    #content:after {
                        top: 10px;
                        right: 10px;
                        width:20%;
                        border-left:0px;
                        border-bottom:0px;
                        border-width: 1px 1px 0px 0px;
                    }

                    #content>:last-child:before {
                        bottom: 10px;
                        right: 10px;
                        width:20%;
                        border-left:0px;
                        border-top:0px;
                        border-width: 0px 1px 1px 0px;
                    }

                    #content>:last-child:after {
                        bottom: 10px;
                        left: 10px;
                        width:20%;
                        border-right:0px;
                        border-top:0px;
                        border-width: 0px 0px 1px 1px;
                    }

                </style>
                  <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
        <!--<t t-set="address">
            <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
            <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/></p>
        </t>
        <t t-if="o.dest_address_id">
            <t t-set="information_block">
                <strong>Shipping address:</strong>
                <div t-if="o.dest_address_id">
                    <div t-field="o.dest_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" name="purchase_shipping_address"/>
                </div>

            </t>
        </t>-->
        <div class="ourpage">
            <div class="oe_structure"/>
            <table style="width:100%;border:0px" class="mod">
                <tr>
                    <td style="width:50%;border:0px;padding-top:0px">
                        <h2>
                            <!--<strong style="font-size:20px" t-if="o.state == 'draft'">Request for Quotation N°<span t-field="o.name"/></strong> -->
                            <strong style="font-size:20px">Bon de Commande N°<span t-field="o.name"/></strong>
                            <!--<strong style="font-size:20px" t-if="o.state in ['purchase', 'done']">Purchase Order N°<span t-field="o.name"/></strong>
                            <strong style="font-size:20px" t-if="o.state == 'cancel'">Cancelled Purchase Order N°<span t-field="o.name"/></strong>-->
                        </h2>
                        <div id="informations" class="row mt32 mb32">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Order Date:</strong>
                                <!--<p t-field="o.date_order" class="m-0"/>-->
                                <span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Votre Offre:</strong>
                                <p t-field="o.partner_ref" class="m-0"/>
                            </div>
                         </div>
                    </td>
                    <td  style="width:50%;border:0px">
                        <div id="content" style="padding-left:20px;padding-right:20px">
                                        <div class="mod1"><center><strong>Fournisseur N° : </strong><p class="m-0" t-field="o.partner_id.ref"/></center></div>
                                        <div class="mod2" style="padding-top:2px;"><p class="m-0" t-field="o.partner_id"/></div>
                                        <div><span t-field="o.partner_id.street"></span>&#032;<span t-field="o.partner_id.street2"></span>&#032;
                                            <span t-field="o.partner_id.city"></span>&#032;<span t-field="o.partner_id.state_id"></span>&#032;
                                            <span t-field="o.partner_id.zip"></span>&#032;<span t-field="o.partner_id.country_id"></span></div>
                                        <div><strong>Tél :</strong><p class="m-0" t-field="o.partner_id.phone"/></div>
                                        <div><strong>Contact :</strong><p class="m-0" t-field="o.ourcontact"/></div>
                                        <div><strong>E-mail :</strong><p class="m-0" t-field="o.partner_id.email"/></div>
                        </div>
                    </td>
                </tr>
            </table>

           <br/>
            <table style="border:1px solid black;width:100%">
                <tr>
                    <td style="padding-top:6px;width:50%;border:0px;font-size:13px">
                        <!--<div style="float:left">-->
                            <div class="col-auto col-3 mw-100 mb-2">
                                <div><strong>Adresse de facturation :</strong></div><span t-field="o.partner_id"/><br/>
                                 <!--<span t-field="o.ouradrfact"></span>-->
                                <span t-field="o.partner_id.street"></span>&#032;<span t-field="o.partner_id.street2"></span>&#032;<span t-field="o.partner_id.city"></span><!--<t t-if="o.ourcontact.zip or o.ourcontact.state_id or o.ourcontact.country_id"><br/></t>-->
                                <span t-field="o.partner_id.state_id"></span>&#032;<span t-field="o.partner_id.zip"></span>&#032;<span t-field="o.partner_id.country_id"></span>

                            </div>
                        <!--</div>-->
                    </td><td style="padding-top:6px;width:50%;border:0px;font-size:13px">
                         <!--<div style="float:right">-->
                            <div class="col-auto col-3 mw-100 mb-2">
                                <div><strong>Lieu de livraison :</strong></div><span t-field="o.ouradrliv.partner_id.name"/><br/>
                                 <!--<span t-field="o.ouradrliv.partner_id.contact_address"></span>-->
                                <span t-field="o.ouradrliv.partner_id.street"></span>&#032;<span t-field="o.ouradrliv.partner_id.street2"></span>&#032;<span t-field="o.ouradrliv.partner_id.city"></span><!--<t t-if="o.ouradrliv.partner_id.state_id or o.ouradrliv.partner_id.zip or o.ouradrliv.partner_id.country_id"><br/></t>-->
                                <span t-field="o.ouradrliv.partner_id.state_id"></span>&#032;<span t-field="o.ouradrliv.partner_id.zip"></span>&#032;<span t-field="o.ouradrliv.partner_id.country_id"></span>

                            </div>
                        <!--</div>-->
                    </td>
                </tr>
                <tr style="border: 1px solid black">
                    <td style="padding-top:-2px;padding-bottom:-2px" colspan="2">
                        <div class="T2"  style="max-width:300px;vertical-align:middle;font-size:13px">
                            <div class="col-auto col-3 mw-100 mb-2"  name="responsable_achat">
                                <strong>Acheteur :</strong>
                                <p class="m-0" t-field="o.user_id"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px"  name="responsable_numero">
                                <strong>Téléphone :</strong>
                                <p class="m-0" t-field="o.user_id.phone"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px"  name="responsable_email">
                                <strong>E-mail :</strong>
                                <p class="m-0" t-field="o.user_id.email"/>
                            </div>
                        </div>
                        <div class="T2"  style="max-width:300px;vertical-align:middle;font-size:13px">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Date de livraison :</strong>
                                <!--<p class="m-0" t-field="o.date_planned"/>-->
                                <span t-field="o.date_planned" t-options='{"format": "dd/MM/yyyy"}'/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px" >
                                <strong>Incoterms : </strong>
                                <p class="m-0" t-field="o.incoterm_id"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px" >
                                <strong>Transporteur : </strong>
                                <p class="m-0" t-field="o.ourtransporteurp"/>
                            </div>
                        </div>
                        <div class="T2"  style="max-width:300px;vertical-align:middle">
                            <div class="col-auto col-3 mw-100 mb-2"  >
                                <strong>Devise : </strong>
                                <p class="m-0" t-field="o.currency_id"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px" >
                                <strong>Condition de paiement : </strong>
                                <p class="m-0" t-field="o.payment_term_id"/>
                             </div>

                        </div>
                    </td>
                </tr>
            </table><br/>


                <!--TABLE PRINCIPALE-->
            <t t-set="display_discount" t-value="any(l.discount for l in o.order_line)"/>
            <table class="table table-sm o_main_table rows_color">
                <thead>
                    <tr>
                        <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_line_num" class="text-center">N°Ligne</th>
                        <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_description"><strong>Référence / Description d'article</strong></th>
                        <!--<th name="th_taxes"><strong>Taxes</strong></th>-->
                        <!--<th name="th_date_req" class="text-center"><strong>Date Req.</strong></th>-->
                        <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_quantity" class="text-center"><strong>Quantité</strong></th>
                        <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_udm" class="text-center"><strong>UdM</strong></th>
                        <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_price_unit" class="text-right"><strong>P.U Brut en <span t-field="o.currency_id.symbol"></span></strong></th>
                        <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_discount"  t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="display_discount"  class="text-right"><strong><span>Remise</span></strong></th>
                        <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_priceunit_net" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="display_discount" class="text-right"><strong><span>P.U Net en <span t-field="o.currency_id.symbol"></span></span></strong></th>
                        <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_amount" class="text-right"><strong>Total HT en <span t-field="o.currency_id.symbol"></span></strong></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="o.order_line" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">

                                <td style="color:black;vertical-align:middle" name="td_line_num" class="text-center"><span t-field="line.sl_no"/></td>
                                <td id="product" >
                                    <span t-field="line.name"/>
                                </td>
                                <!--<td name="td_taxes">
                                    <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/>
                                </td>-->
                                <!--<td class="text-center">
                                    <span t-field="line.date_planned"/>
                                </td>-->


                                <td class="text-center" style="vertical-align:middle">
                                    <span t-field="line.product_qty"/>
                                    <!--<span t-field="line.product_uom.name" groups="uom.group_uom"/>-->
                                </td>
                                <td class="text-center" style="vertical-align:middle">
                                            <span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                        </td>
                                <td class="text-right" style="vertical-align:middle">
                                    <span t-field="line.price_unit"/>
                                </td>
                                <td class="text-right" t-if="display_discount" style="vertical-align:middle">
                                    <span  t-esc="str('%.2f'% line.discount).replace('.',',')"/>%
                                </td>
                                 <td class="text-right" t-if="display_discount" style="vertical-align:middle">
                                     <t t-if="line.price_unit != 0" t-set="punet" t-value="line.price_unit-(line.price_unit*line.discount/100)" />
                                     <span class="text-nowrap" t-esc="'%.2f'% punet"/>
                                 </td>
                                <td class="text-right" style="vertical-align:middle">
                                    <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99" id="section">
                                    <span t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99" id="note">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-right">
                                <td colspan="99" id="subtotal">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <div id="total" class="row justify-content-end">
                <div class="col-4">
                    <table class="table table-sm" style="page-break-inside: avoid;">
                        <tr class="border-black">
                            <td name="td_subtotal_label"><strong>Total HT<!--Subtotal--></strong></td>
                            <td class="text-right">
                                <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </td>
                        </tr>
                        <tr>
                            <td name="td_taxes_label" style="color:black">TVA</td>
                            <td class="text-right">
                                <span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </td>
                        </tr>
                        <tr class="border-black o_total" style="">
                            <td style="background-color:black" name="td_amount_total_label"><strong style="color:white">Total TTC</strong></td>
                            <td class="text-right" style="background-color:white">
                                <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <br/><br/>
            <table style="border:1px solid black; width:100%">
                <tr><td style="padding-left:6px">
                    <p style="font-style: italic;font-size:9px">
                        <strong style="text-decoration: underline;">N.B :</strong><br/>
                        <strong>*</strong> Nous vous remercions de rappeler notre numéro de commande sur le bon de livraison et la facture.<br/>
                        <strong style="text-decoration: underline;">Conditions générales d’achats</strong><br/>
                        <strong>*</strong> Les délais de livraison indiqués sur notre bon de commande sont à respecter pour éviter tout retard peut être généré lors de paiement.<br/>
                        <strong>*</strong> La réception définitive de la marchandise est subordonnée à leur approbation par nos services de contrôle.<br/>
                        <strong>*</strong> Veuillez adresser vos factures au siège de la société :  <span t-field="o.company_id.street"></span>
                            <span t-field="o.company_id.street2"> -&#032;</span><span t-field="o.company_id.city"> -&#032;</span><span t-field="o.company_id.state_id"> - </span>
                            <span t-field="o.company_id.zip"> -&#032;</span><span t-field="o.company_id.country_id">&#032;</span><br/>
                    </p>
                </td></tr>
            </table>
            <br/>
            <!--<p t-field="o.notes"/><br/>-->
            <div style="float:right"><strong>Service Achat</strong></div>


        </div>
             </div>
        </xpath>
    </template>
</odoo>
