<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_with_price">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <div class="article o_report_layout_boxed" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"><!--To ignore the default layout(remove header+footer)-->
                    <t t-call="ourcustom_impression.ourcustom_header_footerbl" />
                     <style>
                       #informations {
                            display: block;
                            }
                       .m-0{
                            display:inline;
                             }
                       strong,p{
                            color:black;
                            }
                        /*  Define the background color for all the EVEN background rows  */
                        .rows_color tr:nth-child(even){
                            background: #B1B7BF;
                        }
                         /*Border Cornerred*/
                        #content {
                              position:relative;
                              width:420px;
                              height:190px;
                              align-items: center;
                        }

                        #content:before,
                        #content:after,
                        #content>:last-child:before,
                        #content>:last-child:after {
                            position: absolute;
                            width: 60px;
                            height: 50px;
                            border-color: black;
                            border-style: solid;
                            content: ' ';
                        }

                        #content:before {
                            top: 10px;
                            left: 10px;
                            width:20%;
                            border-right:0px;
                            border-bottom:0px;
                            border-width: 1px 0px 0px 1px;
                        }

                        #content:after {
                            top: 10px;
                            right: 10px;
                            width:20%;
                            border-left:0px;
                            border-bottom:0px;
                            border-width: 1px 1px 0px 0px;
                        }

                        #content>:last-child:before {
                            bottom: 10px;
                            right: 10px;
                            width:20%;
                            border-left:0px;
                            border-top:0px;
                            border-width: 0px 1px 1px 0px;
                        }

                        #content>:last-child:after {
                            bottom: 10px;
                            left: 10px;
                            width:20%;
                            border-right:0px;
                            border-top:0px;
                            border-width: 0px 0px 1px 1px;
                        }

                   </style>
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>

                    <div class="ourpage">
                        <table style="width:100%;border:none" class="mod" >
                            <tr>
                                <td style="border:none">
                                    <h2>
                            <strong style="font-size:20px" >Bon de Livraison N°:</strong><strong><span style="font-size:20px" t-field="o.name"/></strong>
                                    </h2>
                        <div id="informations" class="row mt32 mb32">
                            <div t-if="o.state" class="col-auto" name="div_sched_date">
                                <strong>Date d'expédition:</strong>
                                <t t-if="o.state == 'done'">
                                    <p class="m-0" t-field="o.date_done" t-options='{"format": "dd/MM/yyyy"}'/>
                                </t>
                                <t t-if="o.state != 'done'">
                                    <p class="m-0" t-field="o.scheduled_date" t-options='{"format": "dd/MM/yyyy"}'/>
                               </t>
                            </div>
                            <div  class="col-auto" name="div_ref">
                                <strong>Notre Référence:</strong>
                                <p class="m-0" t-field="o.origin"/>
                            </div>
                            <div class="col-auto" name="reference_client">
                                <strong>Votre Commande:</strong>
                                <p class="m-0" t-field="o.sale_id.client_order_ref"/>
                            </div>



                        </div>
                                </td>
                                <td  style="width:50%;border:none">
                                   <div id="content" style="padding-left:20px;padding-right:20px">
                                                    <div class="mod1"><center><strong>Client N° : </strong><p class="m-0" t-field="o.sale_id.partner_id.ref"/></center></div>
                                                    <div class="mod2"><p class="m-0" t-field="o.sale_id.partner_id"/></div>
                                                    <div style="color:black">
                                                        <span t-field="o.sale_id.partner_id.street"></span>&#032;<span t-field="o.sale_id.partner_id.street2"></span>&#032;
                                                        <span t-field="o.sale_id.partner_id.city"></span>&#032;<span t-field="o.sale_id.partner_id.state_id"></span>&#032;
                                                        <span t-field="o.sale_id.partner_id.zip"></span>&#032;<span t-field="o.sale_id.partner_id.country_id"></span></div>
                                                    <div><strong>Tél :</strong><p class="m-0" t-field="o.sale_id.partner_id.phone"/></div>
                                                    <div><strong>Contact : </strong><p class="m-0" t-field="o.sale_id.ourcontact"/></div>
                                                    <div><strong>E-mail :</strong><p class="m-0" t-field="o.sale_id.partner_id.email"/></div>
                                                    <div><strong>ICE :</strong><p class="m-0" t-field="o.partner_id.vat"/></div>
                                   </div>
                                </td>
                            </tr>
                        </table>
                        <br/>

                        <!--********************Adresse************************-->
                        <table style="width:100%;border:1px solid black;color:black">
                            <tr>
                            <td colspan="2">
                                <div class="col-auto col-3 mw-100 mb-2" name="shipping_adresse">
                                    <strong>Lieu de livraision:</strong>
                                    <!--<p class="m-0" t-field="o.partner_id.contact_address"/>-->
                                   <p class="m-0">  <strong t-field="o.partner_id">&#032;</strong><strong>:</strong> &#032;
                                   <span t-field="o.partner_id.street"></span>&#032;<span t-field="o.partner_id.street2"></span>&#032;
                                       <span  t-field="o.partner_id.city"></span>&#032;<span t-field="o.partner_id.state_id"></span>&#032;
                                    <span  t-field="o.partner_id.zip"></span>&#032;<span  t-field="o.partner_id.country_id"></span></p>
                                </div>
                            </td>
                            </tr>
                            <tr>
                                <td style="width:50%;border:none;vertical-align:top">
                                    <div style="float:left">
                                        <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-8px"  name="user_contact">
                                            <strong>Votre Contact:</strong>
                                            <p class="m-0" t-field="o.user_id"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2"  style="margin-top:-10px" name="user_phone">
                                            <strong>Téléphone:</strong>
                                            <p class="m-0" t-field="o.user_id.phone"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px" name="user_email">
                                            <strong>E-mail:</strong>
                                            <p class="m-0" t-field="o.user_id.email"/>
                                        </div>
                                    </div>
                                </td>
                                <td style="width:50%;vertical-align:top">
                                     <div style="float:left;">
                                         <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-8px" name="payment_term">
                                             <strong>Conditions de paiement:</strong>
                                             <p class="m-0" t-field="o.sale_id.payment_term_id"/>
                                         </div>
                                        <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px" name="condition_livraison">
                                            <strong>Conditions de livraison:</strong>
                                            <p class="m-0" t-field="o.sale_id.incoterm"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px" name="transporteur">
                                            <strong>Transporteur:</strong>
                                            <p class="m-0" t-field="o.ourtransporteur"/>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table><br/>

                        <!--Table Principale -->
                        <table class="table table-sm rows_color" t-if="o.state!='done'" name="stock_move_table">
                            <thead>
                                <tr>
                                    <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_line_num" class="text-center">N°Ligne</th>
                                    <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" class="text-left" name="th_sm_product"><strong>Article</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_quantity"><strong>Quantité Commandée</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_quantity_done"><strong>Quantité Livrée</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_udm"><strong>Conditionnement</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_price_unit"><strong>Prix Unitaire</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_price_subtotal"><strong>Total HT</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines" t-value="o.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                                <tr t-foreach="lines" t-as="move">

                                    <td style="color:black;vertical-align:middle" name="td_line_num" class="text-center">
                                        <span t-field="move.sl_no" style="color:black"/>
                                    </td>
                                    <td>
                                        <t t-if="move.name">
                                            <span t-field="move.name" style="color:black"/>
                                        </t>
                                        <t t-else="">
                                            <span t-field="move.product_id" style="color:black"/>
                                        </t>
                                        <t t-set="serial_nos" t-value="', '.join(move.move_line_ids.filtered(lambda ml: ml.lot_id).mapped('lot_id.name'))"/>
                                        <t t-if="serial_nos">
                                            <br/><small style="color:#555;">N° Série : <span t-esc="serial_nos"/></small>
                                        </t>
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        <span t-field="move.product_uom_qty" style="color:black"/>
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        <span t-field="move.quantity_done" style="color:black"/>
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        <span t-field="move.product_uom" style="color:black"/>
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        <span t-field="move.sale_line_id.price_unit" style="color:black"/>
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        <span t-field="move.sale_line_id.price_subtotal" style="color:black"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm mt48 rows_color" t-if="o.move_line_ids and o.state=='done'" name="stock_move_line_table">
                            <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')"/>
                            <thead>
                                <tr>
                                    <th style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sml_product"><strong>Product</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_quantity"><strong>Quantité Livrée</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_udm"><strong>Conditionnement</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_price_unit"><strong>Prix Unitaire</strong></th>
                                    <th style="text-align:center;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_sm_price_subtotal"><strong>Total HT</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                            <!-- This part gets complicated with different use cases (additional use cases in extensions of this report):
                                    1. If serial numbers are used and set to print on delivery slip => print lines as is, otherwise group them by overlapping
                                        product + description + uom combinations
                                    2. If any packages are assigned => split products up by package (or non-package) and then apply use case 1 -->
                                <!-- If has destination packages => create sections of corresponding products -->
                                <t t-if="o.has_packages" name="has_packages">
                                    <t t-set="packages" t-value="o.move_line_ids.mapped('result_package_id')"/>
                                    <t t-foreach="packages" t-as="package">
                                        <t t-call="stock.stock_report_delivery_package_section_line"/>
                                        <t t-set="package_move_lines" t-value="o.move_line_ids.filtered(lambda l: l.result_package_id == package)"/>
                                        <!-- If printing lots/serial numbers => keep products in original lines -->
                                        <t t-if="has_serial_number">
                                            <tr t-foreach="package_move_lines" t-as="move_line">
                                                <t t-call="ourcustom_impression.ourstock_report_delivery_has_serial_move_line_pr"/>
                                            </tr>
                                        </t>
                                        <!-- If not printing lots/serial numbers => merge lines with same product+description+uom -->
                                        <t t-else="">
                                            <t t-set="aggregated_lines" t-value="package_move_lines._get_aggregated_product_quantities_pr()"/>
                                            <t t-call="ourcustom_impression.ourstock_report_delivery_aggregated_move_lines_pr"/>
                                        </t>
                                    </t>
                                    <!-- Make sure we do another section for package-less products if they exist -->
                                    <t t-set="move_lines" t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>
                                    <t t-if="move_lines" name="no_package_move_lines">
                                        <t t-call="stock.stock_report_delivery_no_package_section_line" name="no_package_section"/>
                                        <t t-if="has_serial_number">
                                            <tr t-foreach="move_lines" t-as="move_line">
                                                <t t-call="ourcustom_impression.ourstock_report_delivery_has_serial_move_line_pr"/>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <t t-set="aggregated_lines" t-value="move_lines._get_aggregated_product_quantities_pr()"/>
                                            <t t-if="aggregated_lines">
                                                <t t-call="ourcustom_impression.ourstock_report_delivery_aggregated_move_lines_pr"/>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                                <!-- No destination packages -->
                                <t t-else="">
                                    <!-- If printing lots/serial numbers => keep products in original lines -->
                                    <t t-if="has_serial_number">
                                        <tr t-foreach="o.move_line_ids" t-as="move_line">
                                            <t t-call="ourcustom_impression.ourstock_report_delivery_has_serial_move_line_pr"/>
                                        </tr>
                                    </t>
                                    <!-- If not printing lots/serial numbers => merge lines with same product -->
                                    <t t-else="" name="aggregated_move_lines">
                                        <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities_pr()"/>
                                            <t t-call="ourcustom_impression.ourstock_report_delivery_aggregated_move_lines_pr"/>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                        <!-- Relicat a annuler l'affichage (Demande par innovelec) -->
