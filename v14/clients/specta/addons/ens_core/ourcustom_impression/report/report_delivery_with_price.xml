                        <div class="clearfix" name="so_total_summary">
                            <div id="total" class="row" name="total">
                                <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto">
                                    <table class="table table-sm" style="page-break-inside: avoid;">
                                        <tr class="border-black o_subtotal" style="">
                                            <td name="td_amount_untaxed_label"><strong>Total HT<!--Subtotal--></strong></td>
                                            <td name="td_amount_untaxed" class="text-right">
                                                <span style="color:black" t-field="o.sale_id.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <t t-foreach="o.sale_id.amount_by_group" t-as="amount_by_group">
                                            <tr style="color:black">
                                                <t t-if="amount_by_group[5] == 1 and o.sale_id.amount_untaxed == amount_by_group[2]">
                                                    <td name="td_amount_by_group_label_3">
                                                        <span t-esc="amount_by_group[0]"/>
                                                        <span>&amp;nbsp;<span>on</span>&amp;nbsp;<t t-esc="amount_by_group[2]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.sale_id.pricelist_id.currency_id}"/></span>
                                                    </td>
                                                    <td name="td_amount_by_group_3" class="text-right o_price_total">
                                                        <span t-esc="amount_by_group[1]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.sale_id.pricelist_id.currency_id}"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td name="td_amount_by_group_label">
                                                        <span t-esc="amount_by_group[0]"/>
                                                    </td>
                                                    <td name="td_amount_by_group" class="text-right o_price_total">
                                                        <span t-esc="amount_by_group[1]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.sale_id.pricelist_id.currency_id}"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                        <tr class="border-black o_total">
                                            <td name="td_amount_total_label"><strong style="color:white">Total TTC</strong></td>
                                            <td name="td_amount_total" class="text-right">
                                                <span t-field="o.sale_id.amount_total" style="color:white"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div><br/>


                        <table style="border: 1px solid black;color:black;width:60%;margin-left:200px;page-break-inside: avoid;">
                            <tr style="color:black;"><td colspan="2"><center><strong>Visa</strong></center></td></tr>
                            <tr style="border: 1px solid black">
                                <td style="width:40%;color:black;"><center><strong>Service Livraison</strong></center></td>
                                <td style="width:40%;color:black;"><center><strong>Client</strong></center></td>
                            </tr>
                            <tr style="border:1px solid black">
                                <td style="width:40%;height:200px;color:black;"></td>
                                <td style="width:40%;height:200px;color:black;"></td>
                            </tr>
                        </table><br/><br/>
                        <div class='NB'>
                            <p style="font-style: italic;font-size:9px">
                                <strong style="text-decoration: underline;">N.B :</strong><br/>
                                <strong>*</strong> Nous vous remercions pour votre commande et nous vous informons que toute réception sous réserve de contrôle sera considéré comme définitive après une semaine.<br/>
                                <strong>*</strong> Toute réclamation concernant cette livraison doit être adressé au service livraison.<br/>
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
