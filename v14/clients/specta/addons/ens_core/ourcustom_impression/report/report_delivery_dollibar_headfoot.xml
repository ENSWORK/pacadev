<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_dollibar_headfoot">
        <t t-set="company" t-value="user.company_id" />
        <div class="header" >
            <div>
                <style>
                   #informations {
                        display: block;
                        }
                   .m-0{
                        display:inline;
                         }
                   strong,p,span{
                        color:black;
                        }
               </style>
                <div class="row mb8">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-width: 250px; max-height: 100px;"/>
                    </div>
                     <div class="col-6 text-right mb4">
                        <p>
                            <t t-if="o.picking_type_code == 'incoming'">
                                <strong style="font-size:17px;color:#0D0446">Bon de Réception N°:</strong><strong><span t-field="o.name" style="font-size:17px;color:#0D0446"/></strong>
                            </t>
                            <t t-if="o.picking_type_code == 'internal'">
                                <strong style="font-size:17px;color:#0D0446">Bon de Sortie N°:</strong><strong><span t-field="o.name" style="font-size:17px;color:#0D0446"/></strong>
                            </t>
                            <t t-if="o.picking_type_code == 'outgoing'">
                                <strong style="font-size:17px;color:#0D0446">Bon de Livraison N°:</strong><strong><span t-field="o.name" style="font-size:17px;color:#0D0446"/></strong>
                            </t>
                        </p>
                         <div  style="margin-top:-10px; font-size:13px" t-if="o.state" name="div_sched_date">
                            <strong style="color:#0D0446">Date d'expédition:</strong>
                            <t t-if="o.state == 'done'">
                                <p class="m-0" t-field="o.date_done" t-options='{"format": "dd/MM/yyyy"}' style="color:#0D0446"/>
                            </t>
                            <t t-if="o.state != 'done'">
                                <p class="m-0" t-field="o.scheduled_date" t-options='{"format": "dd/MM/yyyy"}' style="color:#0D0446"/>
                           </t>
                        </div>
                        <div name="reference_client"  style="font-size:13px">
                            <strong style="color:#0D0446">Votre Commande:</strong>
                            <p class="m-0" t-field="o.sale_id.client_order_ref" style="color:#0D0446"/>
                        </div>
                        <div name="div_origin"  style="font-size:13px">
                            <strong style="color:#0D0446">Date Commande:</strong>
                            <p class="m-0" t-field="o.sale_id.date_order" t-options='{"format": "dd/MM/yyyy"}' style="color:#0D0446"/>
                        </div>
                         <div style="font-size:13px">
                             <strong style="color:#0D0446">Client N° : </strong><p class="m-0" t-field="o.sale_id.partner_id.ref" style="color:#0D0446"/>
                         </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            <style>
            hr.newhr{
                border: 1px solid #ABABAB;
                margin-top:0px;
                padding-top:0px;}
            p{
                font-size:10px;}
            </style>
                    <hr class="newhr" />
            <center><strong><p style="font-size:11px;margin-top:-10px;" t-field="company.report_footer"></p></strong></center>
             <div style="text-align:right;margin-top:-19px;color:black;font-size:10px" t-if="report_type == 'pdf'">
                 <span class="page"/> / <span class="topage"/>
             </div>

        </div>
    </template>
</odoo>