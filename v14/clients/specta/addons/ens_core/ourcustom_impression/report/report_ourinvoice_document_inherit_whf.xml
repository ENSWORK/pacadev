<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- <template id="report_ourinvoice_document_inherit_whf" inherit_id="ourcustom_impression.report_ourinvoice_document_inherit">
        <xpath expr="//t[@t-call='ourcustom_impression.ourcustom_header_footer']" position="replace">
        </xpath>

    </template>-->
<template  id="report_ourinvoice_document_inherit_whf" >
 <t t-call="web.html_container">
            <div class="article o_report_layout_boxed" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"><!--To ignore the default layout(remove header+footer)-->
               <!-- <t t-call="Import.ourcustom_header_footer" />-->

                <style>
                   #informations {
                        display: block;
                        }
                   .m-0{
                        display:inline;
                         }
                   strong,p,span{
                        color:black;
                        }
                    /*  Define the background color for all the EVEN background rows  */
	                .rows_color tr:nth-child(even){
		                background: #B1B7BF;
                    }
                    th.low{
                      text-transform: lowercase,capitalize;
                    }
                div.line{
                  line-height: 1;
                }
                    /*Border Cornerred*/
                    #content {
                          position:relative;
                          width:420px;
                          height:190px;
                          align-items: center;
                    }

                    #content:before,
                    #content:after,
                    #content>:last-child:before,
                    #content>:last-child:after {
                        position: absolute;
                        width: 60px;
                        height: 50px;
                        border-color: black;
                        border-style: solid;
                        content: ' ';
                    }

                    #content:before {
                        top: 10px;
                        left: 10px;
                        width:20%;
                        border-right:0px;
                        border-bottom:0px;
                        border-width: 1px 0px 0px 1px;
                    }

                    #content:after {
                        top: 10px;
                        right: 10px;
                        width:20%;
                        border-left:0px;
                        border-bottom:0px;
                        border-width: 1px 1px 0px 0px;
                    }

                    #content>:last-child:before {
                        bottom: 10px;
                        right: 10px;
                        width:20%;
                        border-left:0px;
                        border-top:0px;
                        border-width: 0px 1px 1px 0px;
                    }

                    #content>:last-child:after {
                        bottom: 10px;
                        left: 10px;
                        width:20%;
                        border-right:0px;
                        border-top:0px;
                        border-width: 0px 0px 1px 1px;
                    }

               </style>

                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>

                <div class="ourpage">
                    <div class="plusinfo" style="color:black;">
                    <center><strong><span style="margin-left:5px;color:#081669;font-size:15px">Pour plus d’information sur nos produits, visiter notre site web : <span style="color:#081669" t-field="o.company_id.website"></span></span></strong></center>
                    </div><br/>
                    <table class="mod" style="width:100%;border:0px" >
                        <tr>
                            <td style="width:50%;border:0px;">
                                <h2>
                        <strong><span style="font-size:20px" t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Facture</span></strong>
                        <strong><span style="font-size:20px" t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Facture en brouillon</span></strong>
                        <strong><span style="font-size:20x" t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Facture annulée</span></strong>
                        <strong><span style="font-size:20x" t-if="o.move_type == 'out_refund'">Avoir</span></strong>
                        <strong><span style="font-size:20px" t-if="o.move_type == 'in_refund'">Avoir de fournisseur</span></strong>
                        <strong><span style="font-size:20px" t-if="o.move_type == 'in_invoice'">Facture fournisseur</span></strong>
                        <strong><span style="font-size:20px" t-if="o.name != '/'" t-field="o.name"/></strong>
                                </h2>

                    <div id="informations" class="row mt32 mb32">
                        <div class="col-auto col-3 mw-100 mb-2"  style="margin-top:-10px" name="invoice_date">
                            <strong>Invoice Date:</strong>
                            <p class="m-0" t-field="o.invoice_date"/>
                        </div>
                        <div class="col-auto col-3 mw-100 mb-2"  style="margin-top:-10px"  name="reference_client">
                            <strong>Votre Commande:</strong>
                            <p class="m-0" t-field="o.ref"/>
                        </div>
                        <div t-if="o.move_type == 'out_invoice' and o.show_hide_bl_num" class="col-auto col-3 mw-100 mb-2"  style="margin-top:-10px" name="bl_num">
                            <strong>BL N°:</strong>
                            <p class="m-0">
                                <t t-if="len(o.picking_ids) != 0">
                                     <t t-foreach="o.picking_ids" t-as="picking">
                                        <span t-esc="picking.name"/>&#160;
                                    </t>
                                </t>
                               <t t-else=""> <!--it's just because of old invoices, we will show narration field content-->
                                   <p class="m-0" t-field="o.narration"/>
                               </t>
                            </p>
                        </div>
                    </div>
                            </td>
                            <td  style="width:50%;border:none">
                                <div id="content" style="padding-left:20px;padding-right:20px">
                                                <div class="mod1" t-if="o.move_type != 'in_refund' and o.move_type != 'in_invoice'"><center><strong>Client N° : </strong><p class="m-0" t-field="o.partner_id.ref"/></center></div>
                                                <div class="mod2" t-if="o.move_type == 'in_refund' or o.move_type == 'in_invoice'"><center><strong>Fournisseur N° : </strong><p class="m-0" t-field="o.partner_id.ref"/></center></div>
                                                <div class="mod3"><p class="m-0" t-field="o.partner_id"/></div>
                                                <div><!--<p class="m-0" t-field="o.partner_id.contact_address"/>-->
                                                    <span  t-field="o.partner_id.street"></span>&#032;<span t-field="o.partner_id.street2"></span>&#032;
                                                    <span  t-field="o.partner_id.city"></span>&#032;<span t-field="o.partner_id.state_id"> </span>&#032;
                                                    <span  t-field="o.partner_id.zip"></span>&#032;<span  t-field="o.partner_id.country_id"></span></div>
                                                <div><strong>Tél :</strong><p class="m-0" t-field="o.partner_id.phone"/></div>
                                                <div><strong>Contact : </strong></div>
                                                <div><strong>E-mail :</strong><p class="m-0" t-field="o.partner_id.email"/></div>
                                                <div><strong>ICE :</strong><p class="m-0" t-field="o.partner_id.vat"/></div>
                                </div>
                                <!--<t t-call="web.address_layout"/>
                                <t t-raw="0"/>-->
                            </td>
                        </tr>
                    </table><br/>

                    <!--********************Adresse************************-->
                    <table style="width:100%;border:1px solid black;color:black">
                        <tr>
                            <td colspan="2">
                                <div class="col-auto col-3 mw-100 mb-2"  name="shipping_adresse">
                                    <strong>Adresse de livraision:</strong>
                                    <p class="m-0"> <strong t-field="o.partner_shipping_id">&#032;</strong>&#032;
                                        <span t-field="o.partner_shipping_id.street"></span>&#032;<span t-field="o.partner_shipping_id.street2"></span>&#032;
                                        <span  t-field="o.partner_shipping_id.city"></span>&#032;<span t-field="o.partner_shipping_id.state_id"></span>&#032;
                                        <span  t-field="o.partner_shipping_id.zip"></span>&#032;<span t-field="o.partner_shipping_id.country_id"></span></p>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:50%;border:none;vertical-align:top">
                                <div style="float:left;">
                                    <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-8px"   name="user_contact">
                                        <strong>Votre Contact:</strong>
                                        <p class="m-0" t-field="o.invoice_user_id"/>
                                    </div>
                                    <div class="col-auto col-3 mw-100 mb-2"  style="margin-top:-10px"  name="user_phone">
                                        <strong>Téléphone:</strong>
                                        <p class="m-0" t-field="o.invoice_user_id.phone"/>
                                    </div>
                                    <div class="col-auto col-3 mw-100 mb-2"  style="margin-top:-10px" name="user_email">
                                        <strong>E-mail:</strong>
                                        <p class="m-0" t-field="o.invoice_user_id.email"/>
                                    </div>
                                </div>
                            </td>
                            <td style="width:50%;vertical-align:top">
                                <div style="float:left;">
                                    <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-8px" name="condition_livraison">
                                        <strong>Conditions de livraison:</strong>
                                        <p class="m-0" t-field="o.invoice_incoterm_id"/>
                                    </div>
                                     <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px"  name="payment_term">
                                         <strong>Conditions de paiement:</strong>
                                         <p class="m-0" t-field="o.invoice_payment_term_id"/>
                                     </div>
                                    <div class="col-auto col-3 mw-100 mb-2" style="margin-top:-10px" name="date_due">
                                        <strong>Date d'échéance:</strong>
                                        <p class="m-0" t-field="o.invoice_date_due"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table><br/>

                        <!--TABLE PRINCIPALE-->

                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>

                    <table class="table table-sm o_main_table rows_color" name="invoice_line_table">
                        <thead>
                            <tr>
                                <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_line_num" class="text-center">N°Ligne</th>
                                <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_description" class="text-left"><span>Référence / Description d'article</span></th>
                                <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_quantity" class="text-center"><span>Quantity</span></th>
                                <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th.udm" class="text-left"><span>UdM</span></th>
                                <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>P.U Brut en <span t-field="o.currency_id.symbol"></span></span></th>
                                <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span>Remise</span>
                                </th>
                                <!--<th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>-->
                                <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_priceunit_net" t-if="display_discount"  t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>P.U Net en <span t-field="o.currency_id.symbol"></span></span></th>
                                <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;" name="th_subtotal" class="text-right">
                                    <span groups="account.group_show_line_subtotals_tax_excluded">Toatl HT en <span t-field="o.currency_id.symbol"></span></span>
                                    <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>


                            <t t-foreach="lines" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="not line.display_type" name="account_invoice_line_accountable">

                                       <td style="color:black;vertical-align:middle" name="td_line_num" class="text-center"><span t-field="line.sl_no"/></td>
                                        <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>
                                        <td class="text-center" style="vertical-align:middle">
                                            <span style="vertical-align: middle;" t-field="line.quantity"/>
                                            <!--<span t-field="line.product_uom_id" groups="uom.group_uom"/>-->
                                        </td>
                                        <td class="text-left" style="vertical-align:middle">
                                            <span style="vertical-align: middle;" t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="vertical-align:middle">
                                            <span style="vertical-align: middle;" class="text-nowrap" t-field="line.price_unit"/>
                                        </td>
                                        <td style="color:black;vertical-align:middle" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                             <!--<span style="vertical-align: middle;" class="text-nowrap" t-field="line.discount"/>%-->
                                             <span style="vertical-align: middle;" class="text-nowrap" t-esc="str('%.2f'% line.discount).replace('.',',')"/>%
                                        </td>
                                         <td style="color:black;vertical-align:middle" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                             <t t-if="line.price_unit != 0" t-set="punet" t-value="line.price_unit-(line.price_unit*line.discount/100)" />
                                            <span style="vertical-align: middle;" class="text-nowrap" t-esc="'%.2f'% punet"/>
                                        </td>
                                        <!--<td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>
                                        </td>-->
                                        <td class="text-right o_price_total" style="vertical-align:middle">
                                            <span style="vertical-align: middle;" class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <span style="vertical-align: middle;" class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <!--<t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>-->
                                </tr>

                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-right">
                                        <td colspan="99">
                                            <strong class="mr16">Subtotal</strong>
                                            <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>

                            </t>


                        </tbody>
                    </table>

                    <table class="delete_devise_et_date_for_exceltech" style="width:100%;page-break-inside: avoid;">
                        <tr>
                                    <td style="border:1px solid black;width:65%;padding-left:7px;padding-right:7px;vertical-align:middle" >
                                        <div class="amount2word"></div>
                                    </td>
                                    <td style="border:1px solid black;padding:0px;width:35%">
                                       <!-- <div class="clearfix">
                        <div id="total" class="row">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">
                                <table class="table table-sm" style="page-break-inside: avoid;">-->
                                        <table style="border:none;width:100%;page-break-inside: avoid;">
                                    <tr class="o_subtotal" style="">
                                        <td style="padding-left:5px"><strong>Total HT <!--Subtotal--></strong></td>
                                        <td class="text-right" style="padding-right:5px">
                                            <span t-field="o.amount_untaxed"/>
                                        </td>
                                    </tr>
                                    <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                        <tr class="border-black " style="">
                                            <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">
                                                <td style="padding-left:5px"><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>
                                                <td class="text-right o_price_total" style="padding-right:5px">
                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td style="padding-right:5px">
                                                    <span t-esc="amount_by_group[0]"/>
                                                    <span class="text-nowrap"> sur
                                                        <t t-esc="amount_by_group[4]"/>
                                                    </span>
                                                </td>
                                                <td class="text-right o_price_total" style="padding-right:5px">
                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                    <tr class="border-black o_total" style="">
                                        <td style="background-color:black;padding-left:5px"><strong style="color:white">Total TTC </strong></td>
                                        <td class="text-right" style="padding-right:5px">
                                            <span class="text-nowrap" t-field="o.amount_total"/>
                                        </td>
                                    </tr>
                                    <tr class="border-black o_subtotal" style="">
                                        <td style="padding-left:5px"><strong>Devise</strong></td>
                                        <td class="text-right" style="padding-right:5px">
                                            <span class="text-nowrap" t-field="o.currency_id"/>
                                        </td>
                                    </tr>
                                    <tr  class="border-black mod">
                                        <td style="padding-left:5px"><strong>Date d'échéance</strong></td>
                                        <td class="text-right" style="padding-right:5px">
                                            <span class="text-nowrap" t-field="o.invoice_date_due"/>
                                        </td>
                                    </tr>
                                        </table>
                             <!--</table>
                            </div>
                        </div>
                 </div>-->
                                    </td>
                                </tr>
                    </table>

                    <br/><br/>
                    <div class="line NB">
                        <p style="font-style: italic;font-size:9px">
                            <strong style="text-decoration: underline;">N.B :</strong><br/>
                            <strong>*</strong> Le produit vendu reste à notre propriété jusqu’au paiement effectif de la totalité du prix en principal et accessoires<br/>
                            <strong>*</strong> Nos opérations commerciales sont soumises à nos conditions générales de vente consultables sur notre site <span t-field="o.company_id.website"></span><br/>
                            <strong>*</strong> Veuillez adresser votre règlement à notre siège : <span t-field="o.company_id.street"></span>
                            <span t-field="o.company_id.street2"> - </span><span t-field="o.company_id.city"> - </span><span t-field="o.company_id.state_id"> - </span>
                            <span t-field="o.company_id.zip"> - </span><span t-field="o.company_id.country_id"> </span><br/>
                            <strong>*</strong> Toutes les contestations relatives au paiement de nos factures seront de la compétence exclusive des tribunaux de commerce de Casablanca.
                        </p>
                    </div>

                </div>

            </div>
            </t>
</template>
</odoo>
