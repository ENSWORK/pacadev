<?xml version="1.0"?>
<odoo>
    <data>
        <template id="ourstock_report_delivery_aggregated_move_lines">
        <tr t-foreach="aggregated_lines" t-as="line">

            <td style="vertical-align:middle;width:4%" class="text-center">
                <span t-esc="aggregated_lines[line]['sl_no']"/>
            </td>
            <td style="vertical-align:middle;width:11%">
                <span t-if="aggregated_lines[line]['default_code']" t-esc="aggregated_lines[line]['default_code']"/>
            </td>
            <td style="vertical-align:middle">
                <span t-esc="aggregated_lines[line]['ourname']" t-options="{'widget': 'text'}"/>
            </td>

            <td class="text-center" style="text-align:center; vertical-align:middle;width:11%" name="move_line_aggregated_qty_done">
              <!--<span t-esc="aggregated_lines[line]['qty_done']"/>-->
                <!--<span t-esc="str('%.2f'% aggregated_lines[line]['qty_done']).replace('.', ',')"/>-->
                <span t-esc="str('{0:,.2f}'.format(float(aggregated_lines[line]['qty_done'])).replace(',', ' ')).replace('.', ',')"/>

            </td>
            <td class="text-center" style="text-align:center; vertical-align:middle;width:7%" name="move_line_aggregated_uom">
                <span t-esc="aggregated_lines[line]['product_uom']"/>
            </td>
        </tr>
        </template>
    </data>
</odoo>

