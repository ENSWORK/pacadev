<?xml version="1.0"?>
<odoo>
    <data>
        <template id="ourstock_report_delivery_has_serial_move_line_pr">
            <td style="vertical-align:middle;width:4%" class="text-center">
                <span t-field="move_linesl_no" style="color:black"/>
            </td>
            <td style="vertical-align:middle;width:11%">
                <span t-if="move_line.default_code" t-esc="str(move_line.default_code).replace('-', '⁻')" style="color:black"/>
            </td>
            <td style="vertical-align:middle">
                 <!-- Impression de La désignation au lieu du nom de l'article -->
                <t t-if="move_line.ourname">
                    <span t-field="move_line.ourname" style="color:black" t-options="{'widget': 'text'}"/>
                </t>
                <t t-else="">
                    <span t-field="move_line.product_id" style="color:black"/>
                </t>

            </td>
            <t t-if="has_serial_number"  name="move_line_lot">
                <td style="text-align:center;vertical-align:middle"><span t-field="move_line.lot_id.name" style="color:black"/></td>
            </t>

            <td class="text-center" style="text-align:center;vertical-align:middle;width:7%" name="move_line_lot_qty_done">
                <span t-field="move_line.qty_done" style="color:black"/>
            </td>
            <td class="text-center" style="text-align:center;vertical-align:middle;width:6%" name="move_line_lot_uom">
                <span t-field="move_line.product_uom_id" style="color:black"/>
            </td>
            <td class="text-center" style="text-align:center;vertical-align:middle;width:11%" name="move_line_lot_price_unit">
                <!--<span t-field="move_line.move_id.sale_line_id.price_unit" style="color:black"/>-->
                <span t-field="move_line.move_id.price_unit" style="color:black"/>
            </td>
            <td class="text-center" style="text-align:center;vertical-align:middle;width:11%" name="move_line_lot_price_subtotal">
                <!--<span t-field="move_line.move_id.sale_line_id.price_subtotal" style="color:black"/>-->
                <span t-field="move_line.move_id.price_subtotal" style="color:black"/>
            </td>
    </template>
    </data>
</odoo>