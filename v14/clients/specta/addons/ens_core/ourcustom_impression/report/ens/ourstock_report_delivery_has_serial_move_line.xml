<?xml version="1.0"?>
<odoo>
    <data>
        <template id="ourstock_report_delivery_has_serial_move_line">
            <td style="vertical-align:middle;width:4%" class="text-center">
                <span t-field="move_line.sl_no"/>
            </td>

            <td style="vertical-align:middle;width:11%">
                <span t-if="move_line.product_id.default_code" t-esc="str(move_line.product_id.default_code).replace('-', '⁻')"/>
            </td>

            <td style="vertical-align:middle">
                 <t t-if="move_line.ourname">
                    <span t-field="move_line.ourname" t-options="{'widget': 'text'}"/>
                </t>
                <t t-else="">
                    <span t-field="move_line.product_id"/>
                </t>
            </td>
            <t t-if="has_serial_number"  name="move_line_lot">
                <td style="text-align:center;vertical-align:middle"><span t-field="move_line.lot_id.name"/></td>
            </t>

            <td class="text-center" style="text-align:center;vertical-align:middle;width:11%" name="move_line_lot_qty_done">
                <span t-field="move_line.qty_done"/>
            </td>
            <td class="text-center" style="text-align:center;vertical-align:middle;width:7%" name="move_line_lot_uom">
                <span t-field="move_line.product_uom_id"/>
            </td>
    </template>
    </data>
</odoo>

