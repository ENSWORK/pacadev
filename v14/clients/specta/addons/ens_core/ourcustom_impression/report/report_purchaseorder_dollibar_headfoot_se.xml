<?xml version="1.0" encoding="utf-8"?>
<odoo><!--Remove logo + footer, keep other info-->
    <template id="report_purchaseorder_dollibar_headfoot_se">
        <t t-set="company" t-value="user.company_id" />
        <div class="header" >
            <div>
                <style>
                   #informations {
                        display: block;
                        }
                   .m-0{
                        display:inline;
                         }
                   strong,p,span{
                        color:black;
                        }
               </style>
                <div class="row mb8">
                    <div class="col-6">
                        <!--<img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-width: 250px; max-height: 100px;"/>-->
                    </div>
                     <div class="col-6 text-right mb4">
                        <p>
                            <strong style="font-size:17px;color:#0D0446" t-if="o.state == 'draft'">Demande de prix N° <span style="font-size:17px;color:#0D0446" t-field="o.name"/></strong>
                            <strong style="font-size:17px;color:#0D0446" t-if="o.state in ['sent', 'to approve']">Bon de Commande N° <span style="font-size:17px;color:#0D0446" t-field="o.name"/></strong>
                            <strong style="font-size:17px;color:#0D0446" t-if="o.state in ['purchase', 'done']">Bon de Commande N° <span style="font-size:17px;color:#0D0446" t-field="o.name"/></strong>
                            <strong style="font-size:17px;color:#0D0446" t-if="o.state == 'cancel'">Bon de Commande Annulée N° <span style="font-size:17px;color:#0D0446" t-field="o.name"/></strong>
                        </p>
                         <div style="margin-top:-10px; font-size:13px" name="order_date">
                            <strong style="color:#0D0446">Date de Commande:</strong>
                            <p style="color:#0D0446" class="m-0"  t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                        </div>
                         <div style="font-size:13px">
                             <strong style="color:#0D0446">Fournisseur N° : </strong><p class="m-0" t-field="o.partner_id.ref" style="color:#0D0446"/>
                         </div>
                         <div t-if="o.partner_ref" style="font-size:13px;">
                            <strong style="color:#0D0446">Votre Offre:</strong>
                            <p t-field="o.partner_ref" class="m-0" style="color:#0D0446"/>
                         </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="footer">

        </div>
    </template>
</odoo>