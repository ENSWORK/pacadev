<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_dollibar">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <div class="article o_report_layout_boxed" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"><!--To ignore the default layout(remove header+footer)-->
                     <t t-call="ourcustom_impression.report_invoice_dollibar_headfoot" />
                    <style>
                       #informations {
                            display: block;
                            }
                       .m-0{
                            display:inline;
                             }
                       strong,p,span{
                            color:black;
                            }
                        /*  Define the background color for all the EVEN background rows  */
                        .rows_color tr:nth-child(even){
                            background: #EEEDED;
                        }
                        th.low{
                          text-transform: lowercase,capitalize;
                        }
                     div.line{
                      line-height: 1;
                    }

                        #content {
                               border:1px solid #ABABAB;
                        }
                   </style>



                    <div class="ourpage">
                        <br/>
                        <table style="width:100%;border:0px;margin-top:0px" class="mod" >
                            <tr>
                                <td style="width:45%;border:0px;color:black">Émetteur</td>
                                <td style="width:5%;border:0px;"> </td>
                                <td style="width:50%;border:none;color:black">Adressé à</td>
                            </tr>
                            <tr>
                                <td style="width:45%;border:0px;background-color:#EEEDED;">
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong><p class="m-0" t-field="o.company_id.name" style="color:#0D0446"/></strong><br/>
                                            <p class="m-0" t-field="o.company_id.street" style="color:#0D0446"/>
                                            <p class="m-0" t-field="o.company_id.street2" style="color:#0D0446"/>
                                            <p class="m-0" t-field="o.company_id.city" style="color:#0D0446"/>
                                            <p class="m-0" t-field="o.company_id.state_id" style="color:#0D0446"/>
                                            <p class="m-0" t-field="o.company_id.country_id" style="color:#0D0446"/>
                                            <br/>
                                            <strong style="color:#0D0446">Tél: </strong>
                                            <p class="m-0" t-field="o.company_id.phone" style="color:#0D0446"/><br/>
                                            <strong style="color:#0D0446">Email: </strong>
                                            <p class="m-0" t-field="o.company_id.email" style="color:#0D0446"/><br/>
                                            <strong style="color:#0D0446">Web: </strong>
                                            <p class="m-0" t-field="o.company_id.website" style="color:#0D0446"/><br/>

                                        </div>
                                </td>
                                <td style="width:5%;border:0px;"> </td>
                                <td style="width:50%;border:none;">
                                    <div id="content" style="padding-left:15px;padding-right:20px;padding-bottom:6px;min-height:160px">
                                                <p style="color:black;">
                                                    <div class="mod3"><strong><p class="m-0" t-field="o.partner_id"/></strong></div>
                                                    <div>
                                                        <span  t-field="o.partner_id.street"></span>&#032;<span t-field="o.partner_id.street2"></span>&#032;
                                                        <span  t-field="o.partner_id.city"></span>&#032;<span t-field="o.partner_id.state_id"></span>&#032;
                                                        <span  t-field="o.partner_id.zip"></span>&#032;<span t-field="o.partner_id.country_id"></span><br/></div>
                                                    <div><strong>Tél :</strong>
                                                        <t t-if="o.partner_id.company_type == 'person'">
                                                            <p t-if="o.partner_id.phone_required" class="m-0" t-esc="str(o.partner_id.phone_required).replace('.',' ')"/>
                                                        </t>
                                                        <t t-else="">
                                                            <p class="m-0" t-field="o.partner_id.phone"/>
                                                        </t>
                                                    </div>
                                                    <div><strong>E-mail :</strong><p class="m-0" t-field="o.partner_id.email"/></div>
                                                    <div><strong>ICE :</strong><p class="m-0" t-field="o.partner_id.vat"/></div>
                                                </p>
                                    </div>

                                </td>
                            </tr>
                        </table><br/>

                            <!--TABLE PRINCIPALE-->

                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>

                        <table class="table table-sm o_main_table" name="invoice_line_table" style="height:135mm;border-color:#ABABAB">
                            <thead style="border-color:#ABABAB">
                                <tr style="border-color:#ABABAB">
                                    <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:4%" name="th_line_num" class="text-center">N°</th>
                                    <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:11%" name="th_ref" class="text-left"><span>Référence</span></th>
                                    <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB" name="th_description" class="text-left"><span>Désignation</span></th>
                                    <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:9%" name="th_quantity" class="text-center"><span>Qté</span></th>
                                    <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:13%" name="th_priceunit" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>P.U HT</span></th>
                                    <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:7%" name="th_discount" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span>Remise</span>
                                    </th>
                                    <th style="background-color:white;vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:13%" name="th_subtotal" class="text-center">
                                        <span groups="account.group_show_line_subtotals_tax_excluded">Total HT</span>
                                        <span groups="account.group_show_line_subtotals_tax_included">Total HT</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody" style="border-color:#ABABAB">
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>


                                <t t-foreach="lines" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''" style="height:8mm">
                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">
                                            <td style="color:black;border-color:#ABABAB;vertical-align:middle;width:4%;border-bottom:1px dotted #ABABAB" name="td_line_num" class="text-center"><span t-field="line.sl_no"/></td>
                                            <td style="border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:11%" name="td_ref" class="text-left"><span t-if="line.product_id.default_code" t-esc="str(line.product_id.default_code).replace('-', '⁻')"/></td>
                                            <td style="border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB" name="account_invoice_line_name">
                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                <t t-set="serial_nos" t-value="', '.join(line.sale_line_ids.move_ids.filtered(lambda m: m.state == 'done').move_line_ids.filtered(lambda ml: ml.lot_id).mapped('lot_id.name'))"/>
                                                <t t-if="serial_nos">
                                                    <br/><small style="color:#555;">N° Série : <span t-esc="serial_nos"/></small>
                                                </t>
                                            </td>
                                            <td style="border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:9%" class="text-center">
                                                <span t-field="line.quantity"/>
                                            </td>
                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:13%">
                                                <span  class="text-nowrap" t-field="line.price_unit"/>
                                            </td>
                                            <td style="border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:7%;color:black" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <!-- <span class="text-nowrap" t-esc="str('%.2f'% line.discount).replace('.', ',')"/>%  -->
                                                <span class="text-nowrap" t-esc="str('{0:,.2f}'.format(float(line.discount)).replace(',', ' ')).replace('.', ',')"/>%
                                            </td>
                                            <td class="text-right" style="border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:13%">
                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                                <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                            </td>
                                        </t>
                                        <t t-if="line.display_type == 'line_section'">
                                            <td colspan="99" style="background-color:white;border-color:#ABABAB;">
                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-if="line.display_type == 'line_note'">
                                            <td colspan="99" style="border-color:#ABABAB;">
                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                        <tr class="is-subtotal text-right" style="border-color:#ABABAB;height:8mm">
                                            <td colspan="99" style="border-color:#ABABAB;background-color:white">
                                                <strong class="mr16">Subtotal</strong>
                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>

                                </t>
                                <tr style="background-color:white !important">
                                    <td style="border-color:#ABABAB;"> </td>
                                    <td style="border-color:#ABABAB;"> </td>
                                    <td style="border-color:#ABABAB;"> </td>
                                    <td style="border-color:#ABABAB;"> </td>
                                    <td style="border-color:#ABABAB;" t-if="display_discount"> </td>
                                    <td style="border-color:#ABABAB;"> </td>
                                </tr>


                            </tbody>
                        </table>

                        <table  style="width:100%;page-break-inside: avoid;border:none;margin-top:-12px" name="table_cdp">
                            <tr>
                                <td style="width:55%;padding-right:7px;border:none">
                                    <div class="amount2word"></div>
                                   <div class="col-auto col-3 mw-100 mb-2" style="font-size:13px;margin-left:-10px" name="cd_paiement">
                                       <strong>Conditions de paiement  : </strong>
                                       <p class="m-0" t-field="o.invoice_payment_term_id"/>
                                   </div>

                                    <div class="col-auto col-3 mw-100 mb-2" style="font-size:13px;margin-left:-10px">
                                        <strong>Règlement TTC par chèque à l'ordre de <p class="m-0" t-field="o.company_id.name"/> envoyé à :</strong><br/>
                                        <p class="m-0" t-field="o.company_id.street"/>
                                        <p class="m-0" t-field="o.company_id.street2"/>
                                        <p class="m-0" t-field="o.company_id.city"/>
                                        <p class="m-0" t-field="o.company_id.state_id"/>
                                        <p class="m-0" t-field="o.company_id.country_id"/>
                                    </div>

                                    <div t-if="o.narration" class="col-auto col-3 mw-100 mb-2" style="font-size:13px;margin-left:-10px" name="note">
                                        <strong>Note  : </strong>
                                        <p class="m-0" t-field="o.narration"/>
                                    </div>

                                </td>
                                <td style="padding:0px;width:45%;border:none">
                                    <table style="border:none;width:100%;page-break-inside: avoid;">
                                        <tr class="o_subtotal" style="border:none">
                                            <td style="border:none;font-size:13px"><strong>Total HT </strong></td>
                                            <td class="text-right" style="padding-right:5px;border:none;font-size:13px">
                                                <span t-field="o.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                            <tr>
                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">
                                                    <td style="border:none;background-color:#FAF9F9;font-size:13px"><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>
                                                    <td class="text-right o_price_total" style="padding-right:5px;border:none;background-color:#FAF9F9;font-size:13px">
                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td style="padding-right:5px;border:none;font-size:13px">
                                                        <span t-esc="amount_by_group[0]"/>
                                                        <!--<span class="text-nowrap"> sur
                                                            <t t-esc="amount_by_group[4]"/>
                                                        </span>-->
                                                    </td>
                                                    <td class="text-right o_price_total" style="padding-right:5px;border:none;background-color:white;font-size:13px">
                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                        <tr class="o_total">
                                            <td style="background-color:#EEEDED;border:none;font-size:13px"><strong>Total TTC </strong></td>
                                            <td class="text-right" style="padding-right:5px;border:none;background-color:#EEEDED;font-size:13px">
                                                <span class="text-nowrap" t-field="o.amount_total"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>


                    </div>
                </div>

                </t>
             </t>

    </template>
</odoo>