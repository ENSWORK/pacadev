<?xml version="1.0"?>
<odoo>
    <data>
        <template id="ourstock_report_delivery_has_serial_move_line_pr">

        <td>
             <!-- Impression de La désignation au lieu du nom de l'article -->
            <t t-if="move_line.ourname">
                <span t-field="move_line.ourname" style="color:black"/>
            </t>
            <t t-else="">
                <span t-field="move_line.product_id" style="color:black"/>
            </t>


            <!--<span t-field="move_line.product_id" style="color:black"/>-->
            <!-- this is an annoying workaround for the multiple types of descriptions (often auto-filled) that we do not want to print -->
            <!-- this makes it so we can pre-filter the descriptions in inherited templates since we cannot extend the standard "if" condition -->
            <!-- let's agree that pre-filtered descriptions will be set to "" -->
            <!--<t t-if="not description and description != ''">
                <t t-set="description" t-value="move_line.move_id.description_picking"/>
            </t>
            <p t-if="description !='' and description != move_line.product_id.name">
                <span t-esc="description" style="color:black"/>
            </p>-->
            <t t-if="move_line.lot_id">
                <br/><small style="color:#555;">N° Série : <span t-field="move_line.lot_id.name"/></small>
            </t>
        </td>

        <td class="text-center" style="text-align:center;vertical-align:middle" name="move_line_lot_qty_done">
            <span t-field="move_line.qty_done" style="color:black"/>
        </td>
        <td class="text-center" style="text-align:center;vertical-align:middle" name="move_line_lot_uom">
            <span t-field="move_line.product_uom_id" style="color:black"/>
        </td>
        <td class="text-center" style="text-align:center;vertical-align:middle" name="move_line_lot_price_unit">
            <span t-field="move_line.move_id.sale_line_id.price_unit" style="color:black"/>
        </td>
        <td class="text-center" style="text-align:center;vertical-align:middle" name="move_line_lot_price_subtotal">
            <span t-field="move_line.move_id.sale_line_id.price_subtotal" style="color:black"/>
        </td>
    </template>
    </data>
</odoo>