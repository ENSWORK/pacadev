<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ourcustom_header_footeroc">
        <t t-set="company" t-value="user.company_id" />
        <div class="header" >
            <div>
                <style>
                   #informations {
                        display: block;
                        }
                   .m-0{
                        display:inline;
                         }
                   strong,p,span{
                        color:black;
                        }
               </style>
                <div class="row mb8">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-width: 350px; max-height: 200px;"/>
                    </div>
                    <div class="col-6 text-right mb4">
                        <br/>
                        <h4 class="mt0" t-field="company.report_header"/>
                    </div>
                </div>
                <div style="margin-left:700px;margin-bottom:0px;color:black;font-size:14px" t-if="report_type == 'pdf'">
                Page N°: <span class="page"/> de <span class="topage"/>
                </div>
                  <div class="first-page" style="color:black;margin-top:5px;margin-bottom:-5px">
                    <center><strong><span style="margin-left:5px;color:#081669;font-size:15px">Pour plus d’information sur nos produits, veuillez consulter notre site web : <span style="color:#081669" t-field="doc.company_id.website"></span></span></strong></center>
                  </div>
            </div>
            <div class="not-first-page" style="padding-top:-79px" >
                 <style>
                     div.not{
                     display:inline-block;
                     margin-right:9px;}
                 </style>
                 <div class="not">
                    <div style="font-size:17px">
                        <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                        <strong t-if="doc.state not in ['draft','sent']">Commande N°</strong>
                        <!--<span t-if="doc.state in ['draft','sent']">Quotation # </span>-->
                        <strong t-if="doc.state in ['draft','sent']" >Offre Commerciale N°: </strong>
                        </t>
                        <t t-if="env.context.get('proforma', False) or is_pro_forma">
                            <strong>Facture Pro-Forma N° </strong>
                        </t>
                        <strong class="m-0" t-field="doc.name"/>

                        <!--<strong style="font-size:17px">Offre Commerciale Numéro:</strong>
                        <p class="m-0" t-field="doc.name"/>-->
                    </div>
                 </div>
                  <div class="not">
                         <div class="col-auto" t-if="doc.client_order_ref" style="font-size:14px">
                            <strong>Votre Référence:</strong>
                            <p class="m-0" t-field="doc.client_order_ref"/>
                        </div>
                  </div>
                  <div class="not">
                        <div style="font-size:14px" t-if="doc.partner_id.ref" >
                            <strong>Client N° :</strong>
                            <p class="m-0" t-field="doc.partner_id.ref"/>&#032; <p class="m-0" t-field="doc.partner_id"/>
                        </div>
                  </div>
             </div>
        </div>

        <div class="footer">
            <style>
            hr.newhr{
                border: 1px solid black;
                margin-top:0px;
                padding-top:0px;}
            #hr2{
                width:700px;
                margin-top: -0.5em;
                margin-bottom: -0.1em;
                }
            p{
                font-size:10px;}
            </style>
                    <hr class="newhr" />
            <center><p style="font-size:10px;" t-field="company.report_footer"></p></center>

        </div>
    </template>
</odoo>