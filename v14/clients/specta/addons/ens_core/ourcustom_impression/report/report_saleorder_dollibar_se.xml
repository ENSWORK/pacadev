<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_dollibar_se">
        <t t-set="company" t-value="user.company_id" /> <!--We need it for Primary/Secondary Colors-->
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <div class="article o_report_layout_boxed" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"><!--To ignore the default layout(remove header+footer)-->
                    <t t-call="ourcustom_impression.report_saleorder_dollibar_headfoot_se" />
                        <style>
                           #informations {
                                display: block;
                                }
                           .m-0{
                                display:inline;
                                 }
                           <!--strong,p,span{
                                color:black;
                                }-->
                            #content{
                                border:1px solid #ABABAB;
                            }
                       </style>

                    <div class="ourpage">
                         <div class="oe_structure"/>
                         <br/>
                        <table style="width:100%;border:0px;margin-top:0px" class="mod" >
                            <tr>
                                <td style="width:45%;border:0px;color:black">Émetteur</td>
                                <td style="width:5%;border:0px;"> </td>
                                <td style="width:50%;border:none;color:black">Adressé à</td>
                            </tr>
                            <tr>
                                <td style="width:45%;border:0px;background-color:#EEEDED;">
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong><p class="m-0" t-field="doc.company_id.name" style="color:#0D0446"/></strong><br/>
                                            <p class="m-0" t-field="doc.company_id.street" style="color:#0D0446"/>
                                            <p class="m-0" t-field="doc.company_id.street2" style="color:#0D0446"/>
                                            <p class="m-0" t-field="doc.company_id.city" style="color:#0D0446"/>
                                            <p class="m-0" t-field="doc.company_id.state_id" style="color:#0D0446"/>
                                            <p class="m-0" t-field="doc.company_id.country_id" style="color:#0D0446"/>
                                            <br/>
                                            <strong style="color:#0D0446">Tél: </strong>
                                            <p class="m-0" t-field="doc.company_id.phone" style="color:#0D0446"/><br/>
                                            <strong style="color:#0D0446">Email: </strong>
                                            <p class="m-0" t-field="doc.company_id.email" style="color:#0D0446"/><br/>
                                            <strong style="color:#0D0446">Web: </strong>
                                            <p class="m-0" t-field="doc.company_id.website" style="color:#0D0446"/><br/>

                                        </div>
                                </td>
                                <td style="width:5%;border:0px;"> </td>
                                <td style="width:50%;border:none;">
                                    <div style="padding-left:15px;padding-right:20px;padding-bottom:6px;min-height:160px;border:1px solid #ABABAB;">
                                                <p style="color:black;">
                                                    <div class="mod3" style="color:black"><strong><p class="m-0" t-field="doc.partner_id"/></strong></div>
                                                    <div style="color:black">
                                                        <span  t-field="doc.partner_id.street"></span>&#032;<span t-field="doc.partner_id.street2"></span>&#032;
                                                        <span  t-field="doc.partner_id.city"></span>&#032;<span t-field="doc.partner_id.state_id"></span>&#032;
                                                        <span  t-field="doc.partner_id.zip"></span>&#032;<span t-field="doc.partner_id.country_id"></span><br/></div>
                                                    <div style="color:black"><strong>Tél :</strong>
                                                        <t t-if="doc.partner_id.company_type == 'person'">
                                                            <p t-if="doc.partner_id.phone_required" class="m-0" t-esc="str(doc.partner_id.phone_required).replace('.',' ')"/>
                                                        </t>
                                                        <t t-else="">
                                                            <p class="m-0" t-field="doc.partner_id.phone"/>
                                                        </t>
                                                    </div>
                                                    <div style="color:black"><strong>E-mail :</strong><p class="m-0" t-field="doc.partner_id.email"/></div>
                                                    <div style="color:black"><strong>ICE :</strong><p class="m-0" t-field="doc.partner_id.vat"/></div>
                                                </p>
                                    </div>

                                </td>
                            </tr>
                        </table><br/>

                             <!--TABLE  PRINCIPALE-->
                    <!-- Is there a discount on at least one line? -->
                             <style>
                                 .rows_color2 tr:nth-child(even){
                                    background-color: #EEEDED !important;
                                }
                             </style>
                    <t t-set="display_discount" t-value="any(l.discount for l in doc.order_line)"/>
                    <t t-set="display_delai" t-value="any(l.ourdelai for l in doc.order_line)"/>

                    <table class="table table-sm o_main_table"  style="height:115mm;border-color:#ABABAB">
                        <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                        <thead style="border-color:#ABABAB">
                            <tr style="border-color:#ABABAB">
                                <th t-attf-style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:4%" name="th_line_num" class="text-center">N°</th>
                                <th t-attf-style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:11%" name="th_ref" class="text-left">Référence</th>
                                <th t-attf-style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB" name="th_description" class="text-left">Désignation</th>
                                <th t-attf-style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:9%" name="th_quantity" class="text-center">Qté</th>
                                <th t-if="display_delai" t-attf-style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;" name="th_delai" class="text-center">Délai</th>
                                <th t-attf-style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:13%" name="th_priceunit" class="text-center">P.U HT</th>
                                <th t-attf-style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:7%" name="th_discount" t-if="display_discount" class="text-right">
                                    <span>Remise</span>
                                </th>
                                <th t-attf-style="vertical-align:middle;text-transform: lowercase;text-transform: capitalize;border-color:#ABABAB;width:13%" name="th_subtotal" class="text-center">
                                    <span groups="account.group_show_line_subtotals_tax_excluded">Total HT<!--Amount--></span>
                                    <span groups="account.group_show_line_subtotals_tax_included">Total HT</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody style="border-color:#ABABAB">

                            <t t-set="current_subtotal" t-value="0"/>

                            <t t-foreach="doc.order_line" t-as="line">

                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''" style="height:8mm">
                                    <t t-if="not line.display_type">
                                        <td style="color:black;border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:4%" name="td_line_num" class="text-center"><span t-field="line.sl_no"/></td>
                                        <td style="color:black;border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:11%" name="td_ref"><span t-if="line.product_id.default_code" t-esc="str(line.product_id.default_code).replace('-', '⁻')"/></td>
                                        <td style="color:black;border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;" name="td_name"><span t-field="line.name"/></td>
                                        <td style="color:black;border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:4%" name="td_quantity" class="text-center">
                                            <span t-field="line.product_uom_qty"/>
                                            <!--<span t-field="line.product_uom" groups="uom.group_uom"/>-->
                                        </td>
                                        <td t-if="display_delai" style="color:black;border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;" name="td_delai" class="text-center">
                                            <span t-field="line.ourdelai" />
                                        </td>
                                        <td style="color:black;border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:13%" name="td_priceunit" class="text-right">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td style="color:black;border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:7%;color:black" t-if="display_discount" class="text-right" groups="product.group_discount_per_so_line">
                                            <!--<span t-esc="str('%.2f'% line.discount).replace('.', ',')"/>% -->
                                            <span t-esc="str('{0:,.2f}'.format(float(line.discount)).replace(',', ' ')).replace('.', ',')"/>%
                                        </td>
                                        <td style="color:black;border-color:#ABABAB;vertical-align:middle;border-bottom:1px dotted #ABABAB;width:13%" name="td_subtotal" class="text-right">
                                            <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td style="color:black;background-color:white;border-color:#ABABAB;" name="td_section_line" colspan="99">
                                            <span t-field="line.name"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td style="color:black;border-color:#ABABAB;" name="td_note_line" colspan="99">
                                            <span t-field="line.name"/>
                                        </td>
                                    </t>
                                </tr>

                                <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-right" style="border-color:#ABABAB;height:8mm">
                                        <td style="color:black;border-color:#ABABAB;background-color:white" name="td_section_subtotal" colspan="99">
                                            <strong class="mr16">Subtotal</strong>
                                            <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <tr style="background-color:white !important">
                                <td style="border-color:#ABABAB;"> </td>
                                <td style="border-color:#ABABAB;"> </td>
                                <td style="border-color:#ABABAB;"> </td>
                                <td style="border-color:#ABABAB;"> </td>
                                <td t-if="display_delai" style="border-color:#ABABAB;"> </td>
                                <td style="border-color:#ABABAB;"> </td>
                                <td style="border-color:#ABABAB;" t-if="display_discount"> </td>
                                <td style="border-color:#ABABAB;"> </td>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width:100%;page-break-inside: avoid;border:none;margin-top:-12px" name="table_cdp">
                            <tr>
                                <td style="width:55%;padding-right:7px;border:none;color:black">
                                   <div class="col-auto col-3 mw-100 mb-2" style="font-size:13px;margin-left:-10px" name="cd_paiement">
                                       <strong>Conditions de paiement  : </strong>
                                       <p class="m-0" t-field="doc.payment_term_id"/>
                                   </div>
                                    <div class="col-auto col-3 mw-100 mb-2" style="font-size:13px;margin-left:-10px" name="cd_livraison">
                                       <strong>Conditions de livraison  : </strong>
                                       <p class="m-0" t-field="doc.incoterm"/>
                                   </div>

                                    <div t-if="doc.note" class="col-auto col-3 mw-100 mb-2" style="font-size:13px;margin-left:-10px" name="note">
                                        <strong>Note  : </strong>
                                        <p class="m-0" t-field="doc.note"/>
                                    </div>

                                </td>
                                <td style="padding:0px;width:45%;border:none">
                                        <table style="page-break-inside: avoid;border:none;width:100%;">
                                            <tr class="o_subtotal" style="">
                                                <td name="td_amount_untaxed_label" style="color:black;border:none;font-size:13px"><strong>Total HT<!--Subtotal--></strong></td>
                                                <td name="td_amount_untaxed" class="text-right" style="border:none;font-size:13px;padding-right:5px;">
                                                    <span style="color:black" t-field="doc.amount_untaxed"/>
                                                </td>
                                            </tr>
                                            <t t-foreach="doc.amount_by_group" t-as="amount_by_group">
                                                <tr style="color:black">
                                                    <t t-if="amount_by_group[5] == 1 and doc.amount_untaxed == amount_by_group[2]">
                                                        <td name="td_amount_by_group_label_3" style="border:none;font-size:13px;background-color:#FAF9F9;">
                                                            <span t-esc="amount_by_group[0]"/>
                                                        </td>
                                                        <td name="td_amount_by_group_3" class="text-right o_price_total" style="border:none;font-size:13px;background-color:#FAF9F9;padding-right:5px;">
                                                            <span t-esc="amount_by_group[1]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td name="td_amount_by_group_label" style="border:none;font-size:13px;background-color:#FAF9F9;padding-right:5px;">
                                                            <span t-esc="amount_by_group[0]"/>
                                                        </td>
                                                        <td name="td_amount_by_group" class="text-right o_price_total" style="border:none;font-size:13px;background-color:#FAF9F9;padding-right:5px;">
                                                            <span t-esc="amount_by_group[1]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                            <tr class="o_total">
                                                <td name="td_amount_total_label" style="background-color:#EEEDED;border:none;font-size:13px;color:black"><strong>Total TTC</strong></td>
                                                <td name="td_amount_total" class="text-right" style="padding-right:5px;border:none;background-color:#EEEDED;font-size:13px;color:black">
                                                    <span t-field="doc.amount_total"/>
                                                </td>
                                            </tr>
                                        </table>
                                </td>
                            </tr>
                    </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>