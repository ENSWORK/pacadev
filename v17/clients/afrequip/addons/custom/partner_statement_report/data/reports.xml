<?xml version="1.0" encoding="utf-8"?>
<!-- MOD 1: Configuration du rapport avec traduction FR -->
<odoo>
    <data>
        <!-- Configuration du rapport partenaire -->
        <record id="ir_actions_report_partner_statement" model="ir.actions.report">
            <field name="name">Déclaration de compte</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_file">partner_statement_report.partner_statement_report_pdf</field>
        </record>

        <!-- Menu pour accéder au rapport -->
        <menuitem
            id="menu_partner_statement_report"
            name="Déclaration de compte partenaire"
            parent="account.menu_finance_reports"
            action="ir_actions_report_partner_statement"
            sequence="50"/>
    </data>
</odoo>
