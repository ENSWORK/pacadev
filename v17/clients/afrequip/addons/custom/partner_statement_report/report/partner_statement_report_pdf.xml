<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Document template - called once per partner -->
    <!-- MOD 2: Use custom_reports.custom_external_layout for header/footer -->
    <template id="customer_statement_document">
        <t t-call="custom_reports.custom_external_layout">
            <t t-set="company" t-value="env.company"/>
            <t t-set="o" t-value="partner['partner_record']"/>
            <t t-set="address">
                <address>
                    <span t-field="o.name"/><br/>
                    <!-- MOD 5: Add ICE field if available -->
                    <t t-if="o.ice">
                        <strong>ICE:</strong> <span t-field="o.ice"/><br/>
                    </t>
                    <span t-field="o.street"/><br/>
                    <span t-if="o.street2"><span t-field="o.street2"/><br/></span>
                    <span t-field="o.zip"/> <span t-field="o.city"/><br/>
                    <span t-field="o.state_id"/><br/>
                    <span t-field="o.country_id"/>
                </address>
            </t>
            <div class="page">
                <div id="oe_structure" class="oe_structure"/>
                <!-- MOD 1: French translations -->
                <h2 style="text-align:center;">
                    <t t-if="statement_type == 'activity'">Déclaration d'Activité</t>
                    <t t-elif="statement_type == 'detailed_activity'">Déclaration d'Activité Détaillée</t>
                    <t t-else="">Déclaration d'Encours</t>
                </h2>
                <div class="row mt16 mb16">
                    <div class="col-6">
                        <strong>Au: </strong>
                        <span t-esc="as_of_date"/>
                    </div>
                    <t t-if="start_date">
                        <div class="col-6">
                            <strong>Période: </strong>
                            <span t-esc="start_date"/>
                            <t t-if="end_date"> &#8212; <span t-esc="end_date"/></t>
                        </div>
                    </t>
                </div>

                <!-- Activity -->
                <t t-if="statement_type == 'activity'">
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:16px;">
                        <!-- MOD 4: Added date_due column widths -->
                        <colgroup>
                            <col style="width:14%;"/>
                            <col style="width:16%;"/>
                            <col style="width:14%;"/>
                            <col style="width:14%;"/>
                            <col style="width:14%;"/>
                            <col style="width:14%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;">Date</th>
                                <th style="text-align:center;">Référence</th>
                                <!-- MOD 4: Due Date column -->
                                <th style="text-align:center;">Date Échéance</th>
                                <th style="text-align:right;">Montant</th>
                                <th style="text-align:right;">Payé</th>
                                <th style="text-align:right;">Solde</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="5" style="text-align:right;">Solde Ouverture</td>
                                <!-- MOD 3: Currency kept on totals only -->
                                <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="partner['opening_balance']"/></td>
                            </tr>
                            <t t-foreach="partner['lines']" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><span t-esc="line['date']"/></td>
                                    <td style="text-align:center;"><span t-esc="line['reference']"/></td>
                                    <!-- MOD 4: Added due_date field, MOD 3: Removed currency from lines -->
                                    <td style="text-align:center;"><span t-esc="line.get('due_date', '-')"/></td>
                                    <td style="text-align:right;"><span t-esc="line['original_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['applied_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['balance']"/></td>
                                </tr>
                                <t t-foreach="line['sub_lines']" t-as="sub">
                                    <tr style="color:#555;font-size:0.92em;font-style:italic;">
                                        <td style="text-align:center;padding-left:20px;"><span t-esc="sub['date']"/></td>
                                        <td style="text-align:center;padding-left:20px;"><span t-esc="sub['reference']"/></td>
                                        <td/>
                                        <td style="text-align:right;"><span t-esc="sub['applied_amount']"/></td>
                                        <td/>
                                        <td/>
                                    </tr>
                                </t>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="5" style="text-align:right;">Solde Fermeture</td>
                                <!-- MOD 3: Currency kept on totals -->
                                <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="partner['closing_balance']"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-set="buckets" t-value="partner.get('aging_buckets')"/>
                    <t t-if="buckets and buckets.get('_has_balance')">
                        <h5 style="margin-top:24px;">Aging Report</h5>
                        <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                            <colgroup>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:16%;"/>
                            </colgroup>
                            <thead style="background-color:#f5f5f5;">
                                <tr>
                                    <th style="text-align:center;">Current</th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">1 Month</t><t t-else="">1 - 30 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">2 Months</t><t t-else="">31 - 60 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">3 Months</t><t t-else="">61 - 90 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">4 Months</t><t t-else="">91 - 120 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">Older</t><t t-else="">121 Days +</t></th>
                                    <th style="text-align:center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('current', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_1_30', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_30_60', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_60_90', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_90_120', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_over_120', '0.00')"/></td>
                                    <td style="text-align:right;"><strong><span t-esc="currency"/> <span t-esc="buckets.get('total', '0.00')"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>

                <!-- Detailed Activity -->
                <t t-if="statement_type == 'detailed_activity'">
                    <h5 style="margin-top:16px;">Prior Balance</h5>
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                        <colgroup>
                            <col style="width:16%;"/><col style="width:36%;"/><col style="width:16%;"/>
                            <col style="width:16%;"/><col style="width:16%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;">Date</th>
                                <th style="text-align:center;">Reference</th>
                                <th style="text-align:right;">Original Amount</th>
                                <th style="text-align:right;">Open Amount</th>
                                <th style="text-align:right;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['prior_lines']" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><span t-esc="line['date']"/></td>
                                    <td style="text-align:center;"><span t-esc="line['reference']"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="line['original_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="line['open_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="line['balance']"/></td>
                                </tr>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="4" style="text-align:right;">Prior Balance Total</td>
                                <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="partner['prior_balance']"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 style="margin-top:16px;">Activity</h5>
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                        <colgroup>
                            <col style="width:16%;"/><col style="width:36%;"/><col style="width:16%;"/>
                            <col style="width:16%;"/><col style="width:16%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;">Date</th>
                                <th style="text-align:center;">Reference</th>
                                <th style="text-align:right;">Amount</th>
                                <th style="text-align:right;">Amount Paid</th>
                                <th style="text-align:right;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['lines']" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><span t-esc="line['date']"/></td>
                                    <td style="text-align:center;"><span t-esc="line['reference']"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="line['original_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="line['applied_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="line['balance']"/></td>
                                </tr>
                                <t t-foreach="line['sub_lines']" t-as="sub">
                                    <tr style="color:#555;font-size:0.92em;font-style:italic;">
                                        <td style="text-align:center;padding-left:20px;"><span t-esc="sub['date']"/></td>
                                        <td style="text-align:center;padding-left:20px;"><span t-esc="sub['reference']"/></td>
                                        <td/>
                                        <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="sub['applied_amount']"/></td>
                                        <td/>
                                    </tr>
                                </t>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="4" style="text-align:right;">Closing Balance</td>
                                <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="partner['closing_balance']"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 style="margin-top:16px;">Solde Final</h5>
                    <!-- MOD 4: Adjusted colgroup for date_due -->
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                        <colgroup>
                            <col style="width:14%;"/><col style="width:16%;"/><col style="width:14%;"/>
                            <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;">Date</th>
                                <th style="text-align:center;">Référence</th>
                                <!-- MOD 4: Due Date column -->
                                <th style="text-align:center;">Date Échéance</th>
                                <th style="text-align:right;">Montant Original</th>
                                <th style="text-align:right;">Ouvert</th>
                                <th style="text-align:right;">Solde</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['ending_lines']" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><span t-esc="line['date']"/></td>
                                    <td style="text-align:center;"><span t-esc="line['reference']"/></td>
                                    <!-- MOD 4: Added due_date, MOD 3: Removed currency from lines -->
                                    <td style="text-align:center;"><span t-esc="line.get('due_date', '-')"/></td>
                                    <td style="text-align:right;"><span t-esc="line['original_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['open_amount']"/></td>
                                    <td style="text-align:right;"><span t-esc="line['balance']"/></td>
                                </tr>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="5" style="text-align:right;">Total Solde Final</td>
                                <!-- MOD 3: Currency kept on total -->
                                <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="partner['ending_balance']"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <t t-set="buckets" t-value="partner.get('aging_buckets')"/>
                    <t t-if="buckets and buckets.get('_has_balance')">
                        <h5 style="margin-top:24px;">Aging Report</h5>
                        <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                            <colgroup>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:16%;"/>
                            </colgroup>
                            <thead style="background-color:#f5f5f5;">
                                <tr>
                                    <th style="text-align:center;">Current</th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">1 Month</t><t t-else="">1 - 30 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">2 Months</t><t t-else="">31 - 60 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">3 Months</t><t t-else="">61 - 90 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">4 Months</t><t t-else="">91 - 120 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">Older</t><t t-else="">121 Days +</t></th>
                                    <th style="text-align:center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('current', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_1_30', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_30_60', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_60_90', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_90_120', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_over_120', '0.00')"/></td>
                                    <td style="text-align:right;"><strong><span t-esc="currency"/> <span t-esc="buckets.get('total', '0.00')"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>

                <!-- MOD 5: Outstanding section with ICE field support -->
                <t t-if="statement_type == 'outstanding'">
                    <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:16px;">
                        <!-- MOD 4: Adjusted colgroup for date_due -->
                        <colgroup>
                            <col style="width:16%;"/><col style="width:18%;"/><col style="width:15%;"/>
                            <col style="width:15%;"/><col style="width:15%;"/><col style="width:15%;"/>
                        </colgroup>
                        <thead style="background-color:#f5f5f5;">
                            <tr>
                                <th style="text-align:center;vertical-align:middle;">Date Facture</th>
                                <th style="text-align:center;vertical-align:middle;">Facture</th>
                                <!-- MOD 4: Due Date column in Outstanding -->
                                <th style="text-align:center;vertical-align:middle;">Date Échéance</th>
                                <th style="text-align:right;vertical-align:middle;">Montant Facture</th>
                                <th style="text-align:right;vertical-align:middle;">Montant Payé</th>
                                <th style="text-align:right;vertical-align:middle;">Solde Dû</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['invoices']" t-as="invoice">
                                <tr>
                                    <td style="text-align:center;vertical-align:middle;"><span t-esc="invoice['invoice_date']"/></td>
                                    <td style="text-align:center;vertical-align:middle;"><span t-esc="invoice['invoice_id']"/></td>
                                    <!-- MOD 4: Due Date column, MOD 3: Removed currency from lines -->
                                    <td style="text-align:center;vertical-align:middle;"><span t-esc="invoice.get('due_date', '-')"/></td>
                                    <td style="text-align:right;vertical-align:middle;"><span t-esc="invoice['amount']"/></td>
                                    <td style="text-align:right;vertical-align:middle;"><span t-esc="invoice['payment_amount']"/></td>
                                    <td style="text-align:right;vertical-align:middle;"><span t-esc="invoice['balance_due']"/></td>
                                </tr>
                            </t>
                            <tr style="font-weight:bold;background-color:#f5f5f5;">
                                <td colspan="3" style="text-align:right;vertical-align:middle;">Total</td>
                                <!-- MOD 3: Currency kept on totals -->
                                <td style="text-align:right;vertical-align:middle;"><span t-esc="currency"/> <span t-esc="partner['total_amount']"/></td>
                                <td style="text-align:right;vertical-align:middle;"><span t-esc="currency"/> <span t-esc="partner['total_payment']"/></td>
                                <td style="text-align:right;vertical-align:middle;"><span t-esc="currency"/> <span t-esc="partner['total_balance']"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-set="buckets" t-value="partner['aging_buckets']"/>
                    <t t-if="buckets and buckets.get('_has_balance')">
                        <h5 style="margin-top:24px;">Aging Report</h5>
                        <table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;margin-top:8px;">
                            <colgroup>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:14%;"/><col style="width:14%;"/><col style="width:14%;"/>
                                <col style="width:16%;"/>
                            </colgroup>
                            <thead style="background-color:#f5f5f5;">
                                <tr>
                                    <th style="text-align:center;">Current</th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">1 Month</t><t t-else="">1 - 30 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">2 Months</t><t t-else="">31 - 60 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">3 Months</t><t t-else="">61 - 90 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">4 Months</t><t t-else="">91 - 120 Days</t></th>
                                    <th style="text-align:center;"><t t-if="aging_type == 'months'">Older</t><t t-else="">121 Days +</t></th>
                                    <th style="text-align:center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('current', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_1_30', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_30_60', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_60_90', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_90_120', '0.00')"/></td>
                                    <td style="text-align:right;"><span t-esc="currency"/> <span t-esc="buckets.get('b_over_120', '0.00')"/></td>
                                    <td style="text-align:right;"><strong><span t-esc="currency"/> <span t-esc="buckets.get('total', '0.00')"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>
            </div>
        </t>
    </template>
    <!-- Main template -->
    <template id="customer_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="partner">
                <t t-call="partner_statement_report.customer_statement_document"/>
            </t>
        </t>
    </template>
    <!-- Report Action -->
    <record id="customer_report_template_action" model="ir.actions.report">
        <field name="name">Customer Statement Report</field>
        <field name="model">customer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_statement_report.customer_report_template</field>
        <field name="report_file">partner_statement_report.customer_report_template</field>
        <field name="binding_model_id" ref="model_customer_statement_wizard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>