<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================== HEADER ==================== -->
    <template id="external_layout_header_invoice_water">
        <div class="header">
            <t t-if="o.company_id.invoice_mec_header_type == 'image' and o.company_id.header_image_invoice_mec">
                <img t-att-src="image_data_uri(o.company_id.header_image_invoice_mec)"
                     alt="Header Facture"
                     style="width:100%; max-width:100%; max-height:40mm; object-fit:contain; display:block;"/>
            </t>
            <t t-elif="o.company_id.invoice_mec_header_type == 'image' and o.company_id.header_image_mec">
                <img t-att-src="image_data_uri(o.company_id.header_image_mec)"
                     alt="Header"
                     style="width:100%; max-width:100%; max-height:40mm; object-fit:contain; display:block;"/>
            </t>
            <t t-elif="o.company_id.logo">
                <img t-att-src="image_data_uri(o.company_id.logo)"
                     alt="Logo"
                     t-attf-style="max-height:#{o.company_id.logo_height}px; max-width:#{o.company_id.logo_width}px; display:block;"/>
            </t>
        </div>
    </template>

    <!-- ==================== FOOTER ==================== -->
    <template id="external_layout_footer_invoice_water">
        <div class="footer" style="min-height:35mm; position:relative;">
            <t t-if="o.company_id.footer_image_mec">
                <img t-att-src="image_data_uri(o.company_id.footer_image_mec)"
                     alt="Footer"
                     style="width:100%; max-width:100%; display:block;"/>
            </t>
            <div style="position:absolute; bottom:3px; right:0;">
                <span style="font-size:11px;">Page <span class="page"/>/<span class="topage"/></span>
            </div>
        </div>
    </template>

    <!-- ==================== LAYOUT WRAPPER ==================== -->
    <template id="external_layout_invoice_water">
        <div class="article o_report_layout_standard">
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_header_invoice_water"/>
            </t>
            <t t-raw="0"/>
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_footer_invoice_water"/>
            </t>
        </div>
    </template>

    <!-- ==================== DOCUMENT ==================== -->
    <template id="report_invoice_water_document">

        <style>
            .water-inv-even { }
            .water-inv-odd  { }
        </style>

        <!-- Blocs info : document (gauche) + client (droite) -->
        <table style="width:100%; border-collapse:collapse; border:none; margin-top:15px;">
            <tr>
                <!-- LEFT : infos facture -->
                <td style="width:48%; vertical-align:top; background-color:#EBF5FB; padding:10px 12px;">
                    <div style="font-size:17px; font-weight:bold; color:#0056A6; margin-bottom:8px;">
                        <t t-if="o.move_type == 'out_refund'">AVOIR</t>
                        <t t-else="">FACTURE</t>
                    </div>
                    <div style="padding:5px 0;"><strong>Réf.</strong> : <span t-field="o.name"/></div>
                    <div style="padding:5px 0;">
                        <strong><t t-if="o.move_type == 'out_refund'">Facture d'origine</t><t t-else="">N°BC</t></strong> :
                        <t t-if="o.invoice_origin"><span t-field="o.invoice_origin"/></t>
                    </div>
                    <div style="padding:5px 0;"><strong>N° BL</strong> :
                        <t t-if="o.invoice_line_ids and o.invoice_line_ids[0].sale_line_ids and o.invoice_line_ids[0].sale_line_ids[0].move_ids and o.invoice_line_ids[0].sale_line_ids[0].move_ids[0].picking_id">
                            <span t-field="o.invoice_line_ids[0].sale_line_ids[0].move_ids[0].picking_id.name"/>
                        </t>
                    </div>
                    <div style="padding:5px 0;"><strong><t t-if="o.move_type == 'out_refund'">Date d'avoir</t><t t-else="">Date de facturation</t></strong> :
                        <span t-field="o.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/>
                    </div>
                    <div style="padding:5px 0;"><strong>Conditions de paiement</strong> :
                        <t t-if="o.invoice_payment_term_id"><span t-field="o.invoice_payment_term_id"/></t>
                    </div>
                </td>

                <td style="width:4%; border:none;"></td>

                <!-- RIGHT : infos client -->
                <td style="width:48%; vertical-align:top; background-color:#EBF5FB; padding:10px 12px;">
                    <div style="font-size:17px; font-weight:bold; color:#0056A6; margin-bottom:8px;">
                        <span t-field="o.partner_id.name"/>
                    </div>
                    <div style="padding:5px 0;"><strong>Code client</strong> :
                        <t t-if="o.partner_id.company_registry"><span t-field="o.partner_id.company_registry"/></t>
                    </div>
                    <div style="padding:5px 0;"><strong>Adresse</strong> :
                        <t t-if="o.partner_id.street"><span t-field="o.partner_id.street"/></t>
                    </div>
                    <div style="padding:5px 0;"><strong>Tél.</strong> :
                        <t t-if="o.partner_id.phone"><span t-field="o.partner_id.phone"/></t>
                        <t t-elif="o.partner_id.mobile"><span t-field="o.partner_id.mobile"/></t>
                    </div>
                    <div style="padding:5px 0;"><strong>ICE</strong> : <span t-field="o.partner_id.ice"/></div>

                </td>
            </tr>
        </table>

        <!-- Tableau des lignes -->
        <table style="width:100%; margin-top:15px; border-collapse:collapse;">
            <thead>
                <tr style="font-weight:bold; text-align:center;">
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:5%;">N°</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:15%;">Référence</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; text-align:left;">Désignation</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:8%; white-space:nowrap;">Qté</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:12%; white-space:nowrap;">P.H.HT</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:12%; white-space:nowrap;">Total HT</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o.invoice_line_ids" t-as="line"
                    t-att-class="line_index % 2 == 0 and 'water-inv-even' or 'water-inv-odd'">
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:center; font-size:14px; vertical-align:middle;">
                        <span t-esc="line_index + 1"/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:center; font-size:14px; vertical-align:middle;">
                        <span t-field="line.product_id.default_code"/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; vertical-align:middle;">
                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:center; font-size:14px; white-space:nowrap; vertical-align:middle;">
                        <t t-set="qty_str" t-value="'{:.2f}'.format(line.quantity)"/>
                        <span t-esc="qty_str.rstrip('0').rstrip('.') if qty_str.endswith('.00') else qty_str"/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:right; font-size:14px; white-space:nowrap; vertical-align:middle;">
                        <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:right; font-size:14px; white-space:nowrap; vertical-align:middle;">
                        <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                </tr>
            <!-- Lignes vides pour remplir jusqu'à 13 lignes -->
            <t t-set="empty_lines" t-value="max(13 - len(o.invoice_line_ids), 0)"/>
            <t t-foreach="range(empty_lines)" t-as="i">
                <tr style="height:30px;">
                    <td style="border-left:1px solid #BBBBBB; border-right:1px solid #BBBBBB;"></td>
                    <td style="border-right:1px solid #BBBBBB;"></td>
                    <td style="border-right:1px solid #BBBBBB;"></td>
                    <td style="border-right:1px solid #BBBBBB;"></td>
                    <td style="border-right:1px solid #BBBBBB;"></td>
                    <td style="border-right:1px solid #BBBBBB;"></td>
                </tr>
            </t>
            </tbody>
        </table>

        <!-- Montant en lettres + Totaux -->
        <t t-set="tax_dict" t-value="{}"/>
        <t t-foreach="o.invoice_line_ids" t-as="line">
            <t t-foreach="line.tax_ids" t-as="tax">
                <t t-if="str(tax.amount) not in tax_dict">
                    <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): 0})"/>
                </t>
                <t t-set="current_tax" t-value="tax_dict[str(tax.amount)] + line.price_subtotal * (tax.amount / 100.0)"/>
                <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): current_tax})"/>
            </t>
        </t>

        <table style="width:100%; margin-top:12px; border-collapse:collapse; border:none; page-break-inside:avoid;">
            <tr>
                <!-- Montant en lettres -->
                <td style="width:65%; vertical-align:top; border:none; padding-right:15px;">
                    <div style="margin-top:10px;">
                        <span style="display:block; margin-bottom:5px;">
                            <t t-if="o.move_type == 'out_refund'">Le présent avoir est arrêté à la somme TTC de :</t>
                            <t t-else="">La présente facture est arrêtée à la somme TTC de :</t>
                        </span>
                        <strong><t t-esc="o.currency_id.amount_to_text(o.amount_total)"/></strong>
                    </div>
                </td>
                <!-- Totaux -->
                <td style="width:35%; vertical-align:top; border:none;">
                    <table style="width:100%; border-collapse:collapse; font-size:14px;">
                        <tr style="background-color:#f0f0f0;">
                            <td style="padding:5px 10px; border:1px solid #BBBBBB; font-weight:bold; white-space:nowrap;">TOTAL HT</td>
                            <td style="padding:5px 10px; border:1px solid #BBBBBB; text-align:right; font-weight:bold; white-space:nowrap;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                                <span> </span><span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>
                        <t t-foreach="tax_dict.items()" t-as="tax_item">
                            <tr>
                                <td style="padding:5px 10px; border:1px solid #BBBBBB; white-space:nowrap;">
                                    TVA <t t-esc="int(float(tax_item[0]))"/>%
                                </td>
                                <td style="padding:5px 10px; border:1px solid #BBBBBB; text-align:right; white-space:nowrap;">
                                    <span t-esc="tax_item[1]" t-options='{"widget": "float", "precision": 2}'/>
                                    <span> </span><span t-field="o.currency_id.symbol"/>
                                </td>
                            </tr>
                        </t>
                        <tr style="background-color:#f0f0f0;">
                            <td style="padding:5px 10px; border:1px solid #BBBBBB; font-weight:bold; white-space:nowrap;">TOTAL TTC</td>
                            <td style="padding:5px 10px; border:1px solid #BBBBBB; text-align:right; font-weight:bold; white-space:nowrap;">
                                <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                                <span> </span><span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- Signature/Tampon -->
        <t t-if="o.print_with_signature">
            <div style="margin-top:20px; text-align:center;">
                <t t-if="o.company_id.stamp_image">
                    <img t-att-src="image_data_uri(o.company_id.stamp_image)"
                         alt="Tampon"
                         style="max-width:320px; max-height:200px; display:inline-block;"/>
                </t>
                <t t-elif="o.invoice_user_id.signature_image">
                    <img t-att-src="image_data_uri(o.invoice_user_id.signature_image)"
                         alt="Signature"
                         style="max-width:320px; max-height:200px; display:inline-block;"/>
                </t>
            </div>
        </t>

    </template>

    <!-- ==================== RAPPORT PRINCIPAL ==================== -->
    <template id="report_invoice_water">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_reports.external_layout_invoice_water">
                    <t t-call="custom_reports.report_invoice_water_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ==================== ACTION ==================== -->
    <record id="action_report_invoice_water" model="ir.actions.report">
        <field name="name">Facture WATER</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_reports.report_invoice_water</field>
        <field name="report_file">custom_reports.report_invoice_water</field>
        <field name="print_report_name">'Facture - %s' % (object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_water"/>
    </record>
</odoo>
