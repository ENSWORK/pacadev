<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template dynamique pour les bons de réception -->
    <!-- Sélectionne automatiquement le bon template selon la configuration de la société -->
    <template id="report_receipt_dynamic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Sélection du layout en fonction des options (template de la société) -->
                <t t-if="o.company_id.print_template == 'odoo'">
                    <!-- Utiliser le template natif d'Odoo (picking) -->
                    <t t-call="web.external_layout">
                        <t t-call="stock.report_picking_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'ens'">
                    <t t-call="custom_reports.external_layout_receipt_ens">
                        <t t-call="custom_reports.report_receipt_ens_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template in ('mec', 'water')">
                    <t t-call="custom_reports.external_layout_receipt_mec">
                        <t t-call="custom_reports.report_receipt_mec_document"/>
                    </t>
                </t>
                <t t-else="">
                    <!-- Template DB par défaut -->
                    <t t-call="custom_reports.external_layout_receipt_db">
                        <t t-call="custom_reports.report_receipt_db_document"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <!-- Action de rapport pour les bons de réception -->
    <record id="action_report_receipt_dynamic" model="ir.actions.report">
        <field name="name">Bon de Réception</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_reports.report_receipt_dynamic</field>
        <field name="report_file">custom_reports.report_receipt_dynamic</field>
        <field name="print_report_name">'BR - %s' % (object.name)</field>
        <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_standard"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
