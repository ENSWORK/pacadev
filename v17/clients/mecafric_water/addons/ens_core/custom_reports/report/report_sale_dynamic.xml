<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_dynamic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Sélection du layout en fonction des options (template de la société, options du document) -->
                <t t-if="o.company_id.print_template == 'odoo'">
                    <!-- Utiliser le template natif d'Odoo -->
                    <t t-call="web.external_layout">
                        <t t-call="sale.report_saleorder_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'ens'">
                    <t t-call="custom_reports.external_layout_sale_order_ens">
                        <t t-if="o.print_with_ref">
                            <t t-call="custom_reports.report_sale_order_ens_document"/>
                        </t>
                        <t t-else="">
                            <t t-call="custom_reports.report_sale_order_ens_without_ref_document"/>
                        </t>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'mec'">
                    <t t-call="custom_reports.external_layout_sale_order_mec">
                        <t t-if="o.print_with_ref">
                            <t t-call="custom_reports.report_sale_order_mec_document"/>
                        </t>
                        <t t-else="">
                            <t t-call="custom_reports.report_sale_order_mec_without_ref_document"/>
                        </t>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'water'">
                    <t t-call="custom_reports.external_layout_sale_order_water">
                        <t t-call="custom_reports.report_sale_order_water_document"/>
                    </t>
                </t>
                <t t-else="">
                    <!-- Template DB - toujours avec layout, le header gère l'affichage du logo -->
                    <t t-call="custom_reports.external_layout_custom">
                        <t t-if="o.print_with_ref">
                            <t t-call="custom_reports.report_saleorder_db_document"/>
                        </t>
                        <t t-else="">
                            <t t-call="custom_reports.report_saleorder_db_without_ref_document"/>
                        </t>
                    </t>
                </t>
            </t>
        </t>
    </template>

<record id="action_report_sale_dynamic" model="ir.actions.report">
    <field name="name">Print Devis</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">custom_reports.report_sale_dynamic</field>
    <field name="report_file">custom_reports.report_sale_dynamic</field>
    <field name="print_report_name">'Devis - %s' % (object.name)</field>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_water"/>
</record>

<!-- Désactiver les rapports individuels - ils sont appelés par le rapport dynamique -->
<record id="action_report_sale_order_ens" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_sale_order_ens_without_ref" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_sale_order_mec" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_sale_order_mec_without_ref" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_saleorder_db" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_saleorder_db_without_ref" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_sale_order_water" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>

</odoo>
