<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_dynamic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Sélection du layout en fonction des options (template de la société, options du document) -->
                <t t-if="o.company_id.print_template == 'odoo'">
                    <!-- Utiliser le template natif d'Odoo -->
                    <t t-call="web.external_layout">
                        <t t-call="account.report_invoice_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'ens'">
                    <t t-call="custom_reports.external_layout_invoice_ens">
                        <t t-call="custom_reports.report_invoice_ens_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'mec'">
                    <t t-call="custom_reports.external_layout_invoice_mec">
                        <t t-call="custom_reports.report_invoice_mec_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'water'">
                    <t t-call="custom_reports.external_layout_invoice_water">
                        <t t-call="custom_reports.report_invoice_water_document"/>
                    </t>
                </t>
                <t t-else="">
                    <!-- Template DB - toujours avec layout, le header gère l'affichage du logo -->
                    <t t-call="custom_reports.external_layout_invoice_db">
                        <t t-call="custom_reports.report_invoice_db_document"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

<record id="action_report_invoice_dynamic" model="ir.actions.report">
    <field name="name">Print Facture</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">custom_reports.report_invoice_dynamic</field>
    <field name="report_file">custom_reports.report_invoice_dynamic</field>
    <field name="print_report_name">'Facture - %s' % (object.name)</field>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_water"/>
</record>

<!-- Désactiver les rapports individuels - ils sont appelés par le rapport dynamique -->
<record id="action_report_invoice_ens" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_invoice_mec" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_invoice_db" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>
<record id="action_report_invoice_water" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
</record>

</odoo>
