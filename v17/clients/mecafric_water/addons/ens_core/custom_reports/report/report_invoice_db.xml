<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Header Template -->
    <template id="external_layout_header_invoice">
        <div class="header">
            <div class="row">
                <!-- Logo column - only show if print_with_header is True -->
                <t t-if="o.print_with_header">
                    <div class="col-3">
                        <t t-if="o.company_id.logo">
                        <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" t-attf-style="max-height: #{o.company_id.logo_height}px; max-width: #{o.company_id.logo_width}px;"/>
                        </t>
                    </div>
                </t>
                <!-- Document info column - shown only if invoice_info_position is NOT 'top_left' -->
                <t t-if="o.company_id.invoice_info_position != 'top_left'">
                    <div t-attf-class="col-#{12 if not o.print_with_header else 9} text-end">
                        <div style="font-family: Arial, sans-serif; line-height: 1.1;">
                         <h5 t-attf-style="font-size: 18px; font-weight: bold; color: #{o.company_id.primary_color}">FACTURE</h5>
                            <div t-attf-style="font-size: 14px; color: #{o.company_id.primary_color}">
                                <strong>Réf. : </strong><span t-field="o.name"/><br/>
                                <strong>Date facturation : </strong><span t-field="o.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/><br/>
                                <strong>Code client : </strong><span t-field="o.partner_id.ref"/><br/>
                                <strong>Réf de la commande : </strong><span t-field="o.ref"/><br/>
                                <span t-field="o.delivery_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </template>

<!-- Footer Template -->
<template id="external_layout_footer_custom">
    <div class="footer">
        <!-- Footer type: Image -->
        <t t-if="o.company_id.footer_db_type == 'image' and o.company_id.footer_image_db">
            <img t-att-src="image_data_uri(o.company_id.footer_image_db)"
                 alt="Footer DB"
                 style="width: 100%; max-width: 100%; display: block;"/>
        </t>

        <!-- Footer type: Text (default or custom) -->
        <t t-elif="o.company_id.footer_db_type == 'text'">
            <div class="text-center" style="font-size: 13px; border-top: 1px solid #ABABAB; padding-top: 4px; line-height: 1.1;">
                <!-- Custom text if provided -->
                <t t-if="o.company_id.footer_text_db">
                    <div t-field="o.company_id.footer_text_db"/>
                </t>
                <!-- Default fiscal information if no custom text -->
                <t t-else="">
                    <div>
                        <span t-field="o.company_id.name"/> SARL AU - Capital de <span t-field="o.company_id.capital"/> MAD
                    </div>
                    <div style="margin-top:1px;">
                        <span t-field="o.company_id.street"/>, <span t-field="o.company_id.city"/>, <span t-field="o.company_id.country_id.name"/>
                    </div>
                    <div style="margin-top:1px;">
                        R.C.: <span t-field="o.company_id.rc"/> - Patente: <span t-field="o.company_id.tp"/>
                        - I.F.: <span t-field="o.company_id.iff"/> - C.N.S.S.: <span t-field="o.company_id.cnss"/> - I.C.E.: <span t-field="o.company_id.ice"/>
                    </div>
                    <div style="margin-top:1px;">
                        Email: <span t-field="o.company_id.email"/> - Site web: <span t-field="o.company_id.website"/>
                    </div>
                </t>
                <div t-if="report_type == 'pdf'" style="text-align: right; margin-top: 1px; font-size: 11px;">
                    Page <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </t>

        <!-- Footer type: None - no footer displayed -->
    </div>
</template>

    <!-- Layout Template -->
    <template id="external_layout_invoice_db">
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <t t-call="custom_reports.external_layout_header_invoice"/>
            <t t-raw="0"/>
            <!-- Footer uniquement si print_with_header est activé -->
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_footer_custom"/>
            </t>
        </div>
    </template>

<!-- Document Content Template -->
<template id="report_invoice_db_document">
                <div class="page">
                    <!-- Émetteur/Destinataire Section -->
                    <div class="mt-4">
<table class="mb-4" style="width:100%;border-collapse: separate; border-spacing: 0;">
                            <tr>
                                <!-- Bloc de gauche : Émetteur OU Infos facture selon option -->
                                <td t-attf-style="width:45%;border:0px;#{'' if o.company_id.invoice_info_position == 'top_left' else 'background-color:#EEEDED;'}padding:10px;">
                                    <t t-if="o.company_id.invoice_info_position == 'top_left'">
                                        <!-- Infos facture à la place de l'émetteur SANS fond gris -->
                                        <div style="line-height: 1.5;">
                                            <strong t-attf-style="color: #{o.company_id.primary_color}">Réf. : </strong>
                                            <span t-field="o.name" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                            <strong t-attf-style="color: #{o.company_id.primary_color}">Date facturation : </strong>
                                            <span t-field="o.invoice_date" t-options='{"format": "dd/MM/yyyy"}' t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                            <strong t-attf-style="color: #{o.company_id.primary_color}">Code client : </strong>
                                            <span t-field="o.partner_id.ref" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                            <strong t-attf-style="color: #{o.company_id.primary_color}">Réf de la commande : </strong>
                                            <span t-field="o.ref" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                            <t t-if="o.delivery_date">
                                                <strong t-attf-style="color: #{o.company_id.primary_color}">Date livraison : </strong>
                                                <span t-field="o.delivery_date" t-options='{"format": "dd/MM/yyyy"}' t-attf-style="color: #{o.company_id.primary_color}"/>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <!-- Émetteur (comportement par défaut) -->
                                        <div style="line-height: 1.5;">
                                            <strong t-field="o.company_id.name" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                            <t t-if="o.company_id.street">
                                                <span t-field="o.company_id.street" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                            </t>
                                            <t t-if="o.company_id.street2">
                                                <span t-field="o.company_id.street2" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                            </t>
<t t-if="o.company_id.city or o.company_id.country_id">
    <span t-field="o.company_id.city" t-attf-style="color: #{o.company_id.primary_color}"/>
    <t t-if="o.company_id.city and o.company_id.country_id"> - </t>
    <span t-field="o.company_id.country_id" t-attf-style="color: #{o.company_id.primary_color}"/>
</t>

                                            <div class="mt-2">
                                                <t t-if="o.company_id.phone">
                                                    <div>
                                                       <strong t-attf-style="color: #{o.company_id.primary_color}">Tél: </strong>
                                                        <span t-field="o.company_id.phone" t-attf-style="color: #{o.company_id.primary_color}"/>
                                                    </div>
                                                </t>
                                                <t t-if="o.company_id.email">
                                                    <div>
                                                         <strong t-attf-style="color: #{o.company_id.primary_color}">Email: </strong>
                                                        <span t-field="o.company_id.email" t-attf-style="color: #{o.company_id.primary_color}"/>
                                                    </div>
                                                </t>
                                                <t t-if="o.company_id.website">
                                                    <div>
                                                         <strong t-attf-style="color: #{o.company_id.primary_color}">Web: </strong>
                                                        <span t-field="o.company_id.website" t-attf-style="color: #{o.company_id.primary_color}"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                </td>
                                <td style="width:5%;border:0px;"> </td>
                                <td style="width:50%;border:1px solid #ABABAB;padding:15px;">
                                    <div style="line-height: 1.5;">
                                        <strong t-field="o.partner_id"/><br/>
                                        <div style="margin-top:5px;">
                                            <t t-if="o.partner_id.street">
                                                <span t-field="o.partner_id.street"/><br/>
                                            </t>
                                            <t t-if="o.partner_id.street2">
                                                <span t-field="o.partner_id.street2"/><br/>
                                            </t>
                                            <t t-if="o.partner_id.city">
                                                <span t-field="o.partner_id.city"/><br/>
                                            </t>
                                            <t t-if="o.partner_id.country_id">
                                                <span t-field="o.partner_id.country_id"/>
                                            </t>
                                        </div>
                                        <div style="margin-top:10px;">
                                            <t t-if="o.partner_id.phone">
                                                <strong>Tél : </strong>
                                                <span t-field="o.partner_id.phone"/><br/>
                                            </t>
                                            <t t-if="o.partner_id.email">
                                                <strong>E-mail : </strong>
                                                <span t-field="o.partner_id.email"/><br/>
                                            </t>
                                            <t t-if="o.partner_id.ice">
                                                <strong>ICE : </strong>
                                                <span t-field="o.partner_id.ice"/>
                                            </t>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Check for discount and délai -->
                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>

<!-- Main Table -->
<table class="table table-sm" style="width: 100%; border: 1px solid #ABABAB; font-size: 13px;">
    <thead>
        <tr>
            <th style="width: 45%; padding: 8px; border: 1px solid #ABABAB;">Désignation</th>
            <th style="width: 10%; text-align: center; border: 1px solid #ABABAB;">TVA</th>
            <th style="width: 15%; text-align: right; border: 1px solid #ABABAB;">P.U. HT</th>
            <th style="width: 10%; text-align: center; border: 1px solid #ABABAB;">Qté</th>
            <!-- Colonne remise conditionnelle -->
            <th t-if="any(line.discount != 0 for line in o.invoice_line_ids)"
                style="width: 10%; text-align: center; border: 1px solid #ABABAB;">Remise</th>
            <th style="width: 15%; text-align: right; border: 1px solid #ABABAB;">Total HT</th>
        </tr>
    </thead>
    <tbody>
        <t t-foreach="o.invoice_line_ids" t-as="line">
            <tr>
                <td style="padding: 8px; border: 1px solid #ABABAB;">
                    <t t-if="o.print_with_ref and line.product_id.default_code">
                        <strong><span t-field="line.product_id.default_code"/></strong><br/>
                    </t>
                    <span t-field="line.name"/><br/>
                    <t t-if="o.print_with_brand and line.product_id.brand_id">
                        <span style="color: #666;">Marque : </span><span t-field="line.product_id.brand_id.name"/><br/>
                    </t>
                    <t t-if="o.print_with_origin and line.product_id.origin">
                        <span style="color: #666;">Origine : </span><span t-field="line.product_id.origin.name"/>
                    </t>
                </td>
                <td style="text-align: center; padding: 8px; border: 1px solid #ABABAB;">
                    <span t-esc="'%.0f' % line.tax_ids.amount"/>%
                </td>
                <td style="text-align: right; padding: 8px; border: 1px solid #ABABAB;">
                    <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                </td>
                <td style="text-align: center; padding: 8px; border: 1px solid #ABABAB;">
                    <span t-field="line.quantity"/>
                </td>
                <!-- Cellule remise conditionnelle -->
                <td t-if="any(line.discount != 0 for line in o.invoice_line_ids)"
                    style="text-align: center; padding: 8px; border: 1px solid #ABABAB;">
                    <t t-if="line.discount">
                        <span t-esc="str('{0:,.2f}'.format(float(line.discount)).replace(',', ' ')).replace('.', ',')"/>%
                    </t>
                </td>
                <td style="text-align: right; padding: 8px; border: 1px solid #ABABAB;">
                    <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                </td>
            </tr>
        </t>
<!-- Lignes vides avec uniquement les séparations verticales -->
<t t-set="empty_lines" t-value="max(10 - len(o.invoice_line_ids), 0)"/>
<t t-foreach="range(empty_lines)" t-as="i">
    <tr style="height:25px; border: none;">
        <td style="border: none; border-right:1px solid #ABABAB;">
            <div style="height:100%;">&amp;nbsp;</div>
        </td>
        <td style="border: none; border-right:1px solid #ABABAB;">
            <div style="height:100%;">&amp;nbsp;</div>
        </td>
        <td style="border: none; border-right:1px solid #ABABAB;">
            <div style="height:100%;">&amp;nbsp;</div>
        </td>
        <td style="border: none; border-right:1px solid #ABABAB;">
            <div style="height:100%;">&amp;nbsp;</div>
        </td>
        <td t-if="display_discount" style="border: none; border-right:1px solid #ABABAB;">
            <div style="height:100%;">&amp;nbsp;</div>
        </td>
        <td style="border: none; border-right:1px solid #ABABAB;">
            <div style="height:100%;">&amp;nbsp;</div>
        </td>
    </tr>
</t>
    </tbody>
</table>

<!-- Payment Conditions Table -->
<table style="width: 60%; float: left; font-size: 13px; border: none !important; border-collapse: separate !important;">
    <tr style="border: none !important;">
        <td style="border: none !important;">
            <strong>Conditions de règlement :</strong>
        </td>
        <td style="border: none !important;">
            <span t-field="o.invoice_payment_term_id.name"/>
        </td>
    </tr>
</table>

<!-- Totals Table with Left Padding Before Titles -->
<table style="width: 40%; float: right; font-size: 13px; border: none !important; border-collapse: separate !important;">
    <tr style="font-weight: bold; background-color: #F5F5F5; border: none !important;">
        <td style="padding: 2px 10px 2px 5px; text-align: left; border: none !important;">Total HT</td>
        <td style="padding: 2px 10px; text-align: right; background-color: #F5F5F5; border: none !important;">
            <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
            <span t-field="o.currency_id.symbol"/>
        </td>
    </tr>
    <tr style="background-color: #FAFAFA; border: none !important;">
        <td style="padding: 2px 10px 2px 5px; text-align: left; border: none !important;">TVA 20%</td>
        <td style="padding: 2px 10px; text-align: right; background-color: #FAFAFA; border: none !important;">
            <span t-field="o.amount_tax" t-options='{"widget": "float", "precision": 2}'/>
            <span t-field="o.currency_id.symbol"/>
        </td>
    </tr>
    <tr style="font-weight: bold; background-color: #EEEDED; border: none !important;">
        <td style="padding: 2px 10px 2px 5px; text-align: left; border: none !important;">Total TTC</td>
        <td style="padding: 2px 10px; text-align: right; background-color: #EEEDED; border: none !important;">
            <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
            <span t-field="o.currency_id.symbol"/>
        </td>
    </tr>
</table>

<!-- Amount in Words, No Borders -->
<table style="width: 100%; font-size: 13px; margin-top: 15px; border: none !important; border-collapse: separate !important;">
    <tr style="border: none !important;">
        <td style="border: none !important;">
            ARRÊTÉ LA PRÉSENTE FACTURE À LA SOMME T.T.C DE :
        </td>
    </tr>
    <tr style="padding: 10px; border: none !important;">
        <td style="border: none !important;">
            <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
        </td>
    </tr>
</table>

<!-- Signature unique de la société (comme facture MEC) -->
<t t-if="o.print_with_signature">
    <div style="margin-top: 20px; padding-left: 10px;">
        <!-- Utiliser l'image du tampon de la société si définie, sinon la signature utilisateur -->
        <t t-if="o.company_id.stamp_image">
            <img t-att-src="image_data_uri(o.company_id.stamp_image)"
                 alt="Tampon"
                 style="max-width: 300px; max-height: 150px; display: block;"/>
        </t>
        <t t-elif="o.invoice_user_id.signature_image">
            <img t-att-src="image_data_uri(o.invoice_user_id.signature_image)"
                 alt="Signature"
                 style="max-width: 300px; max-height: 150px; display: block;"/>
        </t>
    </div>
</t>

                      </div>
                    </div>
</template>

<!-- Main Template -->
<template id="report_invoice_db">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-set="doc" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-call="custom_reports.external_layout_invoice_db">
                <t t-call="custom_reports.report_invoice_db_document"/>
            </t>
        </t>
    </t>
</template>

    <!-- Report Action -->
    <record id="action_report_invoice_db" model="ir.actions.report">
        <field name="name">Facture DB</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_reports.report_invoice_db</field>
        <field name="report_file">custom_reports.report_invoice_db</field>
        <field name="print_report_name">
        (object.name and 'Facture_%s' % (object.name)) or 'Facture'
        </field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_standard"/>
    </record>
</odoo>
