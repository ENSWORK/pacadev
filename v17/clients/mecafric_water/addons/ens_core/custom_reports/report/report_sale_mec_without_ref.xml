<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================== HEADER SECTION ==================== -->
    <template id="external_layout_header_sale_order_mec_without_ref">
        <div class="header">
            <t t-if="o.company_id.header_image_mec">
                <img t-att-src="image_data_uri(o.company_id.header_image_mec)"
                     alt="Header Template MEC"
                     style="width: 100%; max-width: 100%; display: block;"/>
            </t>
        </div>
    </template>

    <template id="external_layout_footer_sale_order_mec_without_ref">
        <div class="footer">
            <t t-if="o.company_id.footer_image_mec">
                <img t-att-src="image_data_uri(o.company_id.footer_image_mec)"
                     alt="Footer Template MEC"
                     style="width: 100%; max-width: 100%; display: block;"/>
            </t>
        </div>
    </template>

    <template id="external_layout_sale_order_mec_without_ref">
        <div class="article o_report_layout_standard">
            <t t-call="custom_reports.external_layout_header_sale_order_mec_without_ref"/>
            <div class="page" style="padding-top: 15mm;">
                <t t-raw="0"/>
            </div>
            <t t-call="custom_reports.external_layout_footer_sale_order_mec_without_ref"/>
        </div>
    </template>

    <!-- ==================== DOCUMENT TEMPLATE ==================== -->
    <template id="report_sale_order_mec_without_ref_document">
        <!-- Sale Order Header Information -->

        <!-- Style coloré avec arrière-plan -->
        <t t-if="o.company_id.mec_header_style == 'colored'">
            <table t-attf-style="width:100%; border-collapse: separate; border-spacing: 0; border: 0; background-color: #{o.company_id.header_background_color or 'transparent'}; padding: 10px;">
                <tr>
                    <!-- Sale Order Details Column -->
                    <td style="width:45%; border: 0;">
                        <table style="width:100%; border-collapse: separate;">
                            <tr style="border: 0;">
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <strong style="font-size: 18px; color: white;">Devis N°: </strong><span t-field="o.name" style="font-size: 18px; color: white;"/>
                                </td>
                            </tr>
                            <tr style="border: 0;">
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <strong style="color: white;">Date: </strong><span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}' style="color: white;"/>
                                </td>
                            </tr>
                            <tr style="border: 0;">
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <t t-if="o.client_order_ref">
                                    <strong style="color: white;">Votre Référence: </strong><span t-field="o.client_order_ref" style="color: white;"/>
                                </t>
                                </td>
                            </tr>
                        </table>
                    </td>

                    <!-- Spacer Column -->
                    <td style="width:5%;"></td>

                    <!-- Customer Information Column -->
                    <td style="width:50%;">
                        <div style="padding:8px;">
                            <table style="width:100%; border-collapse: separate;">
                                <tr>
                                    <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                        <span t-field="o.partner_id.name" style="font-size: 18px; font-weight: bold; color: white;"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0; color: white;">
                                        <t t-if="o.partner_id.street">
                                            <span t-field="o.partner_id.street"/>
                                            <t t-if="o.partner_id.street2 or o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.street2">
                                            <span t-field="o.partner_id.street2"/>
                                            <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.city">
                                            <span t-field="o.partner_id.city"/>
                                            <t t-if="o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.state_id">
                                            <span t-field="o.partner_id.state_id.name"/>
                                            <t t-if="o.partner_id.zip or o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.zip">
                                            <span t-field="o.partner_id.zip"/>
                                            <t t-if="o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.country_id">
                                            <span t-field="o.partner_id.country_id.name"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0; color: white;">
                                        <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                            <strong>Tél:</strong>
                                            <t t-if="o.partner_id.phone">
                                                <span t-field="o.partner_id.phone"/>
                                            </t>
                                            <t t-if="o.partner_id.mobile">
                                                <t t-if="o.partner_id.phone"> / </t>
                                                <span t-field="o.partner_id.mobile"/>
                                            </t>
                                        </t>
                                        <t t-if="o.partner_id.email">
                                            <t t-if="o.partner_id.phone and o.partner_id.mobile">
                                                <br/>
                                            </t>
                                            <strong>Email:</strong>
                                            <span t-field="o.partner_id.email"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0; color: white;">
                                        <strong>ICE:</strong>
                                        <span t-field="o.partner_id.ice"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
            </table>
        </t>

        <!-- Style simple sans couleur -->
        <t t-if="o.company_id.mec_header_style == 'simple'">
            <table style="width:100%; border-collapse: separate; border-spacing: 0; border: 0; padding: 10px;">
                <tr>
                    <!-- Sale Order Details Column -->
                    <td style="width:45%; border: 0;">
                        <table style="width:100%; border-collapse: separate;">
                            <tr style="border: 0;">
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <strong style="font-size: 18px;">Offre N°: </strong><span t-field="o.name" style="font-size: 18px;"/>
                                </td>
                            </tr>
                            <tr style="border: 0;">
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                    <strong>Date: </strong><span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                                </td>
                            </tr>
                            <tr style="border: 0;">
                                <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                <t t-if="o.client_order_ref">
                                    <strong>Votre Référence: </strong><span t-field="o.client_order_ref"/>
                                </t>
                                </td>
                            </tr>
                        </table>
                    </td>

                    <!-- Spacer Column -->
                    <td style="width:5%;"></td>

                    <!-- Customer Information Column -->
                    <td style="width:50%;">
                        <div style="border: 1px solid black; padding:8px;">
                            <table style="width:100%; border-collapse: separate;">
                                <tr>
                                    <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0; background-color: #f9f9f9;">
                                        <span t-field="o.partner_id.name" style="font-size: 18px; font-weight: bold;"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                        <t t-if="o.partner_id.street">
                                            <span t-field="o.partner_id.street"/>
                                            <t t-if="o.partner_id.street2 or o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.street2">
                                            <span t-field="o.partner_id.street2"/>
                                            <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.city">
                                            <span t-field="o.partner_id.city"/>
                                            <t t-if="o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.state_id">
                                            <span t-field="o.partner_id.state_id.name"/>
                                            <t t-if="o.partner_id.zip or o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.zip">
                                            <span t-field="o.partner_id.zip"/>
                                            <t t-if="o.partner_id.country_id">, </t>
                                        </t>
                                        <t t-if="o.partner_id.country_id">
                                            <span t-field="o.partner_id.country_id.name"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                        <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                            <strong>Tél:</strong>
                                            <t t-if="o.partner_id.phone">
                                                <span t-field="o.partner_id.phone"/>
                                            </t>
                                            <t t-if="o.partner_id.mobile">
                                                <t t-if="o.partner_id.phone"> / </t>
                                                <span t-field="o.partner_id.mobile"/>
                                            </t>
                                        </t>
                                        <t t-if="o.partner_id.email">
                                            <t t-if="o.partner_id.phone and o.partner_id.mobile">
                                                <br/>
                                            </t>
                                            <strong>Email:</strong>
                                            <span t-field="o.partner_id.email"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 0; border-bottom: 0; border-top: 0; border-left: 0; border-right: 0;">
                                        <strong>ICE:</strong>
                                        <span t-field="o.partner_id.ice"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
            </table>
        </t>

<!-- Information Table -->
        <table style="width:100%; border-collapse: collapse; margin-top: 10px; padding: 8px; border: 1px solid white !important;">
            <tr style="border: 1px solid white !important;">
                <!-- Colonne unique -->
                <td style="width:100%; vertical-align: top; padding: 8px; border: 1px solid white !important; text-align: center;">
                    <strong><span t-field="o.company_id.closing_message"/></strong>
                </td>
            </tr>
        </table>

        <!-- Check for discount and délai -->
        <t t-set="display_discount" t-value="any(l.discount for l in o.order_line)"/>

        <!-- Add CSS classes -->
        <style>
            .order-line-even {
                background-color: #ffffff;
            }
            .order-line-odd {
                background-color: #f9f9f9;
            }
            table.no-internal-borders,
            .no-internal-borders tr,
            .no-internal-borders td,
            .no-internal-borders th {
                border: none !important;
            }
            .totals-table,
            .totals-table tr,
            .totals-table td,
            .totals-table th {
                border: none !important;
            }
            .no-border-table,
            .no-border-table tr,
            .no-border-table td,
            .no-border-table th,
            .no-border-table table,
            .no-border-table table tr,
            .no-border-table table td,
            .no-border-table table th {
                border: none !important;
            }
        </style>

        <!-- Sale Order Line Items Table -->
<!-- Sale Order Line Items Table -->
        <table class="table table-sm no-internal-borders" style="width: 100%; margin-top: 20px; border-collapse: collapse; border: 1px solid #ABABAB;">
            <thead>
                <tr style="background-color: #f8f9fa;">
                    <th style="width: 5%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">N°</th>
                    <th style="width: 50%; padding: 8px; white-space: normal; word-wrap: break-word; background-color: #f8f9fa; border: none;">Description d'article</th>
                    <th style="width: 5%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">Qté</th>
<t t-if="any(line.ourdelai and line.ourdelai.strip() for line in o.order_line)">
    <th style="width: 10%; text-align: center; padding: 8px; background-color: #f8f9fa; border: none;">Délai</th>
</t>
                    <th style="width: 10%; text-align: right; padding: 8px; background-color: #f8f9fa; border: none;">PU Net</th>
                    <th t-if="any(line.discount != 0 for line in o.order_line)"
                        style="width: 5%; text-align: center; background-color: #f8f9fa; border: none;">Remise</th>
                    <th style="width: 15%; text-align: right; padding: 8px; background-color: #f8f9fa; border: none;">Total HT</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o.order_line" t-as="line" t-att-class="line_index % 2 == 0 and 'order-line-even' or 'order-line-odd'" style="border: none;">
                    <td style="padding: 8px; text-align: center; border: none; vertical-align: middle; font-size: 13px;">
                        <span t-esc="line.sequence"/>
                    </td>
                    <td style="padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                    </td>
                    <td style="text-align: center; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <t t-set="qty_str" t-value="'{:.2f}'.format(line.product_uom_qty)"/>
                        <span t-esc="qty_str.rstrip('0').rstrip('.') if qty_str.endswith('.00') else qty_str"/>
                        <span t-field="line.product_uom.name" style="font-size: smaller; color: #666666;"/>
                    </td>
<t t-if="any(line.ourdelai and line.ourdelai.strip() for line in o.order_line)">
    <td style="text-align: center; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
        <t t-if="line.ourdelai and line.ourdelai.strip()">
            <span t-field="line.ourdelai"/>
        </t>
    </td>
</t>
                    <td style="text-align: right; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                    <td t-if="any(line.discount for line in o.order_line)"
                        style="text-align: center; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <t t-if="line.discount">
                            <t t-set="discount_str" t-value="'{:.2f}'.format(line.discount)"/>
                            <span t-esc="discount_str.rstrip('0').rstrip('.') if discount_str.endswith('.00') else discount_str"/>%
                        </t>
                    </td>
                    <td style="text-align: right; padding: 8px; border: none; vertical-align: middle; font-size: 13px;">
                        <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Style pour supprimer les bordures -->
        <style>
            .no-border-table {
                border: none !important;
            }
            .no-border-table tr {
                border: none !important;
            }
            .no-border-table td {
                border: none !important;
            }
        </style>

        <!-- Montant en lettres et Totaux -->
        <table class="no-border-table" style="width: 100%; margin-top: 15px; margin-bottom: 15px; border-collapse: collapse; border: 1px solid white !important;">
            <tr style="border: 1px solid white !important;">
                <!-- Section Gauche -->
                <td style="width: 70%; vertical-align: top; padding: 10px; padding-right: 20px; border: 1px solid white !important;">
                    <!-- Conditions de paiement -->
                    <t t-if="o.payment_term_id">
                        <strong>Conditions de paiement : </strong>
                        <span t-field="o.payment_term_id"/><br/>
                    </t>
                    <t t-if="o.validity_date">
                        <strong>Expiration : </strong>
                        <span t-field="o.validity_date" t-options='{"widget": "date", "format": "dd.MM.yyyy"}'/><br/>
                    </t>
                    <t t-if="o.commitment_date">
                        <strong>Date de livraison : </strong>
                        <span t-field="o.commitment_date" t-options='{"widget": "date", "format": "dd.MM.yyyy"}'/><br/>
                    </t>
                </td>

                <!-- Section des totaux -->
                <td style="width: 30%; vertical-align: top; border: 1px solid white !important;">
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid white !important;">
                        <!-- Total HT -->
                        <tr style="font-weight: bold; background-color: #F5F5F5; border: 1px solid white !important;">
                            <td style="padding: 2px 8px; text-align: left; border: 1px solid white !important;">Total HT</td>
                            <td style="padding: 2px 8px; text-align: right; background-color: #F5F5F5; border: 1px solid white !important;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                                <span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>

                        <!-- TVA dynamique regroupée par taux -->
                        <t t-set="tax_dict" t-value="{}" />
                        <!-- Calcul des totaux par taux de TVA -->
                        <t t-foreach="o.order_line" t-as="line">
                            <t t-foreach="line.tax_id" t-as="tax">
                                <t t-if="str(tax.amount) not in tax_dict">
                                    <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): 0})" />
                                </t>
                                <t t-set="current_tax" t-value="tax_dict[str(tax.amount)] + line.price_subtotal * (tax.amount / 100.0)" />
                                <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): current_tax})" />
                            </t>
                        </t>

                        <!-- Affichage des totaux de TVA -->
                        <t t-foreach="tax_dict.items()" t-as="tax_item">
                            <tr style="background-color: #FAFAFA; border: 1px solid white !important;">
                                <td style="padding: 2px 8px; text-align: left; border: 1px solid white !important;">
                                    TVA <t t-esc="int(float(tax_item[0]))"/>%
                                </td>
                                <td style="padding: 2px 8px; text-align: right; background-color: #FAFAFA; border: 1px solid white !important;">
                                    <span t-esc="tax_item[1]" t-options='{"widget": "float", "precision": 2}'/>
                                    <span t-field="o.currency_id.symbol"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Total TTC -->
                        <tr style="font-weight: bold; background-color: #EEEDED; border: 1px solid white !important;">
                            <td style="padding: 2px 8px; text-align: left; border: 1px solid white !important;">Total TTC</td>
                            <td style="padding: 2px 8px; text-align: right; background-color: #EEEDED; border: 1px solid white !important;">
                                <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                                <span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- Signature en dehors du tableau -->
        <t t-if="o.user_id.signature_image">
            <div style="margin-top: 20px; padding-left: 10px;">
                <img t-att-src="image_data_uri(o.user_id.signature_image)"
                     alt="Signature"
                     style="max-width: 300px; max-height: 120px; display: block;"/>
            </div>
        </t>
    </template>

    <!-- ==================== MAIN REPORT TEMPLATE ==================== -->
    <template id="report_sale_order_mec_without_ref">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_reports.external_layout_sale_order_mec_without_ref">
                    <t t-call="custom_reports.report_sale_order_mec_without_ref_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ==================== REPORT ACTION ==================== -->
    <record id="action_report_sale_order_mec_without_ref" model="ir.actions.report">
        <field name="name">Offre MEC sans réf</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_reports.report_sale_order_mec_without_ref</field>
        <field name="report_file">custom_reports.report_sale_order_mec_without_ref</field>
        <field name="print_report_name">'Devis - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ==================== PAPER FORMAT ==================== -->
    <!-- Assign Paper Format to Report -->
    <record id="action_report_sale_order_mec_without_ref" model="ir.actions.report">
        <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_without_ref"/>
    </record>
</odoo>
