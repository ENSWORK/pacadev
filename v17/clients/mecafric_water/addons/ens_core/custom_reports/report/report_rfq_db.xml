<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Header Template -->
   <template id="external_layout_header_rfq">
       <div class="row" style="margin-bottom: 0;">
           <div class="col-3">
               <t t-if="o.company_id.logo">
                   <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" t-attf-style="max-height: #{o.company_id.logo_height}px; max-width: #{o.company_id.logo_width}px;"/>
               </t>
           </div>
          <div class="col-9 text-end">
            <div style="font-family: Arial, sans-serif; line-height: 1.1;">
                <strong t-attf-style="font-size: 18px; color: #{o.company_id.primary_color}">DEMANDE DE PRIX - </strong>
                <strong style="font-size: 18px;" t-field="o.name" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                <div style="font-size: 14px">
                    <strong t-attf-style="color: #{o.company_id.primary_color}">Date : </strong>
                    <span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}' t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                    <strong t-attf-style="color: #{o.company_id.primary_color}">Code fournisseur : </strong>
                    <span t-field="o.partner_id.ref" t-attf-style="color: #{o.company_id.primary_color}"/>
                </div>
            </div>
        </div>
       </div>
   </template>

   <!-- Footer Template -->
   <template id="external_layout_footer_rfq">
        <div class="text-center" style="font-size: 13px; border-top: 1px solid #ABABAB; padding-top: 4px; line-height: 1.1;">
            <!-- Pagination en haut à droite -->
            <div style="margin-bottom: 10px;">
                <span style="float: right; font-size: 13px;">Page N° <span class="page"/>/<span class="topage"/></span>
                <div style="clear: both;"></div>
            </div>

            <!-- Image footer optionnelle (comme MEC) -->
            <t t-if="o.company_id.footer_image_db">
                <img t-att-src="image_data_uri(o.company_id.footer_image_db)" alt="Footer" style="width: 100%; max-height: 120px; display: block; margin-bottom: 10px;"/>
            </t>

            <!-- Texte footer par défaut si pas d'image -->
            <t t-if="not o.company_id.footer_image_db or o.company_id.footer_db_type == 'text'">
                <div class="row mt-2">
                    <div class="col-12 text-center" style="font-size: 12px;">
                        <t t-if="o.company_id.name">
                            <span t-field="o.company_id.name"/> SARL AU - Capital de <span t-field="o.company_id.capital"/> MAD
                        </t>
                        <div style="margin-top:1px;">
                            <span t-field="o.company_id.street"/>, <span t-field="o.company_id.city"/>, <span t-field="o.company_id.country_id.name"/>
                        </div>
                        <div style="margin-top:1px;">
                            R.C.: <span t-field="o.company_id.company_registry"/> - Patente: <span t-field="o.company_id.tp"/>
                            - I.F.: <span t-field="o.company_id.vat"/> - C.N.S.S.: <span t-field="o.company_id.cnss"/> - I.C.E.: <span t-field="o.company_id.ice"/>
                        </div>
                        <div style="margin-top:1px;">
                            Email: <span t-field="o.company_id.email"/> - Site web: <span t-field="o.company_id.website"/>
                        </div>
                    </div>
                </div>
            </t>
       </div>
   </template>

   <!-- Layout Template -->
   <template id="external_layout_rfq">
       <div t-attf-class="header" style="border-bottom: 0px solid black;">
           <t t-call="custom_reports.external_layout_header_rfq"/>
       </div>

       <div class="article o_report_layout_standard">
           <t t-raw="0"/>
       </div>

       <div t-attf-class="footer">
           <t t-call="custom_reports.external_layout_footer_rfq"/>
       </div>
   </template>

   <!-- Main Template -->
   <template id="report_rfq_db">
       <t t-call="web.html_container">
           <t t-foreach="docs" t-as="o">
               <t t-call="custom_reports.external_layout_rfq">
                   <div class="page">
                       <!-- Émetteur/Destinataire Section -->
                       <div class="mt-4">
                           <table class="mb-4" style="width:100%;border-collapse: separate; border-spacing: 0;">
                               <tr>
                                   <td style="width:45%;background-color:#EEEDED;padding:10px;">
                                       <div style="line-height: 1.5;">
                                           <strong t-field="o.company_id.name" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                           <t t-if="o.company_id.street">
                                               <span t-field="o.company_id.street" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                           </t>
                                           <t t-if="o.company_id.street2">
                                               <span t-field="o.company_id.street2" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                           </t>
                                           <span t-field="o.company_id.city" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                           <div class="mt-2">
                                               <t t-if="o.company_id.phone">
                                                   <strong t-attf-style="color: #{o.company_id.primary_color}">Tél.: </strong>
                                                   <span t-field="o.company_id.phone" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                               </t>
                                               <t t-if="o.company_id.email">
                                                   <strong t-attf-style="color: #{o.company_id.primary_color}">Email: </strong>
                                                   <span t-field="o.company_id.email" t-attf-style="color: #{o.company_id.primary_color}"/>
                                               </t>
                                           </div>
                                       </div>
                                   </td>
                                   <td style="width:5%;border:0px;"> </td>
                                   <td style="width:50%;border:1px solid #ABABAB;padding:15px;">
                                       <div style="line-height: 1.5;">
                                           <strong t-field="o.partner_id"/><br/>
                                           <t t-if="o.partner_id.street">
                                               <span t-field="o.partner_id.street"/><br/>
                                           </t>
                                           <t t-if="o.partner_id.street2">
                                               <span t-field="o.partner_id.street2"/><br/>
                                           </t>
                                           <t t-if="o.partner_id.city">
                                               <span t-field="o.partner_id.city"/>
                                           </t>
                                           <t t-if="o.partner_id.zip">
                                               <span t-field="o.partner_id.zip"/>
                                           </t>
                                           <br/>
                                           <t t-if="o.partner_id.phone">
                                               <strong>Tél.: </strong><span t-field="o.partner_id.phone"/><br/>
                                           </t>
                                           <t t-if="o.partner_id.email">
                                               <strong>Email: </strong><span t-field="o.partner_id.email"/>
                                           </t>
                                       </div>
                                   </td>
                               </tr>
                           </table>

                           <!-- Main Table -->
                           <table class="table table-sm" style="margin-top:5px;border:1px solid #ABABAB; font-size: 14px;">
                               <thead>
                                   <tr>
                                       <t t-if="o.print_with_line_number">
                                           <th style="width:5%;text-align:center;padding:8px;border:1px solid #ABABAB;font-size:14px;">N°</th>
                                       </t>
                                       <t t-if="o.print_with_ref">
                                           <th style="width:15%;padding:8px;border:1px solid #ABABAB;font-size:14px;">Référence</th>
                                       </t>
                                       <th t-attf-style="width:#{(o.print_with_ref and o.print_with_expected_date and '45%') or (o.print_with_ref or o.print_with_expected_date and '60%') or '75%'};padding:8px;border:1px solid #ABABAB;font-size:14px;">Désignation</th>
                                       <t t-if="o.print_with_expected_date">
                                           <th style="width:15%;text-align:center;border:1px solid #ABABAB;font-size:14px;">Date prévue</th>
                                       </t>
                                       <th style="width:10%;text-align:center;border:1px solid #ABABAB;font-size:14px;">Quantité</th>
                                   </tr>
                               </thead>
                               <tbody>
                                   <t t-foreach="o.order_line" t-as="line">
                                       <tr style="height:30px;">
                                           <t t-if="o.print_with_line_number">
                                               <td style="text-align:center;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                                   <span t-esc="line_index + 1"/>
                                               </td>
                                           </t>
                                           <t t-if="o.print_with_ref">
                                               <td style="padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                                   <span t-field="line.product_id.default_code"/>
                                               </td>
                                           </t>
                                           <td style="padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                               <span t-field="line.name"/>
                                           </td>
                                           <t t-if="o.print_with_expected_date">
                                               <td style="text-align:center;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                                   <span t-field="line.date_planned" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                               </td>
                                           </t>
                                           <td style="text-align:center;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                               <t t-set="qty_str" t-value="'{:.2f}'.format(line.product_qty)"/>
                                               <span t-esc="qty_str.rstrip('0').rstrip('.') if qty_str.endswith('.00') else qty_str"/>
                                               <span t-field="line.product_uom.name" style="font-size: smaller; color: #666666;"/>
                                           </td>
                                       </tr>
                                   </t>
                                   <!-- Lignes vides -->
                                   <t t-set="empty_lines" t-value="max(10 - len(o.order_line), 0)"/>
                                   <t t-set="nb_cols" t-value="(o.print_with_line_number and 1 or 0) + (o.print_with_ref and 1 or 0) + 1 + (o.print_with_expected_date and 1 or 0) + 1"/>
                                   <t t-foreach="range(empty_lines)" t-as="i">
                                       <tr style="height:25px; border: none;">
                                           <t t-foreach="range(nb_cols)" t-as="col">
                                               <td style="border: none; border-right:1px solid #ABABAB;">
                                                   <div style="height:100%;">&amp;nbsp;</div>
                                               </td>
                                           </t>
                                       </tr>
                                   </t>
                               </tbody>
                           </table>

                           <!-- Conditions and Notes -->
                           <div class="row" style="margin-top:10px;">
                               <div class="col-12">
                                   <t t-if="o.payment_term_id">
                                       <div style="margin-bottom:5px;">
                                           <strong>Conditions de règlement: </strong>
                                           <span t-field="o.payment_term_id"/>
                                       </div>
                                   </t>
                                   <t t-if="o.incoterm_id">
                                       <div style="margin-bottom:5px;">
                                           <strong>Conditions de livraison: </strong>
                                           <span t-field="o.incoterm_id.name"/>
                                       </div>
                                   </t>
                                   <t t-if="o.notes">
                                       <div style="margin-top:10px; padding:10px; border:1px solid #ddd; background-color:#f9f9f9;">
                                           <strong>Notes: </strong><br/>
                                           <span t-field="o.notes"/>
                                       </div>
                                   </t>
                               </div>
                           </div>
                       </div>
                   </div>
               </t>
           </t>
       </t>
   </template>

   <!-- Template document utilisé par le rapport dynamique (SANS boucle sur docs) -->
   <template id="report_rfq_db_document">
       <div class="page">
           <!-- Émetteur/Destinataire Section -->
           <div class="mt-4">
               <table class="mb-4" style="width:100%;border-collapse: separate; border-spacing: 0;">
                   <tr>
                       <td style="width:45%;background-color:#EEEDED;padding:10px;">
                           <div style="line-height: 1.5;">
                               <strong t-field="o.company_id.name" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                               <t t-if="o.company_id.street">
                                   <span t-field="o.company_id.street" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                               </t>
                               <t t-if="o.company_id.street2">
                                   <span t-field="o.company_id.street2" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                               </t>
                               <span t-field="o.company_id.city" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                               <div class="mt-2">
                                   <t t-if="o.company_id.phone">
                                       <strong t-attf-style="color: #{o.company_id.primary_color}">Tél.: </strong>
                                       <span t-field="o.company_id.phone" t-attf-style="color: #{o.company_id.primary_color}"/><br/>
                                   </t>
                                   <t t-if="o.company_id.email">
                                       <strong t-attf-style="color: #{o.company_id.primary_color}">Email: </strong>
                                       <span t-field="o.company_id.email" t-attf-style="color: #{o.company_id.primary_color}"/>
                                   </t>
                               </div>
                           </div>
                       </td>
                       <td style="width:5%;border:0px;"> </td>
                       <td style="width:50%;border:1px solid #ABABAB;padding:15px;">
                           <div style="line-height: 1.5;">
                               <strong t-field="o.partner_id"/><br/>
                               <t t-if="o.partner_id.street">
                                   <span t-field="o.partner_id.street"/><br/>
                               </t>
                               <t t-if="o.partner_id.street2">
                                   <span t-field="o.partner_id.street2"/><br/>
                               </t>
                               <t t-if="o.partner_id.city">
                                   <span t-field="o.partner_id.city"/>
                               </t>
                               <t t-if="o.partner_id.zip">
                                   <span t-field="o.partner_id.zip"/>
                               </t>
                               <br/>
                               <t t-if="o.partner_id.phone">
                                   <strong>Tél.: </strong><span t-field="o.partner_id.phone"/><br/>
                               </t>
                               <t t-if="o.partner_id.email">
                                   <strong>Email: </strong><span t-field="o.partner_id.email"/>
                               </t>
                           </div>
                       </td>
                   </tr>
               </table>

               <!-- Main Table -->
               <table class="table table-sm" style="margin-top:5px;border:1px solid #ABABAB; font-size: 14px;">
                   <thead>
                       <tr>
                           <t t-if="o.print_with_line_number">
                               <th style="width:5%;text-align:center;padding:8px;border:1px solid #ABABAB;font-size:14px;">N°</th>
                           </t>
                           <t t-if="o.print_with_ref">
                               <th style="width:15%;padding:8px;border:1px solid #ABABAB;font-size:14px;">Référence</th>
                           </t>
                           <th t-attf-style="width:#{(o.print_with_ref and o.print_with_expected_date and '45%') or (o.print_with_ref or o.print_with_expected_date and '60%') or '75%'};padding:8px;border:1px solid #ABABAB;font-size:14px;">Désignation</th>
                           <t t-if="o.print_with_expected_date">
                               <th style="width:15%;text-align:center;border:1px solid #ABABAB;font-size:14px;">Date prévue</th>
                           </t>
                           <th style="width:10%;text-align:center;border:1px solid #ABABAB;font-size:14px;">Quantité</th>
                       </tr>
                   </thead>
                   <tbody>
                       <t t-foreach="o.order_line" t-as="line">
                           <tr style="height:30px;">
                               <t t-if="o.print_with_line_number">
                                   <td style="text-align:center;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                       <span t-esc="line_index + 1"/>
                                   </td>
                               </t>
                               <t t-if="o.print_with_ref">
                                   <td style="padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                       <span t-field="line.product_id.default_code"/>
                                   </td>
                               </t>
                               <td style="padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                   <span t-field="line.name"/>
                               </td>
                               <t t-if="o.print_with_expected_date">
                                   <td style="text-align:center;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                       <span t-field="line.date_planned" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                   </td>
                               </t>
                               <td style="text-align:center;padding:8px;border-right:1px solid #ABABAB;border-bottom:1px solid #ABABAB;">
                                   <t t-set="qty_str" t-value="'{:.2f}'.format(line.product_qty)"/>
                                   <span t-esc="qty_str.rstrip('0').rstrip('.') if qty_str.endswith('.00') else qty_str"/>
                                   <span t-field="line.product_uom.name" style="font-size: smaller; color: #666666;"/>
                               </td>
                           </tr>
                       </t>
                       <!-- Lignes vides -->
                       <t t-set="empty_lines" t-value="max(10 - len(o.order_line), 0)"/>
                       <t t-set="nb_cols" t-value="(o.print_with_line_number and 1 or 0) + (o.print_with_ref and 1 or 0) + 1 + (o.print_with_expected_date and 1 or 0) + 1"/>
                       <t t-foreach="range(empty_lines)" t-as="i">
                           <tr style="height:25px; border: none;">
                               <t t-foreach="range(nb_cols)" t-as="col">
                                   <td style="border: none; border-right:1px solid #ABABAB;">
                                       <div style="height:100%;">&amp;nbsp;</div>
                                   </td>
                               </t>
                           </tr>
                       </t>
                   </tbody>
               </table>

               <!-- Conditions and Notes -->
               <div class="row" style="margin-top:10px;">
                   <div class="col-12">
                       <t t-if="o.payment_term_id">
                           <div style="margin-bottom:5px;">
                               <strong>Conditions de règlement: </strong>
                               <span t-field="o.payment_term_id"/>
                           </div>
                       </t>
                       <t t-if="o.incoterm_id">
                           <div style="margin-bottom:5px;">
                               <strong>Conditions de livraison: </strong>
                               <span t-field="o.incoterm_id.name"/>
                           </div>
                       </t>
                       <t t-if="o.notes">
                           <div style="margin-top:10px; padding:10px; border:1px solid #ddd; background-color:#f9f9f9;">
                               <strong>Notes: </strong><br/>
                               <span t-field="o.notes"/>
                           </div>
                       </t>
                   </div>
               </div>
           </div>
       </div>
   </template>

   <record id="action_report_rfq_db" model="ir.actions.report">
       <field name="name">RFQ DB</field>
       <field name="model">purchase.order</field>
       <field name="report_type">qweb-pdf</field>
       <field name="report_name">custom_reports.report_rfq_db</field>
       <field name="report_file">custom_reports.report_rfq_db</field>
       <field name="print_report_name">'Demande de prix - %s' % (object.name)</field>
       <field name="binding_model_id" eval="False"/>
       <field name="binding_type">report</field>
       <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_standard"/>
   </record>

</odoo>
