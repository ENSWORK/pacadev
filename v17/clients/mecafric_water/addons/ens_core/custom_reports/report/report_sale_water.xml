<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================== HEADER ==================== -->
    <template id="external_layout_header_sale_order_water">
        <div class="header">
            <t t-if="o.company_id.mec_header_type == 'image' and o.company_id.header_image_mec">
                <img t-att-src="image_data_uri(o.company_id.header_image_mec)"
                     alt="Header"
                     style="width:100%; max-width:100%; max-height:40mm; object-fit:contain; display:block;"/>
            </t>
            <t t-elif="o.company_id.logo">
                <img t-att-src="image_data_uri(o.company_id.logo)"
                     alt="Logo"
                     t-attf-style="max-height:#{o.company_id.logo_height}px; max-width:#{o.company_id.logo_width}px; display:block;"/>
            </t>
        </div>
    </template>

    <!-- ==================== FOOTER ==================== -->
    <template id="external_layout_footer_sale_order_water">
        <div class="footer" style="min-height:35mm; position:relative;">
            <t t-if="o.company_id.footer_image_mec">
                <img t-att-src="image_data_uri(o.company_id.footer_image_mec)"
                     alt="Footer"
                     style="width:100%; max-width:100%; display:block;"/>
            </t>
            <div style="position:absolute; bottom:3px; right:0;">
                <span style="font-size:11px;">Page <span class="page"/>/<span class="topage"/></span>
            </div>
        </div>
    </template>

    <!-- ==================== LAYOUT WRAPPER ==================== -->
    <template id="external_layout_sale_order_water">
        <div class="article o_report_layout_standard">
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_header_sale_order_water"/>
            </t>
            <t t-raw="0"/>
            <t t-if="o.print_with_header">
                <t t-call="custom_reports.external_layout_footer_sale_order_water"/>
            </t>
        </div>
    </template>

    <!-- ==================== DOCUMENT ==================== -->
    <template id="report_sale_order_water_document">

        <style>
            .water-sale-even { background-color: #ffffff; }
            .water-sale-odd  { background-color: #f7fbff; }
        </style>

        <!-- Blocs info : document (gauche) + client (droite) -->
        <table style="width:100%; border-collapse:collapse; border:none; margin-top:15px;">
            <tr>
                <!-- LEFT : infos document -->
                <td style="width:48%; vertical-align:top; background-color:#EBF5FB; padding:10px 12px;">
                    <div style="font-size:17px; font-weight:bold; color:#0056A6; margin-bottom:8px;">OFFRE COMMERCIALE</div>
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>N°</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;"><span t-field="o.name"/></td>
                        </tr>
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>Date</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;"><span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}'/></td>
                        </tr>
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>Validité de l'offre</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;">
                                <t t-if="o.validity_date">
                                    <t t-set="valid_days" t-value="(o.validity_date - o.date_order.date()).days"/>
                                    <span t-esc="valid_days"/> jours
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>Condition de livraison</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;">
                                <t t-if="o.incoterm"><span t-field="o.incoterm.name"/></t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>Conditions de paiement</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;">
                                <t t-if="o.payment_term_id"><span t-field="o.payment_term_id"/></t>
                            </td>
                        </tr>
                    </table>
                </td>

                <td style="width:4%; border:none;"></td>

                <!-- RIGHT : infos client -->
                <td style="width:48%; vertical-align:top; background-color:#EBF5FB; padding:10px 12px;">
                    <div style="font-size:17px; font-weight:bold; color:#0056A6; margin-bottom:8px;">
                        <span t-field="o.partner_id.name"/>
                    </div>
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>Code client</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;">
                                <t t-if="o.partner_id.ref"><span t-field="o.partner_id.ref"/></t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>Adresse</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;">
                                <t t-if="o.partner_id.street"><span t-field="o.partner_id.street"/></t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>Tél.</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;">
                                <t t-if="o.partner_id.phone"><span t-field="o.partner_id.phone"/></t>
                                <t t-elif="o.partner_id.mobile"><span t-field="o.partner_id.mobile"/></t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:none; padding:4px 0; white-space:nowrap;"><strong>ICE</strong> :</td>
                            <td style="border:none; padding:4px 0; padding-left:5px;"><span t-field="o.partner_id.ice"/></td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- Message de remerciement -->
        <div style="margin-top:15px; text-align:center; font-weight:bold; text-decoration:underline; font-size:15px;">
            Nous vous remercions de votre demande et vous prions de bien vouloir trouver ci-dessous notre meilleure offre.
        </div>

        <!-- Tableau des lignes -->
        <table style="width:100%; margin-top:12px; border-collapse:collapse;">
            <thead>
                <tr style="background-color:#f0f0f0; font-weight:bold; text-align:center;">
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:5%; vertical-align:middle;">N°</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:15%; vertical-align:middle;">Référence</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; text-align:center; vertical-align:middle;">Désignation</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:8%; white-space:nowrap; vertical-align:middle;">Qté</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:12%; white-space:nowrap; text-align:right; vertical-align:middle;">P.H.HT</th>
                    <th style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; width:12%; white-space:nowrap; text-align:right; vertical-align:middle;">Total HT</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o.order_line" t-as="line"
                    t-att-class="line_index % 2 == 0 and 'water-sale-even' or 'water-sale-odd'">
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:center; font-size:14px; vertical-align:middle;">
                        <span t-esc="line_index + 1"/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:center; font-size:14px; vertical-align:middle;">
                        <span t-field="line.product_id.default_code"/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; font-size:14px; vertical-align:middle; text-align:center;">
                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:center; font-size:14px; white-space:nowrap; vertical-align:middle;">
                        <t t-set="qty_str" t-value="'{:.2f}'.format(line.product_uom_qty)"/>
                        <span t-esc="qty_str.rstrip('0').rstrip('.') if qty_str.endswith('.00') else qty_str"/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:right; font-size:14px; white-space:nowrap; vertical-align:middle;">
                        <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                    <td style="padding:7px 5px; border:1px solid #BBBBBB; text-align:right; font-size:14px; white-space:nowrap; vertical-align:middle;">
                        <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Totaux et Signature -->
        <t t-set="tax_dict" t-value="{}"/>
        <t t-foreach="o.order_line" t-as="line">
            <t t-foreach="line.tax_id" t-as="tax">
                <t t-if="str(tax.amount) not in tax_dict">
                    <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): 0})"/>
                </t>
                <t t-set="current_tax" t-value="tax_dict[str(tax.amount)] + line.price_subtotal * (tax.amount / 100.0)"/>
                <t t-set="tax_dict" t-value="dict(tax_dict, **{str(tax.amount): current_tax})"/>
            </t>
        </t>

        <table style="width:100%; margin-top:10px; border-collapse:collapse;">
            <tr>
                <!-- Signature à gauche -->
                <td style="width:65%; vertical-align:middle; text-align:center; padding-right:20px;">
                    <t t-if="o.print_with_signature">
                        <div style="text-align:center;">
                            <t t-if="o.company_id.stamp_image">
                                <img t-att-src="image_data_uri(o.company_id.stamp_image)"
                                     alt="Tampon"
                                     style="max-width:250px; max-height:160px; display:inline-block;"/>
                            </t>
                            <t t-elif="o.user_id.signature_image">
                                <img t-att-src="image_data_uri(o.user_id.signature_image)"
                                     alt="Signature"
                                     style="max-width:250px; max-height:160px; display:inline-block;"/>
                            </t>
                        </div>
                    </t>
                </td>
                <!-- Totaux à droite -->
                <td style="width:35%; vertical-align:top;">
                    <table style="width:100%; border-collapse:collapse; font-size:14px;">
                        <tr style="background-color:#f0f0f0;">
                            <td style="padding:5px 10px; border:1px solid #BBBBBB; font-weight:bold; white-space:nowrap;">TOTAL HT</td>
                            <td style="padding:5px 10px; border:1px solid #BBBBBB; text-align:right; font-weight:bold; white-space:nowrap;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                                <span> </span><span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>
                        <t t-foreach="tax_dict.items()" t-as="tax_item">
                            <tr>
                                <td style="padding:5px 10px; border:1px solid #BBBBBB; white-space:nowrap;">
                                    TVA <t t-esc="int(float(tax_item[0]))"/>%
                                </td>
                                <td style="padding:5px 10px; border:1px solid #BBBBBB; text-align:right; white-space:nowrap;">
                                    <span t-esc="tax_item[1]" t-options='{"widget": "float", "precision": 2}'/>
                                    <span> </span><span t-field="o.currency_id.symbol"/>
                                </td>
                            </tr>
                        </t>
                        <tr style="background-color:#f0f0f0;">
                            <td style="padding:5px 10px; border:1px solid #BBBBBB; font-weight:bold; white-space:nowrap;">TOTAL TTC</td>
                            <td style="padding:5px 10px; border:1px solid #BBBBBB; text-align:right; font-weight:bold; white-space:nowrap;">
                                <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                                <span> </span><span t-field="o.currency_id.symbol"/>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

    </template>

    <!-- ==================== RAPPORT PRINCIPAL ==================== -->
    <template id="report_sale_order_water">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_reports.external_layout_sale_order_water">
                    <t t-call="custom_reports.report_sale_order_water_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ==================== ACTION ==================== -->
    <record id="action_report_sale_order_water" model="ir.actions.report">
        <field name="name">Offre WATER</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_reports.report_sale_order_water</field>
        <field name="report_file">custom_reports.report_sale_order_water</field>
        <field name="print_report_name">'Devis - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_water"/>
    </record>
</odoo>
