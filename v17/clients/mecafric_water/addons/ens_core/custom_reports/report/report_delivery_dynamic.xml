<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_dynamic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Sélection du layout en fonction des options (template de la société, options du document) -->
                <t t-if="o.company_id.print_template == 'odoo'">
                    <!-- Utiliser le template natif d'Odoo -->
                    <t t-call="web.external_layout">
                        <t t-call="stock.report_delivery_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'ens'">
                    <t t-call="custom_reports.external_layout_delivery_ens">
                        <t t-call="custom_reports.report_delivery_ens_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'mec'">
                    <t t-call="custom_reports.external_layout_delivery_mec">
                        <t t-call="custom_reports.report_delivery_mec_document"/>
                    </t>
                </t>
                <t t-elif="o.company_id.print_template == 'water'">
                    <t t-call="custom_reports.external_layout_delivery_water">
                        <t t-call="custom_reports.report_delivery_water_document"/>
                    </t>
                </t>
                <t t-else="">
                    <!-- Template DB - toujours avec layout, le header gère l'affichage du logo -->
                    <t t-call="custom_reports.external_layout_delivery">
                        <t t-call="custom_reports.report_delivery_db_document"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

<record id="action_report_delivery_dynamic" model="ir.actions.report">
    <field name="name">Print Bon de Livraison</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">custom_reports.report_delivery_dynamic</field>
    <field name="report_file">custom_reports.report_delivery_dynamic</field>
    <field name="print_report_name">'BL - %s' % (object.name)</field>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="custom_reports.paperformat_custom_reports_water"/>
</record>


</odoo>
