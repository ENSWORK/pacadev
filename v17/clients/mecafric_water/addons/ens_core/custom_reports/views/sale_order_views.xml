<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_form_inherit_custom" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='sequence']" position="after">
                <field name="sl_no" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="after">
                <field name="ourdelai"/>
            </xpath>
            <!-- Pour le formulaire -->
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="ourdelai"/>
            </xpath>
            <!-- Add Projet field after payment_term_id -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="show_projet_field" invisible="1"/>
                <field name="projet" invisible="not show_projet_field"/>
            </xpath>
            <!-- Add print options tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Options d'impression">
                    <group>
                        <group string="Paramètres d'impression">
                            <field name="print_with_ref"/>
                            <field name="print_with_header"/>
                            <field name="print_with_line_number"/>
                            <field name="print_with_signature"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
