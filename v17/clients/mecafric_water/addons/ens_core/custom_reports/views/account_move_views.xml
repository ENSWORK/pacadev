<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ajouter les options d'impression à la facture -->
    <record id="view_move_form_inherit_print_options" model="ir.ui.view">
        <field name="name">account.move.form.print.options</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Options d'impression" name="print_options">
                    <group>
                        <group string="Affichage">
                            <field name="print_with_header"/>
                            <field name="print_with_ref"/>
                            <field name="print_with_line_number"/>
                            <field name="print_with_signature"/>
                            <field name="print_with_representative"/>
                        </group>
                        <group string="Détails produit (Template DB)">
                            <field name="print_with_brand"/>
                            <field name="print_with_origin"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
