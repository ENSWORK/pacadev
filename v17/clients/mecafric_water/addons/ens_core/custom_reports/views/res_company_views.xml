<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_custom_reports" model="ir.ui.view">
        <field name="name">res.company.form.custom.reports</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Options d'impression">
                    <group>
                        <group string="Paramètres d'impression">
                            <field name="print_template"/>
                            <field name="closing_message" placeholder="Nous vous remercions de votre attention"/>
                            <field name="primary_color" widget="color" string="Couleur primaire"/>
                            <field name="header_background_color" widget="color" string="Couleur arrière-plan entête"/>
                            <field name="report_show_project"/>
                        </group>
                    </group>
                    <separator string="Options de configuration MEC"/>
                    <group>
                        <group string="Configuration de l'en-tête">
                            <field name="mec_header_type"/>
                            <field name="mec_header_style"/>
                        </group>
                        <group string="Options d'affichage">
                            <field name="mec_show_closing_message"/>
                        </group>
                    </group>
                    <separator string="Images Template MEC - Devis"/>
                    <group>
                        <group string="En-tête Template MEC">
                            <field name="header_image_mec" widget="image" class="oe_avatar"/>
                        </group>
                        <group string="Pied de page Template MEC">
                            <field name="footer_image_mec" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <separator string="Images Template MEC - Factures"/>
                    <group>
                        <group string="Configuration header facture">
                            <field name="invoice_mec_header_type"/>
                            <field name="header_image_invoice_mec" widget="image" class="oe_avatar" invisible="invoice_mec_header_type != 'image'"/>
                        </group>
                        <group string="Tampon/Cachet">
                            <field name="stamp_image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <separator string="Configuration Pied de page DB"/>
                    <group>
                        <group string="Type de pied de page">
                            <field name="footer_db_type" widget="radio"/>
                            <field name="footer_image_db" widget="image" class="oe_avatar" invisible="footer_db_type != 'image'"/>
                        </group>
                        <group string="Contenu personnalisé">
                            <field name="footer_text_db" invisible="footer_db_type != 'text'" nolabel="1" placeholder="Laissez vide pour utiliser les informations fiscales par défaut"/>
                        </group>
                    </group>
                    <separator string="Configuration Facture DB"/>
                    <group>
                        <group string="Position bloc infos">
                            <field name="invoice_info_position" widget="radio"/>
                        </group>
                    </group>
                    <separator string="Configuration du logo"/>
                    <group>
                        <group string="Taille du logo">
                            <field name="logo_height"/>
                            <field name="logo_width"/>
                        </group>
                    </group>
                    <separator string="Configuration des tailles de tableau"/>
                    <group>
                        <group string="Taille du contenu">
                            <field name="table_font_size"/>
                            <field name="table_title_font_size"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
