<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Report Action Definition -->
        <record id="action_report_ens_sale_order" model="ir.actions.report">
            <field name="name">ENS Sale Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ens_extra.report_ens_saleorder</field>
            <field name="report_file">ens_extra.report_ens_saleorder</field>
            <field name="print_report_name">'Sale Order - %s' % object.name</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Document Template -->
        <template id="report_ens_saleorder">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <!-- Document Title -->
                            <div class="row">
                                <div class="col-12 text-center mb-4">
                                    <h2>
                                        <span t-if="doc.state not in ['draft','sent']">Order N° </span>
                                        <span t-if="doc.state in ['draft','sent']">Quotation N° </span>
                                        <span t-field="doc.name"/>
                                    </h2>
                                </div>
                            </div>

                            <!-- Customer Information -->
                            <div class="row">
                                <div class="col-6">
                                    <strong>Customer:</strong>
                                    <div t-field="doc.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                                </div>
                                <div class="col-6">
                                    <div class="row">
                                        <div class="col-6">
                                            <strong>Order Date:</strong>
                                            <p t-field="doc.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                                        </div>
                                        <div class="col-6">
                                            <strong>Expiration Date:</strong>
                                            <p t-field="doc.validity_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <strong>Salesperson:</strong>
                                            <p t-field="doc.user_id"/>
                                        </div>
                                        <div class="col-6">
                                            <strong>Reference:</strong>
                                            <p t-field="doc.client_order_ref"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Order Lines -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <table class="table table-bordered table-sm">
                                        <thead>
                                            <tr>
                                                <th>Description</th>
                                                <th class="text-right">Quantity</th>
                                                <th class="text-right">Unit Price</th>
                                                <th t-if="doc.order_line[0].discount" class="text-right">Disc.(%)</th>
                                                <th class="text-right">Taxes</th>
                                                <th class="text-right">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="doc.order_line" t-as="line">
                                                <tr>
                                                    <td>
                                                        <span t-field="line.name"/>
                                                        <p t-if="line.product_id.description_sale" class="text-muted small">
                                                            <span t-field="line.product_id.description_sale"/>
                                                        </p>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-field="line.product_uom_qty"/>
                                                        <span t-field="line.product_uom"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-field="line.price_unit"/>
                                                    </td>
                                                    <td t-if="line.discount" class="text-right">
                                                        <span t-field="line.discount"/>%
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="', '.join(map(lambda x: x.name, line.tax_id))"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-field="line.price_subtotal"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Totals Section -->
                            <div class="row justify-content-end">
                                <div class="col-4">
                                    <table class="table table-sm">
                                        <tr class="border-black">
                                            <td><strong>Subtotal</strong></td>
                                            <td class="text-right">
                                                <span t-field="doc.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Taxes</td>
                                            <td class="text-right">
                                                <span t-field="doc.amount_tax"/>
                                            </td>
                                        </tr>
                                        <tr class="border-black o_total">
                                            <td><strong>Total</strong></td>
                                            <td class="text-right">
                                                <span t-field="doc.amount_total"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Payment Terms -->
                            <div class="row mt-4" t-if="doc.payment_term_id">
                                <div class="col-12">
                                    <strong>Payment Terms: </strong>
                                    <span t-field="doc.payment_term_id.name"/>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="row mt-4" t-if="doc.note">
                                <div class="col-12">
                                    <strong>Notes: </strong>
                                    <span t-field="doc.note"/>
                                </div>
                            </div>

                            <!-- Fiscal Position -->
                            <div class="row mt-4" t-if="doc.fiscal_position_id">
                                <div class="col-12">
                                    <strong>Fiscal Position: </strong>
                                    <span t-field="doc.fiscal_position_id.name"/>
                                </div>
                            </div>

                            <!-- Signatures -->
                            <div class="row mt-5">
                                <div class="col-6">
                                    <div class="text-center">
                                        <p>____________________</p>
                                        <p>Signature</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center">
                                        <p>____________________</p>
                                        <p>Signature</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>