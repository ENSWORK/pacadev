<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action pour afficher la vue des catégories -->
    <record id="action_product_categories_view" model="ir.actions.act_window">
        <field name="name">Catégories de produits</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première catégorie de produits
            </p>
        </field>
    </record>

    <!-- Vue Kanban standard pour les catégories -->
    <record id="view_product_category_kanban" model="ir.ui.view">
        <field name="name">product.category.kanban</field>
        <field name="model">product.category</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="product_count"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_image mr8">
                                <field name="image_1920" widget="image" options="{'size': [64, 64]}" alt="Catégorie"/>
                            </div>
                            <div>
                                <strong><field name="name"/></strong>
                                <div>Produits: <field name="product_count"/></div>
                                <div class="mt-2">
                                    <button name="action_view_products" type="object" class="btn btn-primary btn-sm">
                                        Voir les produits
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Vue Form pour les catégories -->
    <record id="view_product_category_form" model="ir.ui.view">
        <field name="name">product.category.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <field name="image_1920" widget="image" class="oe_avatar"/>
            </xpath>
            <field name="parent_id" position="after">
                <field name="product_count" readonly="1"/>
            </field>
        </field>
    </record>
    
    <!-- Menu pour accéder à la vue -->
    <menuitem id="menu_product_categories"
              name="Produits par catégorie"
              parent="sale.product_menu_catalog"
              action="action_product_categories_view"
              sequence="11"/>
</odoo>
