<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_wizard_form" model="ir.ui.view">
        <field name="name">delivery.wizard.form</field>
        <field name="model">delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Validate Delivery">
                <sheet>
                    <group>
                        <field name="picking_id" readonly="1"/>
                    </group>
                    <field name="move_ids">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_qty" readonly="1"/>
                            <field name="quantity"/>
                            <field name="product_uom" readonly="1"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_validate_delivery" string="Validate Delivery" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>