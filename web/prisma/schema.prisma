generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  odooVersion  String
  status       String   @default("dev")
  stagingUrl   String?
  prodUrl      String?
  tailscaleIp  String?
  aclGroup     String?
  contacts     String?  // JSON string
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules     ClientModule[]
  deployments Deployment[]
  backups     Backup[]
  alerts      Alert[]
  aiRisks     AIRisk[]
  suggestions AISuggestion[]
  pipelines   Pipeline[]
}

model ClientModule {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  version     String?
  source      String   @default("oca")  // oca, custom
  status      String   @default("installed") // installed, disabled, upgrade_available
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Deployment {
  id             String   @id @default(cuid())
  clientId       String
  environment    String   @default("staging") // staging, prod
  versionTag     String?
  triggeredBy    String?
  triggerReason  String?
  status         String   @default("pending") // pending, running, success, failed, rolled_back
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  backupId       String?
  healthWeb      String?  @default("unknown") // ok, error, unknown
  healthDb       String?  @default("unknown")
  healthCron     String?  @default("unknown")
  rollbackAvailable Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Backup {
  id          String   @id @default(cuid())
  clientId    String
  timestamp   DateTime @default(now())
  size        Int      @default(0) // bytes
  checksum    String?
  status      String   @default("completed") // completed, uploading, failed, verifying
  uploadOk    Boolean  @default(true)
  retention   String   @default("30d")
  type        String   @default("full") // full, db_only
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String   @id @default(cuid())
  clientId    String?
  level       String   @default("warning") // info, warning, critical
  source      String   @default("system") // system, prometheus, loki, manual
  message     String
  status      String   @default("active") // active, acknowledged, resolved
  acknowledgedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model AIRisk {
  id               String   @id @default(cuid())
  clientId         String
  commitHash       String?
  score            Float    @default(0)
  schemaChanges    Int      @default(0)
  securityPatterns Int      @default(0)
  depChanges       Int      @default(0)
  bizLogicChanges  Int      @default(0)
  recommendation   String?  // auto_merge, review_required, manual_only
  explanation      String?
  requiresReview   Boolean  @default(false)
  createdAt        DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model AISuggestion {
  id          String   @id @default(cuid())
  clientId    String
  type        String   // fix_lint, migration, missing_test, refactor, security
  title       String
  description String?
  codeDiff    String?
  impact      String?
  status      String   @default("pending") // pending, applied, ignored, modified
  appliedBy   String?
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Pipeline {
  id           String   @id @default(cuid())
  clientId     String
  commitHash   String?
  branch       String?
  trigger      String?  // push, manual, scheduled
  status       String   @default("pending") // pending, lint, tests, security, ai_risk, deploy, success, failed
  lintStatus   String   @default("pending")  // pending, running, success, failed
  testsStatus  String   @default("pending")
  securityStatus String @default("pending")
  aiRiskStatus String   @default("pending")
  deployStatus String   @default("pending")
  duration     Int?     // seconds
  logs         String?  // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  user      String
  action    String
  client    String?
  details   String?
  reason    String?
  createdAt DateTime @default(now())
}

model AIConfig {
  id            String   @id @default(cuid())
  model         String   @default("claude-3.5-sonnet")
  maxTokens     Int      @default(4000)
  fallbackModel String?  @default("gpt-4o")
  costThreshold Float?   @default(50.0)
  autoMerge     Boolean  @default(false)
  autoDeploy    Boolean  @default(false)
  autoRollback  Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model ServiceHealth {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("docker") // docker, tailscale, db, traefik
  status    String   @default("up") // up, down, degraded
  url       String?
  lastCheck DateTime @default(now())
  updatedAt DateTime @updatedAt
}
