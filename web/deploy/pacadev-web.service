[Unit]
Description=PACADEV Web UI (Next.js port 3000)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pacadev/pacadev/web

# Bun snap utilise un HOME différent — on force le bon ici
Environment=HOME=/home/pacadev
Environment=PACADEV_HOME=/home/pacadev/.pacadev
Environment=PACADEV_WORKSPACE=/home/pacadev/pacadev
Environment=DOCKER_BIN=/usr/bin/docker
Environment=NODE_ENV=development
Environment=PATH=/home/pacadev/.nvm/versions/node/v20.19.6/bin:/snap/bin:/usr/bin:/usr/local/bin:/bin:/home/pacadev/.local/bin

ExecStartPre=/bin/rm -f /home/pacadev/pacadev/web/.next/dev/lock
ExecStart=/home/pacadev/.nvm/versions/node/v20.19.6/bin/node node_modules/.bin/next dev --port 3000
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=default.target
