{
  "$schema": "https://opencode.ai/config.json",
  "username": "pacadev",
  "default_agent": "pacadev",
  "instructions": [
    "core/memory/rules/odoo_v17_v19_strict.md",
    "core/memory/rules/ai_agent_instructions.md",
    "docs/CLI_REFERENCE.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "pacadev *": "allow",
      "pacadev": "allow"
    }
  },
  "mcp": {
    "pacadev": {
      "type": "local",
      "command": [
        "/home/pacadev/pacadev/.venv/bin/python",
        "-m",
        "core.mcp.server"
      ],
      "cwd": "/home/pacadev/pacadev",
      "environment": {
        "PACADEV_ROOT": "/home/pacadev/pacadev",
        "PATH": "/home/pacadev/.local/bin:/home/pacadev/.opencode/bin:/home/pacadev/pacadev/.venv/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
