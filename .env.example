# Modeles IA (via LiteLLM -> OpenRouter)
LITELLM_MODEL=openrouter/deepseek/deepseek-chat
LITELLM_FALLBACK_MODEL=openrouter/openai/gpt-4o

# API Keys (a remplir par l'utilisateur)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Configuration MCP
MCP_SERVER_PORT=8080
MCP_SERVER_HOST=0.0.0.0

# PACADEV
PACADEV_ROOT=/home/pacadev/pacadev
